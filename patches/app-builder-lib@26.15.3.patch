--- a/templates/nsis/portable.nsi
+++ b/templates/nsis/portable.nsi
@@ -1,6 +1,12 @@
 !include "common.nsh"
 !include "extractAppPackage.nsh"
 
+# Focus Notes: a splash script beside the splash image (portable-splash.nsh) adds live status.
+!ifdef SPLASH_IMAGE
+  !searchreplace SPLASH_SCRIPT "${SPLASH_IMAGE}" ".bmp" ".nsh"
+  !include /NONFATAL "${SPLASH_SCRIPT}"
+!endif
+
 # https://github.com/electron-userland/electron-builder/issues/3972#issuecomment-505171582
 CRCCheck off
 WindowIcon Off
@@ -22,6 +28,9 @@ Function .onGUIInit
     File /oname=$PLUGINSDIR\splash.bmp "${SPLASH_IMAGE}"
     BgImage::SetBg $PLUGINSDIR\splash.bmp
     BgImage::Redraw
+    !ifmacrodef portableSplashShow
+      !insertmacro portableSplashShow
+    !endif
   !endif
 FunctionEnd
 
@@ -79,12 +88,16 @@ Section
   System::Call 'Kernel32::SetEnvironmentVariable(t, t)i ("PORTABLE_EXECUTABLE_APP_FILENAME", "${APP_FILENAME}").r0'
   ${StdUtils.GetAllParameters} $R0 0
 
+  !ifmacrodef portableSplashLaunch
+    !insertmacro portableSplashLaunch "$INSTDIR\${APP_EXECUTABLE_FILENAME}" $R0
+  !else
   !ifdef SPLASH_IMAGE
     BgImage::Destroy
   !endif
 
 	ExecWait "$INSTDIR\${APP_EXECUTABLE_FILENAME} $R0" $0
   SetErrorLevel $0
+  !endif
 
   SetOutPath $EXEDIR
 	RMDir /r $INSTDIR
