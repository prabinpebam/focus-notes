{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "node .github/hooks/orchestration-clock.mjs sessionStart",
        "timeoutSec": 10,
        "env": {
          "AO_REVIEW_MIN": "30",
          "AO_ROLLOVER_MIN": "90",
          "AO_ROLLOVER_TOOLS": "300",
          "AO_ROLLOVER_COMPACTIONS": "2",
          "AO_CLOCK_CMD": "node .github/hooks/orchestration-clock.mjs"
        }
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "command": "node .github/hooks/orchestration-clock.mjs postToolUse",
        "timeoutSec": 10,
        "env": {
          "AO_REVIEW_MIN": "30",
          "AO_ROLLOVER_MIN": "90",
          "AO_ROLLOVER_TOOLS": "300",
          "AO_ROLLOVER_COMPACTIONS": "2",
          "AO_CLOCK_CMD": "node .github/hooks/orchestration-clock.mjs"
        }
      }
    ],
    "preCompact": [
      {
        "type": "command",
        "command": "node .github/hooks/orchestration-clock.mjs preCompact",
        "timeoutSec": 10,
        "env": {
          "AO_REVIEW_MIN": "30",
          "AO_ROLLOVER_MIN": "90",
          "AO_ROLLOVER_TOOLS": "300",
          "AO_ROLLOVER_COMPACTIONS": "2",
          "AO_CLOCK_CMD": "node .github/hooks/orchestration-clock.mjs"
        }
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "command": "node .github/hooks/orchestration-clock.mjs agentStop",
        "timeoutSec": 10,
        "env": {
          "AO_REVIEW_MIN": "30",
          "AO_ROLLOVER_MIN": "90",
          "AO_ROLLOVER_TOOLS": "300",
          "AO_ROLLOVER_COMPACTIONS": "2",
          "AO_CLOCK_CMD": "node .github/hooks/orchestration-clock.mjs"
        }
      }
    ]
  }
}
