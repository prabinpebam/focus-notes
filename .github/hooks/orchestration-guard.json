{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "command": "node .github/hooks/orchestration-clock.mjs preToolUse",
        "timeoutSec": 5,
        "env": {
          "AO_REVIEW_MIN": "30",
          "AO_ROLLOVER_MIN": "90",
          "AO_ROLLOVER_TOOLS": "300",
          "AO_ROLLOVER_COMPACTIONS": "2",
          "AO_CLOCK_CMD": "node .github/hooks/orchestration-clock.mjs"
        }
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "command": "node .github/hooks/orchestration-clock.mjs userPromptSubmitted",
        "timeoutSec": 5,
        "env": {
          "AO_REVIEW_MIN": "30",
          "AO_ROLLOVER_MIN": "90",
          "AO_ROLLOVER_TOOLS": "300",
          "AO_ROLLOVER_COMPACTIONS": "2",
          "AO_CLOCK_CMD": "node .github/hooks/orchestration-clock.mjs"
        }
      }
    ]
  }
}
