{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prabinpebam.github.io/focus-notes/schemas/workspace.v1.json",
  "title": ".focus-notes/workspace.json",
  "type": "object",
  "required": [
    "formatVersion"
  ],
  "properties": {
    "formatVersion": {
      "description": "Older apps refuse to write newer formats (DST-05)",
      "type": "integer",
      "minimum": 1
    },
    "templateVersion": {
      "type": "string"
    },
    "publishWorkflow": {
      "properties": {
        "readerBundleSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "sha": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        }
      },
      "type": "object",
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}