{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prabinpebam.github.io/focus-notes/schemas/app-state.v1.json",
  "title": "Per-device app state (state.json in the app data folder)",
  "type": "object",
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "lastNotePath": {
      "type": "string"
    },
    "appearance": {
      "enum": [
        "system",
        "light",
        "dark"
      ]
    },
    "fontSize": {
      "enum": [
        14,
        15,
        16,
        17,
        18,
        20,
        22,
        24,
        28,
        32
      ]
    },
    "focusMode": {
      "type": "boolean"
    },
    "lightTheme": {
      "enum": [
        "paper",
        "sepia",
        "harbor-light",
        "forest-light",
        "contrast-light"
      ]
    },
    "darkTheme": {
      "enum": [
        "ink",
        "dusk",
        "harbor-dark",
        "forest-dark",
        "contrast-dark"
      ]
    },
    "contentFont": {
      "enum": [
        "sans",
        "serif",
        "mono",
        "hyperlegible",
        "dyslexic",
        "system"
      ]
    },
    "uiScale": {
      "enum": [
        0.9,
        1,
        1.1,
        1.25,
        1.5
      ]
    },
    "webWelcomed": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
