{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prabinpebam.github.io/focus-notes/schemas/app-state.v1.json",
  "title": "Per-device app state (state.json in the app data folder)",
  "type": "object",
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "lastNotePath": {
      "type": "string"
    },
    "appearance": {
      "enum": [
        "system",
        "light",
        "dark"
      ]
    },
    "fontSize": {
      "enum": [
        14,
        15,
        16,
        17,
        18,
        20,
        22,
        24,
        28,
        32
      ]
    },
    "focusMode": {
      "type": "boolean"
    },
    "filesPinned": {
      "type": "boolean",
      "description": "The Files panel is pinned open on this device (D-161)."
    },
    "lightTheme": {
      "enum": [
        "paper",
        "sepia",
        "harbor-light",
        "forest-light",
        "contrast-light"
      ]
    },
    "darkTheme": {
      "enum": [
        "ink",
        "dusk",
        "harbor-dark",
        "forest-dark",
        "contrast-dark"
      ]
    },
    "contentFont": {
      "enum": [
        "sans",
        "serif",
        "mono",
        "hyperlegible",
        "dyslexic",
        "system"
      ]
    },
    "uiScale": {
      "enum": [
        0.9,
        1,
        1.1,
        1.25,
        1.5
      ]
    },
    "lineHeight": {
      "description": "Line spacing (Theme manager → Reading)",
      "type": "number",
      "minimum": 1.3,
      "maximum": 2
    },
    "measure": {
      "description": "Reading width in characters",
      "type": "integer",
      "minimum": 50,
      "maximum": 100
    },
    "paragraphSpacing": {
      "enum": [
        "compact",
        "comfortable",
        "airy"
      ]
    },
    "focusDim": {
      "description": "Focus mode's dim strength; absent: the theme's own",
      "type": "number",
      "minimum": 0.15,
      "maximum": 0.6
    },
    "webWelcomed": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
