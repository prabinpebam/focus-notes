{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prabinpebam.github.io/focus-notes/schemas/app-state.v1.json",
  "title": "Per-device app state (state.json in the app data folder)",
  "type": "object",
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "lastNotePath": {
      "type": "string"
    },
    "appearance": {
      "enum": [
        "system",
        "light",
        "dark"
      ]
    },
    "fontSize": {
      "enum": [
        14,
        15,
        16,
        17,
        18,
        20,
        22,
        24,
        28,
        32
      ]
    },
    "focusMode": {
      "type": "boolean"
    },
    "filesPinned": {
      "type": "boolean",
      "description": "The Files panel is pinned open on this device (D-161)."
    },
    "outlinePinned": {
      "type": "boolean",
      "description": "The document minimap's contents card is docked on this device (D-186, D-187)."
    },
    "outlineWidth": {
      "type": "number",
      "minimum": 1,
      "description": "The docked contents card's width in px, as resized on this device (D-187)."
    },
    "filesWidth": {
      "type": "number",
      "minimum": 1,
      "description": "The docked Files panel's width in px, as resized on this device (D-187)."
    },
    "filesSort": {
      "enum": ["changed"],
      "description": "The Files tree sorted by last change on this device; absent: by name (FIL-11, D-175)."
    },
    "lightTheme": {
      "enum": [
        "paper",
        "sepia",
        "harbor-light",
        "forest-light",
        "contrast-light"
      ]
    },
    "darkTheme": {
      "enum": [
        "ink",
        "dusk",
        "harbor-dark",
        "forest-dark",
        "contrast-dark"
      ]
    },
    "contentFont": {
      "enum": [
        "sans",
        "serif",
        "mono",
        "hyperlegible",
        "dyslexic",
        "system"
      ]
    },
    "uiScale": {
      "enum": [
        0.9,
        1,
        1.1,
        1.25,
        1.5
      ]
    },
    "lineHeight": {
      "description": "Line spacing (Theme manager → Reading)",
      "type": "number",
      "minimum": 1.3,
      "maximum": 2
    },
    "measure": {
      "description": "Reading width in characters",
      "type": "integer",
      "minimum": 50,
      "maximum": 100
    },
    "paragraphSpacing": {
      "enum": [
        "compact",
        "comfortable",
        "airy"
      ]
    },
    "focusDim": {
      "description": "Focus mode's dim strength; absent: the theme's own",
      "type": "number",
      "minimum": 0.15,
      "maximum": 0.6
    },
    "webWelcomed": {
      "type": "boolean"
    },
    "toolbarPinned": {
      "description": "The toolbar's actions, in order: command IDs, at most six (UI-08, D-170).",
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)+$"
      }
    }
  },
  "additionalProperties": false
}
