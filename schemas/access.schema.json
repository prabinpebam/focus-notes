{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prabinpebam.github.io/focus-notes/schemas/access.v1.json",
  "title": "private/access.json: share audiences, and the owner's vault grant (D-41, D-90)",
  "type": "object",
  "required": [
    "version",
    "grants"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "nameSalt": {
      "pattern": "^[A-Za-z0-9_-]{22,86}$",
      "type": "string",
      "description": "The workspace's public salt for passcode keyrings' names: 16 to 64 random bytes, base64url."
    },
    "grants": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "if": { "not": { "required": ["shareCode"] } },
            "then": { "properties": { "name": { "minLength": 1 } } }
          }
        ],
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9_-]{8,64}$",
            "type": "string"
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 0
          },
          "shareCode": {
            "type": "string",
            "pattern": "^[A-HJ-NP-Z2-9]{8}$",
            "description": "A collision-checked random identifier. Never derived from private content."
          },
          "item": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "label", "folder", "includeLater"],
            "properties": {
              "path": { "type": "string" },
              "label": { "type": "string" },
              "folder": { "type": "boolean" },
              "includeLater": { "type": "boolean" },
              "notePaths": { "type": "array", "items": { "type": "string" } }
            }
          },
          "link": {
            "properties": {
              "secret": {
                "minLength": 22,
                "type": "string"
              }
            },
            "type": "object",
            "additionalProperties": false,
            "required": [
              "secret"
            ]
          },
          "passcode": {
            "properties": {
              "generated": {
                "type": "boolean"
              },
              "value": {
                "minLength": 12,
                "type": "string"
              }
            },
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value"
            ]
          },
          "salt": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{22}$",
            "description": "16 random bytes, base64url. Published in the keyring header."
          },
          "scope": {
            "properties": {
              "ids": { "type": "array", "items": { "type": "string" } },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "folders": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "all": {
                "type": "boolean",
                "description": "Every private note, including ones added later (the owner's grant)."
              }
            },
            "type": "object",
            "additionalProperties": false
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "revokedAt": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "owner": {
            "type": "boolean",
            "description": "The built-in grant for the instance's owner: an audience of one whose scope is every private note (the vault, D-90). At most one active."
          },
          "passcodeKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "description": "PBKDF2-HMAC-SHA256 (600,000 iterations, this grant's salt) of the passphrase, base64url. Stored instead of the passphrase, which is never written anywhere."
          }
        },
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "scope",
          "createdAt"
        ]
      }
    }
  },
  "additionalProperties": false
}
