{
  "name": "@focus-notes/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Focus Notes desktop app",
  "license": "MIT",
  "author": "Prabin Pebam",
  "type": "module",
  "main": "out/main/main.mjs",
  "scripts": {
    "build": "node scripts/entry.mjs && vite build --config vite.config.ts && node scripts/build-main.mjs",
    "dev": "pnpm run build && electron .",
    "start": "electron .",
    "gallery": "node scripts/entry.mjs && vite --config vite.gallery.config.ts",
    "gallery:build": "node scripts/entry.mjs && vite build --config vite.gallery.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "playwright test",
    "dist": "pnpm run build && electron-builder --publish never",
    "dist:store": "pnpm run build && node scripts/dist-store.mjs",
    "icon": "node scripts/icon.mjs",
    "splash": "node scripts/portable-splash.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@playwright/test": "1.63.0",
    "axe-core": "4.14.0",
    "@vanilla-extract/vite-plugin": "5.2.6",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "42.4.1",
    "electron-builder": "26.15.3",
    "mammoth": "1.13.0",
    "vite": "8.3.3",
    "@focus-notes/core": "workspace:*",
    "@focus-notes/cli": "workspace:*",
    "@focus-notes/github": "workspace:*",
    "@focus-notes/mcp": "workspace:*",
    "@focus-notes/seal": "workspace:*",
    "@focus-notes/ui": "workspace:*",
    "@focus-notes/ui-runtime": "workspace:*",
    "@focus-notes/views": "workspace:*"
  },
  "build": {
    "appId": "io.github.prabinpebam.focusnotes",
    "productName": "Focus Notes",
    "artifactName": "Focus-Notes-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/main/**",
      "out/renderer/**",
      "package.json"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "extraResources": [
      { "from": "../../THIRD_PARTY_NOTICES.md", "to": "THIRD_PARTY_NOTICES.md" },
      { "from": "../../LICENSE", "to": "LICENSE.txt" },
      { "from": "build/bin", "to": "bin" }
    ],
    "protocols": [
      { "name": "Focus Notes", "schemes": ["focus-notes"] }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "oneClick": false
    },
    "portable": {
      "splashImage": "build/portable-splash.bmp"
    },
    "appx": {
      "identityName": "Placeholder.FocusNotes",
      "publisher": "CN=00000000-0000-0000-0000-000000000000",
      "publisherDisplayName": "Prabin Pebam",
      "applicationId": "FocusNotes",
      "displayName": "Focus Notes",
      "backgroundColor": "transparent",
      "languages": ["en-US"],
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0",
      "customExtensionsPath": "build/appx-extensions.xml",
      "artifactName": "Focus-Notes-${version}-store-${arch}.msix"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "maintainer": "Prabin Pebam",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "publish": null,
    "executableName": "focus-notes"
  },
  "homepage": "https://github.com/prabinpebam/focus-notes",
  "repository": {
    "url": "https://github.com/prabinpebam/focus-notes.git",
    "type": "git"
  }
}