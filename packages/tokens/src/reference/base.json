{
  "ref": {
    "color": {
      "$type": "color",
      "white": { "$value": "#ffffff" },
      "black": { "$value": "#000000" },
      "transparent": { "$value": "#00000000" },
      "paper": {
        "50": { "$value": "#fbfaf7" }, "100": { "$value": "#f4f2ec" }, "200": { "$value": "#e9e6de" },
        "300": { "$value": "#d8d4ca" }, "500": { "$value": "#8a847a" }, "600": { "$value": "#5f5a52" },
        "700": { "$value": "#47433d" }, "900": { "$value": "#1f1d1a" },
        "a06": { "$value": "#1f1d1a0f" }, "a10": { "$value": "#1f1d1a1a" }, "a40": { "$value": "#1f1d1a66" }
      },
      "ink": {
        "50": { "$value": "#eceae6" }, "200": { "$value": "#c9c5be" }, "400": { "$value": "#a7a39c" },
        "500": { "$value": "#7d7a75" }, "600": { "$value": "#4a4845" }, "700": { "$value": "#2e2d2f" },
        "800": { "$value": "#242426" }, "900": { "$value": "#1a1a1c" }, "950": { "$value": "#121214" },
        "a06": { "$value": "#eceae60f" }, "a10": { "$value": "#eceae61a" }, "a55": { "$value": "#0000008c" }
      },
      "blue": { "300": { "$value": "#8fb0ff" }, "600": { "$value": "#2f5fd0" }, "700": { "$value": "#244ba8" }, "a20": { "$value": "#2f5fd033" }, "a30": { "$value": "#8fb0ff4d" } },
      "red": { "300": { "$value": "#ff8a80" }, "400": { "$value": "#ff5a4e" }, "500": { "$value": "#e5322d" }, "700": { "$value": "#b3261e" }, "a15": { "$value": "#e5322d26" } },
      "amber": { "300": { "$value": "#f2c14e" }, "700": { "$value": "#8a5a00" }, "a35": { "$value": "#f2c14e59" }, "a70": { "$value": "#f2c14eb3" } },
      "green": { "300": { "$value": "#7fd39b" }, "700": { "$value": "#1e7a3e" }, "a15": { "$value": "#1e7a3e26" } }
    },
    "size": {
      "$type": "dimension",
      "0": { "$value": "0px" }, "1": { "$value": "1px" }, "2": { "$value": "2px" }, "4": { "$value": "4px" },
      "8": { "$value": "8px" }, "10": { "$value": "10px" }, "12": { "$value": "12px" }, "13": { "$value": "13px" },
      "14": { "$value": "14px" }, "16": { "$value": "16px" }, "18": { "$value": "18px" }, "20": { "$value": "20px" },
      "24": { "$value": "24px" }, "28": { "$value": "28px" }, "30": { "$value": "30px" }, "32": { "$value": "32px" },
      "40": { "$value": "40px" }, "44": { "$value": "44px" }, "48": { "$value": "48px" }, "240": { "$value": "240px" }, "320": { "$value": "320px" },
      "360": { "$value": "360px" }, "380": { "$value": "380px" }, "480": { "$value": "480px" }, "600": { "$value": "600px" },
      "760": { "$value": "760px" }, "1024": { "$value": "1024px" }, "1040": { "$value": "1040px" }, "70ch": { "$value": "70ch" }, "40vh": { "$value": "40vh" }, "60vh": { "$value": "60vh" },
      "round": { "$value": "9999px" }
    },
    "duration": {
      "$type": "duration",
      "0": { "$value": "0ms" }, "80": { "$value": "80ms" }, "120": { "$value": "120ms" }, "150": { "$value": "150ms" },
      "180": { "$value": "180ms" }, "200": { "$value": "200ms" }
    },
    "shadow": {
      "$type": "shadow",
      "0": { "$value": { "color": "#00000000", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "0px" } },
      "1": { "$value": [
        { "color": "#0000000f", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
        { "color": "#00000014", "offsetX": "0px", "offsetY": "2px", "blur": "8px", "spread": "0px" } ] },
      "2": { "$value": { "color": "#0000001f", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px" } },
      "3": { "$value": { "color": "#00000029", "offsetX": "0px", "offsetY": "16px", "blur": "48px", "spread": "0px" } },
      "dark1": { "$value": { "color": "#00000066", "offsetX": "0px", "offsetY": "2px", "blur": "8px", "spread": "0px" } },
      "dark2": { "$value": { "color": "#00000080", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px" } },
      "dark3": { "$value": { "color": "#00000099", "offsetX": "0px", "offsetY": "16px", "blur": "48px", "spread": "0px" } }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "decelerate": { "$value": [0, 0, 0, 1] },
      "accelerate": { "$value": [0.3, 0, 1, 1] }
    },
    "font": {
      "$type": "fontFamily",
      "system": { "$value": "system-ui, -apple-system, \"Segoe UI Variable\", \"Segoe UI\", Ubuntu, Cantarell, sans-serif" },
      "sans": { "$value": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif" },
      "serif": { "$value": "\"Source Serif 4\", Georgia, \"Times New Roman\", serif" },
      "mono": { "$value": "\"JetBrains Mono\", ui-monospace, \"Cascadia Code\", Consolas, monospace" }
    }
  }
}