{
  "color": {
    "$type": "color",
    "findMatch": { "$value": "{ref.color.amber.a20}" },
    "findMatchActive": { "$value": "{ref.color.amber.a35}" },
    "canvas": {
      "$value": "{ref.color.harborDark.900}"
    },
    "surface": {
      "$value": "{ref.color.harborDark.800}"
    },
    "surfaceRaised": {
      "$value": "{ref.color.harborDark.700}"
    },
    "surfaceSunken": {
      "$value": "{ref.color.harborDark.950}"
    },
    "scrim": {
      "$value": "{ref.color.ink.a55}"
    },
    "border": {
      "$value": "{ref.color.harborDark.700}"
    },
    "borderStrong": {
      "$value": "{ref.color.harborDark.600}"
    },
    "text": {
      "$value": "{ref.color.harborDark.50}"
    },
    "textMuted": {
      "$value": "{ref.color.harborDark.400}"
    },
    "onSelection": {
      "$value": "{ref.color.harborDark.50}"
    },
    "onSelectionMuted": {
      "$value": "{ref.color.harborDark.300}"
