      "$value": "{ref.color.harborDark.500}"
    },
    "textInverse": {
      "$value": "{ref.color.harborDark.900}"
    },
    "hover": {
      "$value": "{ref.color.harborDark.a06}"
    },
    "pressed": {
      "$value": "{ref.color.harborDark.a10}"
    },
    "scrollbar": {
      "$value": "{ref.color.harborDark.a30}"
    },
    "scrollbarHover": {
      "$value": "{ref.color.harborDark.a50}"
    },
    "link": {
      "$value": "{ref.color.blue.300}"
    },
    "accent": {
      "$value": "{ref.color.blue.300}"
    },
    "focusRing": {
      "$value": "{ref.color.blue.300}"
    },
    "onAccent": {
      "$value": "{ref.color.harborDark.950}"
    },
    "accentMuted": {
      "$value": "{ref.color.blue.a30}"
    },
    "selection": {
      "$value": "{ref.color.blue.a30}"
    },
    "danger": {
      "$value": "{ref.color.red.300}"
    },
    "onDanger": {
      "$value": "{ref.color.harborDark.950}"
    },
    "warning": {
      "$value": "{ref.color.amber.300}"
    },
    "success": {
      "$value": "{ref.color.green.300}"
    },
    "info": {
      "$value": "{ref.color.blue.300}"
    }
  },
  "trigger": {
    "dot": {
      "$type": "color",
      "$value": "{ref.color.red.400}"
    },
    "ring": {
      "$type": "color",
      "$value": "{ref.color.harborDark.800}"
    },
    "ringBorder": {
      "$type": "color",
      "$value": "{ref.color.harborDark.600}"
    }
  },
  "code": {
    "background": {
      "$type": "color",
      "$value": "{ref.color.harborDark.800}"
    },
    "text": {
      "$type": "color",
      "$value": "{ref.color.harborDark.50}"
    }
  },
  "shadow": {
    "$type": "shadow",
    "1": {
      "$value": "{ref.shadow.dark1}"
    },
    "2": {
      "$value": "{ref.shadow.dark2}"
    },
    "3": {
      "$value": "{ref.shadow.dark3}"
    }
  },
  "brand": {
    "$description": "The app icon in a dark theme (D-135): the same drawing on a dark tile, so it reads as the icon without a bright square.",
    "tile": { "$type": "color", "$value": "{ref.color.ink.700}" },
    "tileBorder": { "$type": "color", "$value": "{ref.color.ink.600}" },
    "ring": { "$type": "color", "$value": "{ref.color.ink.600}" },
    "ringOpacity": { "$type": "number", "$value": 0.7 },
    "ringBorder": { "$type": "color", "$value": "{ref.color.ink.500}" },
    "dot": { "$type": "color", "$value": "{ref.color.red.500}" },
    "shadow": { "$type": "color", "$value": "{ref.color.black}" },
    "shadowOpacity": { "$type": "number", "$value": 0.35 }
  }
}