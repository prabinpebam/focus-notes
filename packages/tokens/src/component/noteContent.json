{ "cmp": { "noteContent": {
  "$description": "The block components (WP-5.1): note content on published pages, aliasing the same semantic tokens as the editor surface so a note reads the same in both (DD-CMP-04).",
  "text": { "$type": "color", "$value": "{color.text}" },
  "font": { "$type": "fontFamily", "$value": "{font.content}" },
  "fontSize": { "$type": "dimension", "$value": "{font.size}" },
  "lineHeight": { "$type": "number", "$value": "{font.lineHeight}" },
  "headingFont": { "$type": "fontFamily", "$value": "{font.contentHeading}" },
  "headingWeight": { "$type": "fontWeight", "$value": "{font.weightBold}" },
  "headingLineHeight": { "$type": "number", "$value": "{font.headingLineHeight}" },
  "h": { "$type": "number",
    "1": { "$value": "{font.contentH1}" }, "2": { "$value": "{font.contentH2}" }, "3": { "$value": "{font.contentH3}" },
    "4": { "$value": "{font.contentH4}" }, "5": { "$value": "{font.contentH5}" }, "6": { "$value": "{font.contentH6}" } },
  "hBefore": { "$type": "number",
    "1": { "$value": "{font.contentH1Before}" }, "2": { "$value": "{font.contentH2Before}" }, "3": { "$value": "{font.contentH3Before}" },
    "4": { "$value": "{font.contentH4Before}" }, "5": { "$value": "{font.contentH5Before}" }, "6": { "$value": "{font.contentH6Before}" } },
  "blockGap": { "$type": "dimension", "$value": "{layout.blockGap}" },
  "listItemGap": { "$type": "dimension", "$value": "{layout.listItemGap}" },
  "space": { "$type": "dimension", "s": { "$value": "{space.s}" }, "m": { "$value": "{space.m}" }, "l": { "$value": "{space.l}" } },
  "link": { "$type": "color", "$value": "{color.link}" },
  "selection": { "$type": "color", "$value": "{color.selection}" },
  "focusRing": { "$type": "color", "$value": "{color.focusRing}" },
  "focusWidth": { "$type": "dimension", "$value": "{border.focus}" },
  "codeFont": { "$type": "fontFamily", "$value": "{font.mono}" },
  "codeRatio": { "$type": "number", "$value": "{font.codeRatio}" },
  "codeBackground": { "$type": "color", "$value": "{code.background}" },
  "codeText": { "$type": "color", "$value": "{code.text}" },
  "codeRadius": { "$type": "dimension", "$value": "{radius.small}" },
  "quoteBorder": { "$type": "color", "$value": "{color.borderStrong}" },
  "quoteText": { "$type": "color", "$value": "{color.textMuted}" },
  "quoteBorderWidth": { "$type": "dimension", "$value": "{border.focus}" },
  "checkbox": { "$type": "color", "$value": "{color.accent}" },
  "checkboxSize": { "$type": "dimension", "$value": "{size.iconS}" },
  "checkedText": { "$type": "color", "$value": "{color.textMuted}" },
  "tableBorder": { "$type": "color", "$value": "{color.border}" },
  "tableBorderWidth": { "$type": "dimension", "$value": "{border.hairline}" },
  "tableRadius": { "$type": "dimension", "$value": "{radius.small}" },
  "tableHeader": { "$type": "color", "$value": "{color.surface}" },
  "tableHeaderWeight": { "$type": "fontWeight", "$value": "{font.weightSemibold}" },
  "tableCellBlock": { "$type": "dimension", "$value": "{space.s}" },
  "tableCellInline": { "$type": "dimension", "$value": "{space.m}" }
} } }
