{
  "cmp": {
    "dialogPanel": {
      "scrim": {
        "$type": "color",
        "$value": "{color.scrim}"
      },
      "background": {
        "$type": "color",
        "$value": "{color.surfaceRaised}"
      },
      "frostBackground": {
        "$type": "color",
        "$value": "{color.surface}"
      },
      "frostOpacity": {
        "$type": "number",
        "$value": "{frost.opacity}"
      },
      "frostBlur": {
        "$type": "dimension",
        "$value": "{frost.blur}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.text}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "borderWidth": {
        "$type": "dimension",
        "$value": "{border.hairline}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.sheet}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": "{shadow.3}"
      },
      "width": {
        "$type": "dimension",
        "s": {
          "$value": "{layout.dialogS}"
        },
        "m": {
          "$value": "{layout.dialogM}"
        },
        "l": {
          "$value": "{layout.dialogL}"
        },
        "xl": {
          "$value": "{layout.dialogXL}"
        }
      },
      "minHeight": {
        "$type": "dimension",
        "$value": "{layout.dialogMinHeight}"
      },
      "top": {
        "$type": "dimension",
        "$value": "{layout.dialogTop}"
      },
      "inset": {
        "$type": "dimension",
        "$value": "{layout.gutterCompact}"
      },
      "padding": {
        "$type": "dimension",
        "$value": "{space.xl}"
      },
      "gap": {
        "$type": "dimension",
        "$value": "{space.l}"
      },
      "font": {
        "$type": "fontFamily",
        "$value": "{font.ui}"
      },
      "layer": {
        "$type": "number",
        "$value": "{layer.dialog}"
      },
      "duration": {
        "$type": "duration",
        "$value": "{motion.enter}"
      },
      "exitDuration": {
        "$type": "duration",
        "$value": "{motion.exit}"
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": "{easing.decelerate}"
      },
      "scrollbarSize": {
        "$type": "dimension",
        "$value": "{size.scrollbar}"
      },
      "scrollbarInset": {
        "$type": "dimension",
        "$value": "{border.scrollbarInset}"
      },
      "scrollbarThumb": {
        "$type": "color",
        "$value": "{color.scrollbar}"
      },
      "scrollbarThumbHover": {
        "$type": "color",
        "$value": "{color.scrollbarHover}"
      },
      "scrollbarTrack": {
        "$type": "color",
        "$value": "{color.none}"
      },
      "focusRing": {
        "$type": "color",
        "$value": "{color.focusRing}"
      },
      "focusWidth": {
        "$type": "dimension",
        "$value": "{border.focus}"
      },
      "bodySlack": {
        "$type": "dimension",
        "$value": "{space.xs}"
      }
    }
  }
}
