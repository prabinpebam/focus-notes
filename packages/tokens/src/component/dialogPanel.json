{ "cmp": { "dialogPanel": {
  "scrim": { "$type": "color", "$value": "{color.scrim}" },
  "background": { "$type": "color", "$value": "{color.surfaceRaised}" },
  "text": { "$type": "color", "$value": "{color.text}" },
  "border": { "$type": "color", "$value": "{color.border}" },
  "borderWidth": { "$type": "dimension", "$value": "{border.hairline}" },
  "radius": { "$type": "dimension", "$value": "{radius.sheet}" },
  "shadow": { "$type": "shadow", "$value": "{shadow.3}" },
  "width": { "$type": "dimension", "s": { "$value": "{layout.dialogS}" }, "l": { "$value": "{layout.dialogL}" } },
  "maxHeight": { "$type": "dimension", "$value": "{layout.dialogMaxHeight}" },
  "inset": { "$type": "dimension", "$value": "{layout.gutterCompact}" },
  "padding": { "$type": "dimension", "$value": "{space.xl}" },
  "gap": { "$type": "dimension", "$value": "{space.l}" },
  "font": { "$type": "fontFamily", "$value": "{font.ui}" },
  "layer": { "$type": "number", "$value": "{layer.dialog}" },
  "duration": { "$type": "duration", "$value": "{motion.enter}" },
  "exitDuration": { "$type": "duration", "$value": "{motion.exit}" },
