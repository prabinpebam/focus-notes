{ "cmp": { "heading": {
  "color": { "$type": "color", "$value": "{color.text}" },
  "font": { "$type": "fontFamily", "$value": "{font.ui}" },
  "size": { "$type": "dimension", "1": { "$value": "{font.uiTitle}" }, "2": { "$value": "{font.uiEmphasis}" }, "3": { "$value": "{font.uiBody}" } },
  "weight": { "$type": "fontWeight", "$value": "{font.weightSemibold}" },
  "lineHeight": { "$type": "number", "$value": "{font.uiLineHeight}" }
} } }