{ "cmp": { "heading": {
  "color": { "$type": "color", "$value": "{color.text}" },
  "font": { "$type": "fontFamily", "$value": "{font.ui}" },
  "size": { "$type": "dimension", "1": { "$value": "{font.uiTitle}" }, "2": { "$value": "{font.uiEmphasis}" }, "3": { "$value": "{font.uiBody}" }, "display": { "$value": "{font.uiDisplay}" }, "displayShort": { "$value": "{font.uiTitle}", "$description": "A display title in a short window (D-131)." } },
  "weight": { "$type": "fontWeight", "$value": "{font.weightSemibold}" },
  "lineHeight": { "$type": "number", "$value": "{font.uiLineHeight}" },
  "displayLineHeight": { "$type": "number", "$value": "{font.headingLineHeight}", "$description": "A display title that wraps keeps its lines together (D-126)." },
  "press": { "$description": "A heading that leads back (Files from Recently deleted, D-189): a chevron before it, muted on hover (never underlined), the controls' focus ring.",
    "hoverColor": { "$type": "color", "$value": "{color.textMuted}" },
    "gap": { "$type": "dimension", "$value": "{space.xs}" },
    "radius": { "$type": "dimension", "$value": "{radius.control}" },
    "focusWidth": { "$type": "dimension", "$value": "{border.focus}" },
    "focusOffset": { "$type": "dimension", "$value": "{border.focusOffset}" },
    "focusRing": { "$type": "color", "$value": "{color.focusRing}" } }
} } }