{
  "cmp": {
    "fileTree": {
      "rowHeight": {
        "$type": "dimension",
        "$value": "{size.hit}"
      },
      "pinSize": {
        "$type": "dimension",
        "$value": "{size.hit}",
        "$description": "The pin button's box, centred on the row's type icon (cmp.iconButton.size); the row's height holds it."
      },
      "indent": {
        "$type": "dimension",
        "$value": "{space.scale.l}"
      },
      "gap": {
        "$type": "dimension",
        "$value": "{space.inlinePair}"
      },
      "iconBadgeSize": {
        "$type": "dimension",
        "$value": "{size.iconBadge}",
        "$description": "A file's shared (person) or published (globe) badge on its icon's bottom-right corner (owner, 26 November; D-431). A file that's both has the globe above the person on the icon's end edge."
      },
      "iconBadgeOverhang": {
        "$type": "dimension",
        "$value": "{space.scale.xxs}",
        "$description": "How far a badge sits past its icon's bottom edge (the globe past the top when both), so it covers less of the icon; it stays inside the end edge, clear of the name."
      },
      "iconBadgeKnockout": {
        "$type": "dimension",
        "$value": "{border.hairline}",
        "$description": "The ring cut out of the icon around a badge: a separation cue made of the surface itself (a mask), never a border or fill, so it holds on every row fill."
      },
      "iconBadgeKeep": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The opaque part of the icon's knockout mask: only its alpha is read."
      },
      "rowGap": {
        "$type": "dimension",
        "$value": "{space.scale.xxs}"
      },
      "paddingInline": {
        "$type": "dimension",
        "$value": "{space.insetSm}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.control}"
      },
      "iconSize": {
        "$type": "dimension",
        "$value": "{size.iconS}"
      },
      "font": {
        "$type": "fontFamily",
        "$value": "{font.ui}"
      },
      "fontSize": {
        "$type": "dimension",
        "$value": "{font.uiBody}"
      },
      "sectionSize": {
        "$type": "dimension",
        "$value": "{font.uiSecondary}"
      },
      "captionSize": {
        "$type": "dimension",
        "$value": "{font.uiCaption}"
      },
      "weight": {
        "$type": "fontWeight",
        "$value": "{font.weightRegular}"
      },
      "strongWeight": {
        "$type": "fontWeight",
        "$value": "{font.weightSemibold}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.text}"
      },
      "textMuted": {
        "$type": "color",
        "$value": "{color.textMuted}"
      },
      "hover": {
        "$type": "color",
        "$value": "{color.hover}"
      },
      "selection": {
        "$type": "color",
        "$value": "{color.selection}"
      },
      "current": {
        "$type": "color",
        "$value": "{color.pressed}"
      },
      "selectionText": {
        "$type": "color",
        "$value": "{color.onSelection}"
      },
      "selectionTextMuted": {
        "$type": "color",
        "$value": "{color.onSelectionMuted}"
      },
      "accent": {
        "$type": "color",
        "$value": "{color.accent}"
      },
      "danger": {
        "$type": "color",
        "$value": "{color.danger}"
      },
      "focusRing": {
        "$type": "color",
        "$value": "{color.focusRing}"
      },
      "focusWidth": {
        "$type": "dimension",
        "$value": "{border.focus}"
      },
      "focusOffset": {
        "$type": "dimension",
        "$value": "{border.focusOffset}"
      },
      "outlineWidth": {
        "$type": "dimension",
        "$value": "{border.hairline}"
      },
      "inputBackground": {
        "$type": "color",
        "$value": "{color.surface}"
      },
      "inputBorder": {
        "$type": "color",
        "$value": "{color.borderStrong}"
      },
      "inputHeight": {
        "$type": "dimension",
        "$value": "{size.controlS}"
      },
      "transparent": {
        "$type": "color",
        "$value": "{color.none}"
      },
      "duration": {
        "$type": "duration",
        "$value": "{motion.micro}"
      },
      "signDelay": {
        "$type": "duration",
        "$value": "{wait.signDelay}"
      },
      "moreSize": {
        "$type": "dimension",
        "$value": "{size.iconL}"
      },
      "moreHover": {
        "$type": "color",
        "$value": "{color.pressed}"
      },
      "scrollbarSize": {
        "$type": "dimension",
        "$value": "{size.scrollbar}"
      },
      "scrollbarInset": {
        "$type": "dimension",
        "$value": "{border.scrollbarInset}"
      },
      "scrollbarThumb": {
        "$type": "color",
        "$value": "{color.scrollbar}"
      },
      "scrollbarThumbHover": {
        "$type": "color",
        "$value": "{color.scrollbarHover}"
      },
      "scrollbarTrack": {
        "$type": "color",
        "$value": "{color.none}"
      }
    }
  }
}
