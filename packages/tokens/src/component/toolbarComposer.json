{ "cmp": { "toolbarComposer": {
  "$description": "The visual toolbar customizer (DD-IA-08): the real toolbar, a catalogue of the actions that can join it, and the drag between them.",
  "gap": { "$type": "dimension",
    "stage": { "$value": "{space.l}", "$description": "Between the toolbar's stage and the catalogue." },
    "groups": { "$value": "{space.l}" },
    "group": { "$value": "{space.s}", "$description": "A group's heading to its cells." },
    "cells": { "$value": "{space.xs}" },
    "cell": { "$value": "{space.s}", "$description": "A cell's button to its label." },
    "toolbar": { "$value": "{space.xs}", "$description": "The real toolbar's gap between buttons (ToolbarRow), so the marker sits in the middle of it." } },
  "cellMin": { "$type": "dimension", "$value": "{layout.themeTile}", "$description": "A catalogue cell's narrowest width: four columns in a large dialog." },
  "stagePadding": { "$type": "dimension", "$value": "{space.xl}" },
  "stageBackground": { "$type": "color", "$value": "{color.surfaceSunken}", "$description": "The stage the toolbar stands on, so its frosted frame reads as it does over a note." },
  "stageRadius": { "$type": "dimension", "$value": "{radius.popover}" },
  "cellRadius": { "$type": "dimension", "$value": "{radius.control}" },
  "cellPadding": { "$type": "dimension", "$value": "{space.xxs}" },
  "cellHover": { "$type": "color", "$value": "{color.hover}" },
  "label": { "$type": "color", "$value": "{color.text}" },
  "heading": { "$type": "color", "$value": "{color.textMuted}" },
  "font": { "$type": "fontFamily", "$value": "{font.ui}" },
  "labelSize": { "$type": "dimension", "$value": "{font.uiBody}" },
  "headingSize": { "$type": "dimension", "$value": "{font.uiCaption}" },
  "headingWeight": { "$type": "fontWeight", "$value": "{font.weightSemibold}" },
  "lineHeight": { "$type": "number", "$value": "{font.uiLineHeight}" },
  "marker": { "$type": "color", "$value": "{color.accent}", "$description": "Where the dragged button will land." },
  "markerFull": { "$type": "color", "$value": "{color.danger}", "$description": "The toolbar is full: a drop between buttons does nothing; hold over one to replace it." },
  "markerWidth": { "$type": "dimension", "$value": "{border.focus}" },
  "markerRadius": { "$type": "dimension", "$value": "{radius.round}" },
  "markerHeight": { "$type": "dimension", "$value": "{size.controlM}" },
  "lift": { "$type": "dimension", "$value": "{space.m}", "$description": "How far the button under a held drag moves out of its slot." },
  "lifted": { "$type": "number", "$value": "{opacity.muted}" },
  "leaving": { "$type": "color", "$value": "{color.dangerMuted}", "$description": "The catalogue while a toolbar button is dragged over it: dropping there takes it off." },
  "ghostBackground": { "$type": "color", "$value": "{color.surfaceRaised}" },
  "ghostShadow": { "$type": "shadow", "$value": "{shadow.3}" },
  "ghostBorder": { "$type": "color", "$value": "{color.border}" },
  "ghostBorderWidth": { "$type": "dimension", "$value": "{border.hairline}" },
  "ghostSize": { "$type": "dimension", "$value": "{size.controlM}" },
  "ghostIcon": { "$type": "dimension", "$value": "{size.iconM}" },
  "ghostColor": { "$type": "color", "$value": "{color.text}" },
  "ghostLayer": { "$type": "number", "$value": "{layer.tooltip}" },
  "origin": { "$type": "number", "$value": "{opacity.disabled}", "$description": "The dragged button's own place while it travels." },
  "hidden": { "$type": "number", "$value": "{opacity.full}" },
  "srOnlySize": { "$type": "dimension", "$value": "{border.hairline}" },
  "countSize": { "$type": "dimension", "$value": "{font.uiCaption}" },
  "focusWidth": { "$type": "dimension", "$value": "{border.focus}" },
  "hold": { "$type": "duration", "$value": "{motion.hold}" },
  "move": { "$type": "duration", "$value": "{motion.enter}" },
  "leave": { "$type": "duration", "$value": "{motion.sheet}" },
  "easing": { "$type": "cubicBezier", "$value": "{easing.standard}" },
  "easeOut": { "$type": "cubicBezier", "$value": "{easing.decelerate}" },
  "easeIn": { "$type": "cubicBezier", "$value": "{easing.accelerate}" }
} } }
