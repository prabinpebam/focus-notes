{
  "cmp": {
    "menuButton": {
      "background": {
        "$type": "color",
        "$value": "{color.surface}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "borderWidth": {
        "$type": "dimension",
        "$value": "{border.hairline}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.popover}"
      },
      "itemRadius": {
        "$type": "dimension",
        "$value": "{radius.control}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": "{shadow.2}"
      },
      "opacity": {
        "$type": "number",
        "$value": "{frost.opacity}"
      },
      "blur": {
        "$type": "dimension",
        "$value": "{frost.blur}"
      },
      "padding": {
        "$type": "dimension",
        "$value": "{space.xs}"
      },
      "itemPaddingInline": {
        "$type": "dimension",
        "$value": "{space.m}"
      },
      "itemHeight": {
        "$type": "dimension",
        "$value": "{size.controlM}"
      },
      "itemGap": {
        "$type": "dimension",
        "$value": "{space.xxs}"
      },
      "gap": {
        "$type": "dimension",
        "$value": "{space.m}"
      },
      "minWidth": {
        "$type": "dimension",
        "$value": "{layout.menuMinWidth}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.text}"
      },
      "textMuted": {
        "$type": "color",
        "$value": "{color.textMuted}"
      },
      "hover": {
        "$type": "color",
        "$value": "{color.hover}"
      },
      "forcedFocused": {
        "$type": "color",
        "$value": "{color.selection}",
        "$description": "The focused item in forced colors (Highlight); it's only used there."
      },
      "forcedFocusedText": {
        "$type": "color",
        "$value": "{color.onSelection}",
        "$description": "The focused item's text in forced colors (HighlightText)."
      },
      "textDisabled": {
        "$type": "color",
        "$value": "{color.textDisabled}",
        "$description": "An unavailable item's label and shortcut in forced colors (GrayText)."
      },
      "pressed": {
        "$type": "color",
        "$value": "{color.pressed}"
      },
      "focusRing": {
        "$type": "color",
        "$value": "{color.focusRing}"
      },
      "focusWidth": {
        "$type": "dimension",
        "$value": "{border.focus}"
      },
      "disabledOpacity": {
        "$type": "number",
        "$value": "{opacity.disabled}"
      },
      "font": {
        "$type": "fontFamily",
        "$value": "{font.ui}"
      },
      "fontSize": {
        "$type": "dimension",
        "$value": "{font.uiBody}"
      },
      "lineHeight": {
        "$type": "number",
        "$value": "{font.uiLineHeight}"
      },
      "captionSize": {
        "$type": "dimension",
        "$value": "{font.uiCaption}"
      },
      "reasonPaddingBlock": {
        "$type": "dimension",
        "$value": "{space.xs}"
      },
      "headerWeight": {
        "$type": "fontWeight",
        "$value": "{font.weightSemibold}"
      },
      "separator": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "separatorWidth": {
        "$type": "dimension",
        "$value": "{border.hairline}"
      },
      "layer": {
        "$type": "number",
        "$value": "{layer.popover}"
      },
      "pillHeight": {
        "$type": "dimension",
        "$value": "{size.iconL}"
      },
      "pillPaddingInline": {
        "$type": "dimension",
        "$value": "{space.s}"
      },
      "pillRadius": {
        "$type": "dimension",
        "$value": "{radius.round}"
      },
      "pillText": {
        "$type": "color",
        "$value": "{color.textMuted}"
      },
      "pillTextHover": {
        "$type": "color",
        "$value": "{color.text}"
      },
      "pillHover": {
        "$type": "color",
        "$value": "{color.hover}"
      },
      "pillBorder": {
        "$type": "color",
        "$value": "{color.none}"
      },
      "pillBorderHover": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "pillBorderWidth": {
        "$type": "dimension",
        "$value": "{border.hairline}"
      },
      "pillFont": {
        "$type": "fontFamily",
        "$value": "{font.ui}"
      },
      "pillFontSize": {
        "$type": "dimension",
        "$value": "{font.uiCaption}"
      },
      "pillFocusRing": {
        "$type": "color",
        "$value": "{color.focusRing}"
      },
      "pillFocusWidth": {
        "$type": "dimension",
        "$value": "{border.focus}"
      },
      "pillDuration": {
        "$type": "duration",
        "$value": "{motion.micro}"
      },
      "pillEasing": {
        "$type": "cubicBezier",
        "$value": "{easing.standard}"
      },
      "pillTransparent": {
        "$type": "color",
        "$value": "{color.none}"
      },
      "textHeight": {
        "$type": "dimension",
        "$value": "{size.controlM}"
      },
      "textPaddingInline": {
        "$type": "dimension",
        "$value": "{space.s}"
      },
      "textGap": {
        "$type": "dimension",
        "$value": "{space.xs}"
      },
      "textRadius": {
        "$type": "dimension",
        "$value": "{radius.control}"
      },
      "selectBackground": {
        "$type": "color",
        "$value": "{color.surface}"
      },
      "selectBorder": {
        "$type": "color",
        "$value": "{color.borderStrong}"
      },
      "textTransparent": {
        "$type": "color",
        "$value": "{color.none}"
      }
    }
  }
}
