{
  "cmp": {
    "positioner": {
      "visible": {
        "$type": "number",
        "$value": "{opacity.full}",
        "$description": "Fully visible prompt or return action in the active placement state."
      },
      "promptWidth": {
        "$type": "dimension",
        "$value": "{layout.popover}"
      },
      "edge": {
        "$type": "dimension",
        "$value": "{space.scale.m}"
      },
      "topBand": {
        "$type": "dimension",
        "$value": "{layout.topBand}"
      },
      "layer": {
        "$type": "number",
        "$value": "{layer.anchored}"
      },
      "duration": {
        "$type": "duration",
        "$value": "{motion.enter}"
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": "{easing.decelerate}"
      }
    }
  }
}
