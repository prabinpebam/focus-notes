{
  "cmp": {
    "textField": {
      "gap": {
        "$type": "dimension",
        "$value": "{space.inlinePair}"
      },
      "height": {
        "$type": "dimension",
        "$value": "{size.controlL}"
      },
      "numberWidth": {
        "$type": "dimension",
        "$value": "{size.numberField}"
      },
      "heightCompact": {
        "$type": "dimension",
        "$value": "{size.controlM}"
      },
      "areaHeight": {
        "$type": "dimension",
        "$value": "{size.textArea}",
        "$description": "A multi-line field's least height (D-143)."
      },
      "areaMaxHeight": {
        "$type": "dimension",
        "$value": "{size.textAreaMax}",
        "$description": "A scrolling multi-line field's most height: the report Send feedback posts (D-203)."
      },
      "paddingBlock": {
        "$type": "dimension",
        "$value": "{space.insetSm}"
      },
      "lineHeight": {
        "$type": "number",
        "$value": "{font.uiLineHeight}"
      },
      "paddingInline": {
        "$type": "dimension",
        "$value": "{space.scale.m}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.control}"
      },
      "borderWidth": {
        "$type": "dimension",
        "$value": "{border.hairline}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.borderStrong}"
      },
      "borderFocus": {
        "$type": "color",
        "$value": "{color.focusRing}"
      },
      "borderInvalid": {
        "$type": "color",
        "$value": "{color.danger}"
      },
      "borderCommit": {
        "$type": "color",
        "$value": "{color.success}",
        "$description": "The commit colour: the border while a changed value is being saved (F2)."
      },
      "slot": {
        "$type": "dimension",
        "$value": "{size.iconM}",
        "$description": "The trailing slot's box, at the inline end inside the field."
      },
      "slotRoom": {
        "$type": "dimension",
        "$value": "{space.scale.xl}",
        "$description": "The input's end padding while a commit mark can show, so the words never run under it."
      },
      "background": {
        "$type": "color",
        "$value": "{color.surface}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.text}"
      },
      "placeholder": {
        "$type": "color",
        "$value": "{color.textPlaceholder}"
      },
      "label": {
        "$type": "color",
        "$value": "{color.text}"
      },
      "description": {
        "$type": "color",
        "$value": "{color.textMuted}"
      },
      "error": {
        "$type": "color",
        "$value": "{color.danger}",
        "$description": "What's wrong with the field, below it and described by it (D-135)."
      },
      "font": {
        "$type": "fontFamily",
        "$value": "{font.ui}"
      },
      "fontSize": {
        "$type": "dimension",
        "$value": "{font.uiBody}"
      },
      "labelSize": {
        "$type": "dimension",
        "$value": "{font.uiBody}"
      },
      "labelWeight": {
        "$type": "fontWeight",
        "$value": "{font.weightSemibold}"
      },
      "captionSize": {
        "$type": "dimension",
        "$value": "{font.uiCaption}"
      },
      "srOnlySize": {
        "$type": "dimension",
        "$value": "{border.hairline}"
      }
    }
  }
}
