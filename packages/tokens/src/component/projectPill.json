{ "cmp": { "projectPill": {
  "background": { "$type": "color", "$value": "{color.accentMuted}", "$description": "A soft fill of the project's accent." },
  "backgroundHover": { "$type": "color", "$value": "{color.selection}" },
  "text": { "$type": "color", "$value": "{color.text}", "$description": "The name keeps the text colour, so it passes contrast on any accent." },
  "font": { "$type": "fontFamily", "$value": "{font.ui}" },
  "fontSize": { "$type": "dimension", "$value": "{font.uiCaption}" },
  "weight": { "$type": "fontWeight", "$value": "{font.weightSemibold}" },
  "height": { "$type": "dimension", "$value": "{size.iconL}", "$description": "The Backed up button's height (cmp.saveState.height), so the two sit as one row." },
  "maxWidth": { "$type": "dimension", "$value": "{size.pillMax}" },
  "paddingStart": { "$type": "dimension", "$value": "{size.pillInsetStart}", "$description": "Optical: the icon's side bearing makes up the rest, so the visible inset is uniform all round." },
  "paddingEnd": { "$type": "dimension", "$value": "{size.pillInsetEnd}" },
  "paddingTextOnly": { "$type": "dimension", "$value": "{size.pillInsetEnd}", "$description": "With no logo, both ends." },
  "gap": { "$type": "dimension", "$value": "{space.xxs}" },
  "radius": { "$type": "dimension", "$value": "{radius.round}" },
  "focusRing": { "$type": "color", "$value": "{color.focusRing}" },
  "ringWidth": { "$type": "dimension", "$value": "{border.focus}" },
  "ringOffset": { "$type": "dimension", "$value": "{border.hairline}" }
} } }
