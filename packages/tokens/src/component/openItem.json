{ "cmp": { "openItem": {
  "extensionLayer": { "$type": "number", "$value": "{layer.underlay}", "$description": "Under the box: the invisible extension that carries its hit area, fill and ring (spacing SP-2)." },
  "pathHit": { "$type": "dimension", "$value": "{size.hitMin}", "$description": "The folder path link's target under the title: the dense-surface minimum, so it never reaches the title (spacing SP-6)." },
  "hitLayer": { "$type": "number", "$value": "{layer.mask}" },
  "controlLayer": { "$type": "number", "$value": "{layer.contextual}" },
  "tintLayer": { "$type": "number", "$value": "{layer.underlay}" },
  "visible": { "$type": "number", "$value": "{opacity.full}" },
  "$description": "A project card or a recent file row in Open (owner, 4 November): the whole item opens it, pin sits top right on hover, a project's folder path shows in File Explorer or Finder.",
  "font": { "$type": "fontFamily", "$value": "{font.ui}" },
  "lineHeight": { "$type": "number", "$value": "{font.uiLineHeight}" },
  "radius": { "$type": "dimension", "$value": "{radius.popover}" },
  "rowRadius": { "$type": "dimension", "$value": "{radius.control}" },
  "borderWidth": { "$type": "dimension", "$value": "{border.hairline}" },
  "border": { "$type": "color", "$value": "{color.border}" },
  "background": { "$type": "color", "$value": "{color.surfaceRaised}" },
  "tint": { "$type": "color", "$value": "{color.accentMuted}", "$description": "The project's accent, laid over the card at tintOpacity: a subtle wash of its colour." },
  "tintOpacity": { "$type": "number", "$value": "{opacity.tint}" },
  "hover": { "$type": "color", "$value": "{color.hover}" },
  "pressed": { "$type": "color", "$value": "{color.pressed}" },
  "padding": { "$type": "dimension", "card": { "$value": "{space.scale.l}" }, "rowBlock": { "$value": "{space.scale.s}" }, "rowInline": { "$value": "{space.scale.m}" } },
  "gap": { "$type": "dimension", "$value": "{space.scale.m}", "$description": "Between the logo or file icon and the words." },
  "textGap": { "$type": "dimension", "$value": "{space.scale.xxs}", "$description": "Between the title and the line under it: the smallest step of the Open view's spacing." },
  "title": { "$type": "dimension", "card": { "$value": "{font.uiTitle}" }, "row": { "$value": "{font.uiBody}" } },
  "titleWeight": { "$type": "fontWeight", "$value": "{font.weightSemibold}" },
  "titleColor": { "$type": "color", "$value": "{color.text}" },
  "detail": { "$type": "dimension", "$value": "{font.uiSecondary}" },
  "detailColor": { "$type": "color", "$value": "{color.textMuted}" },
  "pathHover": { "$type": "color", "$value": "{color.text}" },
  "pathGap": { "$type": "dimension", "$value": "{space.inlinePair}" },
  "pathPadding": { "$type": "dimension", "$value": "{space.scale.xxs}" },
  "pathIcon": { "$type": "dimension", "$value": "{size.iconS}" },
  "fileTile": { "$type": "dimension", "$value": "{size.statusMark}" },
  "fileTileBackground": { "$type": "color", "$value": "{color.surfaceSunken}" },
  "fileTileColor": { "$type": "color", "$value": "{color.textMuted}" },
  "fileTileIcon": { "$type": "dimension", "$value": "{size.iconM}" },
  "pinInset": { "$type": "dimension", "$value": "{space.scale.xs}" },
  "pinRoom": { "$type": "dimension", "$value": "{size.controlM}", "$description": "Room kept clear of words at the top right, where pin shows." },
  "pinned": { "$type": "color", "$value": "{color.accent}" },
  "focusRing": { "$type": "color", "$value": "{color.focusRing}" },
  "focusWidth": { "$type": "dimension", "$value": "{border.focus}" },
  "focusOffset": { "$type": "dimension", "$value": "{border.focusOffset}" },
  "duration": { "$type": "duration", "$value": "{motion.micro}" },
  "easing": { "$type": "cubicBezier", "$value": "{easing.standard}" }
} } }
