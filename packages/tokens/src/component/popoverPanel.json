{ "cmp": { "popoverPanel": {
  "background": { "$type": "color", "$value": "{color.surface}" },
  "border": { "$type": "color", "$value": "{color.border}" },
  "borderWidth": { "$type": "dimension", "$value": "{border.hairline}" },
  "radius": { "$type": "dimension", "$value": "{radius.popover}" },
  "shadow": { "$type": "shadow", "$value": "{shadow.2}" },
  "opacity": { "$type": "number", "$value": "{frost.opacity}" },
  "blur": { "$type": "dimension", "$value": "{frost.blur}" },
  "padding": { "$type": "dimension", "$value": "{space.scale.xs}" },
  "tilesWidth": { "$type": "dimension", "$value": "{layout.tilePopover}", "$description": "Three theme tiles across (width tiles)." },
  "paddingComfortable": { "$type": "dimension", "$value": "{space.insetMd}" },
  "edgeInset": { "$type": "dimension", "$value": "{space.marginPage}", "$description": "Clearance on both sides of a scrolling detail popover in a narrow window." },
  "offset": { "$type": "dimension", "$value": "{space.scale.s}" },
  "duration": { "$type": "duration", "$value": "{motion.enter}" },
  "exitDuration": { "$type": "duration", "$value": "{motion.exit}" },
  "easing": { "$type": "cubicBezier", "$value": "{easing.decelerate}" },
  "layer": { "$type": "number", "$value": "{layer.popover}" }
} } }