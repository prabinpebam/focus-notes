{ "cmp": { "searchField": {
  "height": { "$type": "dimension", "$value": "{size.controlL}" },
  "radius": { "$type": "dimension", "$value": "{radius.control}" },
  "background": { "$type": "color", "$value": "{color.surfaceSunken}" },
  "border": { "$type": "color", "$value": "{color.border}" },
  "borderFocus": { "$type": "color", "$value": "{color.focusRing}" },
  "borderInvalid": { "$type": "color", "$value": "{color.danger}" },
  "borderWidth": { "$type": "dimension", "$value": "{border.hairline}" },
  "focusWidth": { "$type": "dimension", "$value": "{border.focus}" },
  "text": { "$type": "color", "$value": "{color.text}" },
  "placeholder": { "$type": "color", "$value": "{color.textPlaceholder}" },
  "icon": { "$type": "color", "$value": "{color.textMuted}" },
  "chipBackground": { "$type": "color", "$value": "{color.hover}" },
  "chipText": { "$type": "color", "$value": "{color.text}" },
  "chipRadius": { "$type": "dimension", "$value": "{radius.small}" },
  "chipPaddingInline": { "$type": "dimension", "$value": "{space.s}" },
  "chipFontSize": { "$type": "dimension", "$value": "{font.uiCaption}" },
  "chipWeight": { "$type": "fontWeight", "$value": "{font.weightSemibold}" },
  "iconSize": { "$type": "dimension", "$value": "{size.iconM}" },
  "paddingInline": { "$type": "dimension", "$value": "{space.m}" },
  "gap": { "$type": "dimension", "$value": "{space.s}" },
  "font": { "$type": "fontFamily", "$value": "{font.ui}" },
  "fontSize": { "$type": "dimension", "$value": "{font.uiBody}" },
  "clearSize": { "$type": "dimension", "$value": "{size.controlS}" },
  "clearRadius": { "$type": "dimension", "$value": "{radius.small}" },
  "hover": { "$type": "color", "$value": "{color.hover}" },
  "heightCompact": { "$type": "dimension", "$value": "{size.controlM}", "$description": "In a bar of 32 px controls (the find bar), so every control in a row is as tall (D-111)." },
  "minWidth": { "$type": "dimension", "$value": "{layout.fieldMin}" },
  "basisCompact": { "$type": "dimension", "$value": "{layout.findField}", "$description": "Where a compact field's width starts in its bar: the find bar comes to about 480 px." }
} } }
