{ "cmp": { "codeBlock": {
  "background": { "$type": "color", "$value": "{color.surfaceRaised}" },
  "border": { "$type": "color", "$value": "{color.border}" },
  "borderWidth": { "$type": "dimension", "$value": "{border.hairline}" },
  "radius": { "$type": "dimension", "$value": "{radius.popover}" },
  "gap": { "$type": "dimension", "$value": "{space.stackPair}", "$description": "A code snippet's label belongs to its code; snippets stand stackGroup apart." },
  "copyInset": { "$type": "dimension", "$value": "{space.scale.xs}" },
  "copySpace": { "$type": "dimension", "$value": "{size.hit}" },
  "padding": { "$type": "dimension", "m": { "$value": "{space.scale.s}" }, "l": { "$value": "{space.scale.l}" } },
  "paddingInlineStart": { "$type": "dimension", "m": { "$value": "{space.scale.m}" }, "l": { "$value": "{space.scale.l}" } },
  "font": { "$type": "fontFamily", "$value": "{font.mono}" },
  "size": { "$type": "dimension", "m": { "$value": "{font.uiBody}" }, "l": { "$value": "{font.uiCode}" } },
  "weight": { "$type": "fontWeight", "l": { "$value": "{font.weightSemibold}" } },
  "color": { "$type": "color", "$value": "{color.text}" },
  "labelFont": { "$type": "fontFamily", "$value": "{font.ui}" },
  "labelSize": { "$type": "dimension", "$value": "{font.uiSecondary}" },
  "labelColor": { "$type": "color", "$value": "{color.textMuted}" },
  "lineHeight": { "$type": "number", "$value": "{font.uiLineHeight}" }
} } }
