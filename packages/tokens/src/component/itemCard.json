{ "cmp": { "itemCard": {
  "background": { "$type": "color", "$value": "{color.surfaceRaised}" },
  "border": { "$type": "color", "$value": "{color.border}" },
  "borderWidth": { "$type": "dimension", "$value": "{border.hairline}" },
  "radius": { "$type": "dimension", "$value": "{radius.popover}" },
  "padding": { "$type": "dimension", "m": { "$value": "{space.scale.m}" }, "l": { "$value": "{space.scale.l}" } },
  "gap": { "$type": "dimension", "$value": "{space.scale.m}" },
  "textGap": { "$type": "dimension", "$value": "{space.inlinePair}" },
  "textMin": { "$type": "dimension", "$value": "{layout.sheetMin}", "$description": "Narrower than this, the actions wrap below the text (D-111)." },
  "font": { "$type": "fontFamily", "$value": "{font.ui}" },
  "readingFont": { "$type": "fontFamily", "$value": "{font.content}", "$description": "Published article excerpts follow the preview's content font." },
  "readingHeadingFont": { "$type": "fontFamily", "$value": "{font.contentHeading}", "$description": "The same heading font as the public index." },
  "readingSize": { "$type": "dimension", "$value": "{font.size}", "$description": "Published article entries follow the preview's content size." },
  "readingTitleRatio": { "$type": "number", "$value": "{font.contentH2}", "$description": "The same title level as a public index entry." },
  "readingLineHeight": { "$type": "number", "$value": "{font.lineHeight}", "$description": "Reading rhythm for published article excerpts." },
  "lineHeight": { "$type": "number", "$value": "{font.uiLineHeight}" },
  "title": { "$type": "dimension", "m": { "$value": "{font.uiBody}" }, "l": { "$value": "{font.uiTitle}" } },
  "titleWeight": { "$type": "fontWeight", "$value": "{font.weightSemibold}" },
  "titleColor": { "$type": "color", "$value": "{color.text}" },
  "detail": { "$type": "dimension", "$value": "{font.uiSecondary}" },
  "detailColor": { "$type": "color", "$value": "{color.textMuted}" },
  "tile": { "$type": "dimension", "$value": "{size.cardVisual}" },
  "tileBackground": { "$type": "color", "$value": "{color.surfaceSunken}" },
  "tileColor": { "$type": "color", "$value": "{color.text}" },
  "tileRadius": { "$type": "dimension", "$value": "{radius.control}" },
  "tileIcon": { "$type": "dimension", "$value": "{size.iconL}" },
  "avatar": { "$type": "dimension", "$value": "{size.avatar}" },
  "avatarRadius": { "$type": "dimension", "$value": "{radius.round}" },
  "initialsBackground": { "$type": "color", "$value": "{color.accentMuted}" },
  "initialsColor": { "$type": "color", "$value": "{color.text}" },
  "initialsSize": { "$type": "dimension", "$value": "{font.uiTitle}" },
  "badgeBorder": { "$type": "color", "$value": "{color.borderStrong}" },
  "badgeColor": { "$type": "color", "$value": "{color.textMuted}" },
  "badgeSize": { "$type": "dimension", "$value": "{font.uiCaption}" },
  "badgePaddingInline": { "$type": "dimension", "$value": "{space.insetSm}" },
  "badgeRadius": { "$type": "dimension", "$value": "{radius.round}" },
  "badgeSelectedBackground": { "$type": "color", "$value": "{color.accent}", "$description": "The saved default's badge is an emphasized state, not muted metadata." },
  "badgeSelectedText": { "$type": "color", "$value": "{color.onAccent}" },
  "badgeSelectedWeight": { "$type": "fontWeight", "$value": "{font.weightSemibold}" },
  "busy": { "signDelay": { "$type": "duration", "$value": "{wait.signDelay}", "$description": "Delayed pending border paint; choice content and geometry remain unchanged." } },
  "markSize": { "$type": "dimension", "$value": "{size.iconS}" },
  "action": {
    "border": { "$type": "color", "$value": "{color.accent}", "$description": "A card that is the step's main action (D-131)." },
    "tileBackground": { "$type": "color", "$value": "{color.accentMuted}", "$description": "Its tile in the accent: stronger than the step's title around it (D-142)." },
    "tileColor": { "$type": "color", "$value": "{color.accent}" },
    "title": { "$type": "dimension", "$value": "{font.uiTitle}" },
    "hover": { "$type": "color", "$value": "{color.hover}" },
    "pressed": { "$type": "color", "$value": "{color.pressed}" },
    "focusRing": { "$type": "color", "$value": "{color.focusRing}" },
    "focusWidth": { "$type": "dimension", "$value": "{border.focus}" },
    "focusOffset": { "$type": "dimension", "$value": "{border.focusOffset}" },
    "disabledOpacity": { "$type": "number", "$value": "{opacity.disabled}" },
    "duration": { "$type": "duration", "$value": "{motion.micro}" },
    "easing": { "$type": "cubicBezier", "$value": "{easing.standard}" }
  }
} } }
