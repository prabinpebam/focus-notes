{ "cmp": { "sitePage": {
  "$description": "A page of the product site (IA-VIEW-SITE, IA-VIEW-HELP, WP-10.1): the page, its header with the site's links, the content column, sections, and the footer.",
  "background": { "$type": "color", "$value": "{color.canvas}" },  "text": { "$type": "color", "$value": "{color.text}" },
  "muted": { "$type": "color", "$value": "{color.textMuted}" },
  "border": { "$type": "color", "$value": "{color.border}" },
  "borderWidth": { "$type": "dimension", "$value": "{border.hairline}" },
  "font": { "$type": "fontFamily", "$value": "{font.ui}" },
  "fontSize": { "$type": "dimension", "$value": "{font.uiBody}" },
  "uiLineHeight": { "$type": "number", "$value": "{font.uiLineHeight}" },
  "selection": { "$type": "color", "$value": "{color.selection}" },
  "focusRing": { "$type": "color", "$value": "{color.focusRing}" },
  "focusWidth": { "$type": "dimension", "$value": "{border.focus}" },
  "skipBackground": { "$type": "color", "$value": "{color.surfaceRaised}" },
  "skipRadius": { "$type": "dimension", "$value": "{radius.small}" },
  "skipLayer": { "$type": "number", "$value": "{layer.toast}" },
  "measure": { "$type": "dimension", "$value": "{layout.measure}" },
  "wide": { "$type": "dimension", "$value": "{layout.wideContent}", "$description": "The header's, footer's and sections' width." },
  "gutter": { "$type": "dimension", "$value": "{layout.gutter}" },
  "gutterCompact": { "$type": "dimension", "$value": "{layout.gutterCompact}" },
  "headerBlock": { "$type": "dimension", "$value": "{space.l}" },
  "navGap": { "$type": "dimension", "$value": "{space.l}" },
  "top": { "$type": "dimension", "$value": "{space.xxl}" },
  "gap": { "$type": "dimension", "$value": "{space.xl}" },
  "sectionGap": { "$type": "dimension", "$value": "{space.xxl}" },
  "edge": { "$type": "dimension", "$value": "{space.m}" }
} } }
