{ "cmp": { "saveState": {
  "height": { "$type": "dimension", "$value": "{size.iconL}" },
  "paddingStart": { "$type": "dimension", "$value": "{size.pillInsetStart}", "$description": "With words beside the icon: the project pill's start inset, so the icon's visible edge sits as far from the edge as the text's end (about 6 px). Icon only, the pill stays a circle." },
  "paddingEnd": { "$type": "dimension", "$value": "{size.pillInsetEnd}", "$description": "With words: the project pill's end inset after the text." },
  "gap": { "$type": "dimension", "$value": "{space.inlinePair}" },
  "radius": { "$type": "dimension", "$value": "{radius.round}" },
  "text": { "$type": "color", "$value": "{color.textMuted}" },
  "textHover": { "$type": "color", "$value": "{color.text}" },
  "danger": { "$type": "color", "$value": "{color.danger}" },
  "dotColor": { "$type": "color", "$value": "{color.accent}" },
  "dot": { "$type": "dimension", "$value": "{space.scale.xs}" },
  "rise": { "$type": "dimension", "$value": "{space.scale.xxs}" },
  "hover": { "$type": "color", "$value": "{color.hover}" },
  "border": { "$type": "color", "$value": "{color.border}" },
  "borderHover": { "$type": "color", "$value": "{color.border}" },
  "borderWidth": { "$type": "dimension", "$value": "{border.hairline}" },
  "font": { "$type": "fontFamily", "$value": "{font.ui}" },
  "fontSize": { "$type": "dimension", "$value": "{font.uiCaption}" },
  "focusRing": { "$type": "color", "$value": "{color.focusRing}" },
  "focusWidth": { "$type": "dimension", "$value": "{border.focus}" },
  "duration": { "$type": "duration", "$value": "{motion.micro}" },
  "cycle": { "$type": "duration", "$value": "{motion.spin}" },
  "easing": { "$type": "cubicBezier", "$value": "{easing.standard}" },
  "transparent": { "$type": "color", "$value": "{color.none}" }
} } }