{
  "cmp": {
    "sheet": {
      "inset": {
        "$type": "dimension",
        "$value": "{space.l}"
      },
      "clearance": {
        "$type": "dimension",
        "$value": "{space.s}"
      },
      "widthFiles": {
        "$type": "dimension",
        "$value": "{layout.sheetFiles}"
      },
      "widthTheme": {
        "$type": "dimension",
        "$value": "{layout.sheetTheme}"
      },
      "widthFind": {
        "$type": "dimension",
        "$value": "{layout.sheetFind}"
      },
      "minWidth": {
        "$type": "dimension",
        "$value": "{layout.sheetMin}"
      },
      "minWidthWide": {
        "$type": "dimension",
        "$value": "{layout.sheetMinWide}"
      },
      "short": {
        "$type": "dimension",
        "$value": "{layout.sheetShort}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.sheet}"
      },
      "padding": {
        "$type": "dimension",
        "$value": "{space.l}"
      },
      "gap": {
        "$type": "dimension",
        "$value": "{space.s}"
      },
      "groupGap": {
        "$type": "dimension",
        "$value": "{space.l}",
        "$description": "Between the header and the body, separate groups (Foundations → Visual quality → Grouped and spaced, D-111)."
      },
      "background": {
        "$type": "color",
        "$value": "{color.surface}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.text}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "borderWidth": {
        "$type": "dimension",
        "$value": "{border.hairline}"
      },
      "opacity": {
        "$type": "number",
        "$value": "{frost.opacity}"
      },
      "blur": {
        "$type": "dimension",
        "$value": "{frost.blur}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": "{shadow.2}"
      },
      "layer": {
        "$type": "number",
        "$value": "{layer.panel}"
      },
      "duration": {
        "$type": "duration",
        "$value": "{motion.sheet}"
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": "{easing.decelerate}"
      },
      "offset": {
        "$type": "dimension",
        "$value": "{space.l}"
      },
      "footerBorder": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "footerBorderWidth": {
        "$type": "dimension",
        "$value": "{border.hairline}"
      },
      "scrollbarSize": {
        "$type": "dimension",
        "$value": "{size.scrollbar}"
      },
      "scrollbarInset": {
        "$type": "dimension",
        "$value": "{border.scrollbarInset}"
      },
      "scrollbarThumb": {
        "$type": "color",
        "$value": "{color.scrollbar}"
      },
      "scrollbarThumbHover": {
        "$type": "color",
        "$value": "{color.scrollbarHover}"
      },
      "scrollbarTrack": {
        "$type": "color",
        "$value": "{color.none}"
      },
      "bodySlack": {
        "$type": "dimension",
        "$value": "{space.xs}"
      },
      "ringRoom": {
        "$type": "dimension",
        "$value": "{space.xs}"
      },
      "dock": {
        "$description": "Docked Files (D-187): flush to the window's left edge below the title band, a hairline on its inner side, resized from that side.",
        "width": { "$type": "dimension", "$value": "{layout.dockFiles}" },
        "min": { "$type": "dimension", "$value": "{layout.dockMin}" },
        "max": { "$type": "dimension", "$value": "{layout.dockMax}" },
        "contentMin": { "$type": "dimension", "$value": "{layout.dockContentMin}" },
        "top": { "$type": "dimension", "$value": "{layout.titleBar}" },
        "background": { "$type": "color", "$value": "{color.surface}" },
        "border": { "$type": "color", "$value": "{color.border}" },
        "borderWidth": { "$type": "dimension", "$value": "{border.hairline}" },
        "handleWidth": { "$type": "dimension", "$value": "{space.s}" },
        "handleLine": { "$type": "dimension", "$value": "{border.focus}" },
        "handleIdle": { "$type": "color", "$value": "{color.none}" },
        "handleHover": { "$type": "color", "$value": "{color.borderStrong}" },
        "handleActive": { "$type": "color", "$value": "{color.accent}" },
        "focusRing": { "$type": "color", "$value": "{color.focusRing}" }
      },
      "band": {
        "$description": "Where the notes come from, leading Files above a hairline (D-188): in the title band when docked; on macOS clear of the traffic lights.",
        "border": { "$type": "color", "$value": "{color.border}" },
        "borderWidth": { "$type": "dimension", "$value": "{border.hairline}" },
        "macStart": { "$type": "dimension", "$value": "{window.trafficLightRoom}" }
      }
    }
  }
}
