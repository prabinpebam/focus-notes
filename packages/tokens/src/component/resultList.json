{
  "cmp": {
    "resultList": {
      "gap": {
        "$type": "dimension",
        "$value": "{space.inlinePair}"
      },
      "padding": {
        "$type": "dimension",
        "$value": "{space.scale.xs}"
      },
      "itemHeight": {
        "$type": "dimension",
        "$value": "{size.controlL}"
      },
      "itemPaddingInline": {
        "$type": "dimension",
        "$value": "{space.scale.m}"
      },
      "itemRadius": {
        "$type": "dimension",
        "$value": "{radius.control}"
      },
      "itemGap": {
        "$type": "dimension",
        "$value": "{space.scale.m}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.text}"
      },
      "textMuted": {
        "$type": "color",
        "$value": "{color.textMuted}"
      },
      "active": {
        "$type": "color",
        "$value": "{color.selection}"
      },
      "activeText": {
        "$type": "color",
        "$value": "{color.onSelection}"
      },
      "activeTextMuted": {
        "$type": "color",
        "$value": "{color.onSelectionMuted}"
      },
      "font": {
        "$type": "fontFamily",
        "$value": "{font.ui}"
      },
      "fontSize": {
        "$type": "dimension",
        "$value": "{font.uiBody}"
      },
      "captionSize": {
        "$type": "dimension",
        "$value": "{font.uiCaption}"
      },
      "maxHeight": {
        "$type": "dimension",
        "$value": "{layout.popover}"
      },
      "menuWidth": {
        "$type": "dimension",
        "$value": "{layout.slashMenu}"
      },
      "scrollbarSize": {
        "$type": "dimension",
        "$value": "{size.scrollbar}"
      },
      "scrollbarInset": {
        "$type": "dimension",
        "$value": "{border.scrollbarInset}"
      },
      "scrollbarThumb": {
        "$type": "color",
        "$value": "{color.scrollbar}"
      },
      "scrollbarThumbHover": {
        "$type": "color",
        "$value": "{color.scrollbarHover}"
      },
      "scrollbarTrack": {
        "$type": "color",
        "$value": "{color.none}"
      },
      "focusRing": {
        "$type": "color",
        "$value": "{color.focusRing}"
      },
      "focusWidth": {
        "$type": "dimension",
        "$value": "{border.focus}"
      },
      "disabledOpacity": {
        "$type": "number",
        "$value": "{opacity.disabled}"
      },
      "groupGap": {
        "$type": "dimension",
        "$value": "{space.stackGroup}",
        "$description": "Between groups of results (Spotlight's Top hit, Notes…): at least twice the space between a group's items (spacing SP-1, SP-8)."
      },
      "headerPaddingBlock": {
        "$type": "dimension",
        "$value": "{space.scale.xs}"
      },
      "header": {
        "$type": "color",
        "$value": "{color.text}"
      },
      "headerWeight": {
        "$type": "fontWeight",
        "$value": "{font.weightSemibold}"
      },
      "match": {
        "$type": "color",
        "$value": "{color.findMatch}"
      },
      "matchText": {
        "$type": "color",
        "$value": "{color.onSelection}"
      },
      "matchWeight": {
        "$type": "fontWeight",
        "$value": "{font.weightBold}"
      },
      "matchRadius": {
        "$type": "dimension",
        "$value": "{border.hairline}"
      },
      "state": {
        "$type": "color",
        "$value": "{color.textMuted}"
      }
    }
  }
}
