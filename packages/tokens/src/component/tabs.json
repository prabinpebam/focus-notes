{
  "cmp": {
    "tabs": {
      "navMinHeight": { "$type": "dimension", "$value": "{layout.dialogMinHeight}" },
      "scrollbarSize": { "$type": "dimension", "$value": "{size.scrollbar}" },
      "scrollbarInset": { "$type": "dimension", "$value": "{border.scrollbarInset}" },
      "scrollbarThumb": { "$type": "color", "$value": "{color.scrollbar}" },
      "scrollbarThumbHover": { "$type": "color", "$value": "{color.scrollbarHover}" },
      "scrollbarTrack": { "$type": "color", "$value": "{color.none}" },
      "gap": {
        "$type": "dimension",
        "$value": "{space.inlinePair}"
      },
      "height": {
        "$type": "dimension",
        "$value": "{size.controlM}"
      },
      "paddingInline": {
        "$type": "dimension",
        "$value": "{space.scale.m}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.control}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.textMuted}"
      },
      "selectedText": {
        "$type": "color",
        "$value": "{color.onSelection}"
      },
      "selected": {
        "$type": "color",
        "$value": "{color.selection}"
      },
      "hover": {
        "$type": "color",
        "$value": "{color.hover}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "borderWidth": {
        "$type": "dimension",
        "$value": "{border.hairline}"
      },
      "focusRing": {
        "$type": "color",
        "$value": "{color.focusRing}"
      },
      "focusWidth": {
        "$type": "dimension",
        "$value": "{border.focus}"
      },
      "font": {
        "$type": "fontFamily",
        "$value": "{font.ui}"
      },
      "fontSize": {
        "$type": "dimension",
        "$value": "{font.uiBody}"
      },
      "fontWeight": {
        "$type": "fontWeight",
        "$value": "{font.weightSemibold}"
      },
      "panelGap": {
        "$type": "dimension",
        "$value": "{space.inlineGroup}"
      },
      "listWidth": {
        "$type": "dimension",
        "$value": "{layout.categoryList}"
      },
      "panelMinWidth": {
        "$type": "dimension",
        "$value": "{layout.categoryPanelMin}"
      },
      "footerGap": {
        "$type": "dimension",
        "$value": "{space.scale.m}",
        "$description": "Between the tab list and its footer (Settings' Send feedback, D-203), each side of the footer's hairline."
      }
    }
  }
}
