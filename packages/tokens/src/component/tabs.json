{
  "cmp": {
    "tabs": {
      "gap": {
        "$type": "dimension",
        "$value": "{space.xs}"
      },
      "height": {
        "$type": "dimension",
        "$value": "{size.controlM}"
      },
      "paddingInline": {
        "$type": "dimension",
        "$value": "{space.m}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.control}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.textMuted}"
      },
      "selectedText": {
        "$type": "color",
        "$value": "{color.onSelection}"
      },
      "selected": {
        "$type": "color",
        "$value": "{color.selection}"
      },
      "hover": {
        "$type": "color",
        "$value": "{color.hover}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "borderWidth": {
        "$type": "dimension",
        "$value": "{border.hairline}"
      },
      "focusRing": {
        "$type": "color",
        "$value": "{color.focusRing}"
      },
      "focusWidth": {
        "$type": "dimension",
        "$value": "{border.focus}"
      },
      "font": {
        "$type": "fontFamily",
        "$value": "{font.ui}"
      },
      "fontSize": {
        "$type": "dimension",
        "$value": "{font.uiBody}"
      },
      "fontWeight": {
        "$type": "fontWeight",
        "$value": "{font.weightSemibold}"
      },
      "panelGap": {
        "$type": "dimension",
        "$value": "{space.l}"
      },
      "listWidth": {
        "$type": "dimension",
        "$value": "{layout.categoryList}"
      },
      "panelMinWidth": {
        "$type": "dimension",
        "$value": "{layout.categoryPanelMin}"
      }
    }
  }
}
