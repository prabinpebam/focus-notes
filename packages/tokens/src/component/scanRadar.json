{ "cmp": { "scanRadar": {
  "$description": "The scan for AI models on this computer (DD-RWR-12): a radar that sweeps while the app asks, a blip for each place that answers, and one row per place asked.",
  "size": { "$type": "dimension", "$value": "{size.emptySection}" },
  "core": { "$type": "dimension", "$value": "{size.controlL}" },
  "coreIcon": { "$type": "dimension", "$value": "{size.iconL}" },
  "coreBackground": { "$type": "color", "$value": "{color.surfaceRaised}" },
  "coreColor": { "$type": "color", "$value": "{color.text}" },
  "ring": { "$type": "color", "$value": "{color.border}" },
  "ringWidth": { "$type": "dimension", "$value": "{border.hairline}" },
  "field": { "$type": "color", "$value": "{color.surfaceSunken}" },
  "sweep": { "$type": "color", "$value": "{color.accent}" },
  "sweepTail": { "$type": "color", "$value": "{color.none}" },
  "sweepStrength": { "$type": "number", "$value": "{opacity.tint}" },
  "blip": { "$type": "dimension", "$value": "{size.stepDotCurrent}" },
  "found": { "$type": "color", "$value": "{color.success}" },
  "foundMuted": { "$type": "color", "$value": "{color.successMuted}" },
  "none": { "$type": "color", "$value": "{color.textMuted}" },
  "error": { "$type": "color", "$value": "{color.danger}" },
  "errorMuted": { "$type": "color", "$value": "{color.dangerMuted}" },
  "text": { "$type": "color", "$value": "{color.text}" },
  "muted": { "$type": "color", "$value": "{color.textMuted}" },
  "font": { "$type": "fontFamily", "$value": "{font.ui}" },
  "mono": { "$type": "fontFamily", "$value": "{font.mono}" },
  "bodySize": { "$type": "dimension", "$value": "{font.uiBody}" },
  "captionSize": { "$type": "dimension", "$value": "{font.uiCaption}" },
  "countSize": { "$type": "dimension", "$value": "{font.uiTitle}" },
  "weight": { "$type": "fontWeight", "$value": "{font.weightSemibold}" },
  "lineHeight": { "$type": "number", "$value": "{font.uiLineHeight}" },
  "gap": { "$type": "dimension", "$value": "{space.l}" },
  "rowGap": { "$type": "dimension", "$value": "{space.xxs}" },
  "rowPadding": { "$type": "dimension", "$value": "{space.xs}" },
  "rowInline": { "$type": "dimension", "$value": "{space.s}" },
  "rowRadius": { "$type": "dimension", "$value": "{radius.control}" },
  "rowFound": { "$type": "color", "$value": "{color.successMuted}" },
  "mark": { "$type": "dimension", "$value": "{size.iconS}" },
  "icon": { "$type": "dimension", "$value": "{size.iconM}" },
  "settled": { "$type": "number", "$value": "{opacity.muted}" },
  "full": { "$type": "number", "$value": "{opacity.full}" },
  "sweepDuration": { "$type": "duration", "$value": "{motion.sweep}" },
  "pop": { "$type": "duration", "$value": "{motion.sheet}" },
  "pulse": { "$type": "duration", "$value": "{motion.shimmer}" },
  "settle": { "$type": "duration", "$value": "{motion.enter}" },
  "easing": { "$type": "cubicBezier", "$value": "{easing.decelerate}" }
} } }
