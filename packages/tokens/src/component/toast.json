{
  "cmp": {
    "toast": {
      "background": {
        "$type": "color",
        "$value": "{color.surface}"
      },
      "opacity": {
        "$type": "number",
        "$value": "{frost.opacity}"
      },
      "blur": {
        "$type": "dimension",
        "$value": "{frost.blur}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "borderError": {
        "$type": "color",
        "$value": "{color.danger}"
      },
      "borderWidth": {
        "$type": "dimension",
        "$value": "{border.hairline}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.popover}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": "{shadow.2}"
      },
      "paddingBlock": {
        "$type": "dimension",
        "$value": "{space.scale.xs}",
        "$description": "Optical: the 32 px close button sets the row's height and adds its own 6 px inset, so the text's cap height and the × glyph sit about as far from the top and bottom as the text from the start. Also room for the close button's focus ring (width plus offset) inside the border."
      },
      "paddingInline": {
        "$type": "dimension",
        "$value": "{space.scale.m}",
        "$description": "The start, before the icon or text: the visible inset every other edge matches."
      },
      "paddingInlineEnd": {
        "$type": "dimension",
        "$value": "{space.scale.xs}",
        "$description": "Optical: the start inset less the close button's own inset (6 px) and the × glyph's side bearing, so the glyph's visible edge sits as far from the end as the text from the start. Keeps the focus ring inside the border."
      },
      "gap": {
        "$type": "dimension",
        "$value": "{space.inlineItem}"
      },
      "maxWidth": {
        "$type": "dimension",
        "$value": "{layout.dialogS}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.text}"
      },
      "font": {
        "$type": "fontFamily",
        "$value": "{font.ui}"
      },
      "fontSize": {
        "$type": "dimension",
        "$value": "{font.uiBody}"
      },
      "errorIcon": {
        "$type": "color",
        "$value": "{color.danger}"
      },
      "successIcon": {
        "$type": "color",
        "$value": "{color.success}",
        "$description": "A done outcome's tick (F3)."
      },
      "warningIcon": {
        "$type": "color",
        "$value": "{color.warning}",
        "$description": "A warning: nothing lost yet, something to know."
      },
      "iconSize": {
        "$type": "dimension",
        "$value": "{size.iconM}",
        "$description": "The tone's icon, and the progress pill's spinner."
      },
      "duration": {
        "$type": "duration",
        "$value": "{motion.enter}"
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": "{easing.decelerate}"
      }
    }
  }
}