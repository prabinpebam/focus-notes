{ "cmp": { "button": {
  "extensionLayer": { "$type": "number", "$value": "{layer.underlay}", "$description": "Under the box: the invisible extension that carries its hit area, fill and ring (spacing SP-2)." },
  "hit": { "$type": "dimension", "$value": "{size.hit}", "$description": "Its pointer target: a small button reaches it by an invisible extension (spacing SP-6)." },
  "radius": { "$type": "dimension", "$value": "{radius.control}" },
  "height": { "$type": "dimension", "s": { "$value": "{size.controlS}" }, "m": { "$value": "{size.controlM}" }, "l": { "$value": "{size.controlL}" } },
  "paddingInline": { "$type": "dimension", "s": { "$value": "{space.scale.s}" }, "m": { "$value": "{space.scale.m}" }, "l": { "$value": "{space.scale.xl}" } },
  "gap": { "$type": "dimension", "$value": "{space.inlinePair}" },
  "iconBearing": { "$type": "dimension", "$value": "{space.scale.xxs}", "$description": "An icon's own side bearing inside its 16 px box: taken off the padding on the icon's side, so the visible inset matches the text side (owner, 3 November 19:08)." },
  "font": { "$type": "fontFamily", "$value": "{font.ui}" },
  "fontSize": { "$type": "dimension", "$value": "{font.uiBody}" },
    "fontSizeL": { "$type": "dimension", "$value": "{font.uiEmphasis}", "$description": "A large button (an onboarding step's main action, D-126)." },
  "fontWeight": { "$type": "fontWeight", "$value": "{font.weightSemibold}" },
  "borderWidth": { "$type": "dimension", "$value": "{border.hairline}" },
  "duration": { "$type": "duration", "$value": "{motion.micro}" },
  "easing": { "$type": "cubicBezier", "$value": "{easing.standard}" },
  "disabledOpacity": { "$type": "number", "$value": "{opacity.disabled}" },
  "focus": { "$type": "color", "ring": { "$value": "{color.focusRing}" } },
  "focusWidth": { "$type": "dimension", "$value": "{border.focus}" },
  "focusOffset": { "$type": "dimension", "$value": "{border.focusOffset}" },
  "toggle": { "$type": "color", "selected": { "$value": "{color.pressed}" } },
  "busy": { "$type": "duration", "signDelay": { "$value": "{wait.signDelay}", "$description": "A busy sign shows only after this, so quick work shows nothing extra (Waits, D-199)." } },
  "primary": { "$type": "color",
    "background": { "rest": { "$value": "{color.accent}" }, "hover": { "$value": "{color.accent}" }, "pressed": { "$value": "{color.accent}" } },
    "text": { "$value": "{color.onAccent}" }, "border": { "$value": "{color.accent}" } },
  "secondary": { "$type": "color",
    "background": { "rest": { "$value": "{color.surface}" }, "hover": { "$value": "{color.hover}" }, "pressed": { "$value": "{color.pressed}" } },
    "text": { "$value": "{color.text}" }, "border": { "$value": "{color.borderStrong}" } },
  "subtle": { "$type": "color",
    "background": { "rest": { "$value": "{color.none}" }, "hover": { "$value": "{color.hover}" }, "pressed": { "$value": "{color.pressed}" } },
    "text": { "$value": "{color.text}" }, "border": { "$value": "{color.none}" } },
  "danger": { "$type": "color", "$description": "The one action that destroys (Delete project, D-pending): the danger fill and its text from the semantic danger family, in every theme. Hover and pressed are the shared state overlays drawn on the fill; focus and disabled are the button's own.",
    "background": { "rest": { "$value": "{color.danger}" }, "hover": { "$value": "{color.hover}" }, "pressed": { "$value": "{color.pressed}" } },
    "text": { "$value": "{color.onDanger}" }, "border": { "$value": "{color.danger}" } }
} } }