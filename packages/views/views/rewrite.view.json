{
  "$schema": "https://prabinpebam.github.io/focus-notes/schemas/ui/view.v1.json",
  "id": "rewrite",
  "viewModels": ["vm.rewrite"],
  "focus": "rewritePrompt",
  "overlay": true,
  "root": {
    "type": "Stack",
    "children": [
      {
        "type": "Dialog", "id": "rewrite", "when": { "get": "vm.rewrite.open" },
        "props": { "title": { "t": "rewrite.title" }, "closeLabel": { "t": "rewrite.close" }, "open": { "get": "vm.rewrite.open" }, "size": "m", "height": "content" },
        "on": { "openChange": { "run": "rewrite.dismiss", "args": { "open": { "get": "event.open" } } } },
        "children": [{
          "type": "Stack", "props": { "gap": "l" },
          "children": [
            { "type": "Surface", "props": { "variant": "sunken", "shape": "control", "padding": "m" }, "children": [
              { "type": "Stack", "props": { "gap": "s" }, "children": [
                { "type": "Text", "props": { "value": { "t": "rewrite.selected" }, "role": "caption", "tone": "muted" } },
                { "type": "Text", "props": { "value": { "get": "vm.rewrite.selection" } } }
              ] }
            ] },
            { "type": "Text", "when": { "get": "vm.rewrite.hasWriter" }, "props": { "value": { "get": "vm.rewrite.writerLabel" }, "role": "caption", "tone": "muted" } },
            { "type": "Text", "when": { "get": "vm.rewrite.needsSetup" }, "props": { "value": { "t": "rewrite.setupNeeded" }, "announce": true } },
            { "type": "TextField", "id": "rewritePrompt", "props": { "label": { "t": "rewrite.prompt" }, "placeholder": { "t": "rewrite.placeholder" }, "value": { "get": "vm.rewrite.prompt" }, "multiline": true },
              "on": { "change": { "run": "rewrite.prompt", "args": { "value": { "get": "event.value" } } } } },
            { "type": "Inline", "props": { "gap": "xs" }, "children": [
              { "type": "Button", "props": { "label": { "t": "rewrite.preset.concise" }, "size": "s", "variant": "subtle", "toggle": true, "pressed": { "get": "vm.rewrite.concise" } }, "on": { "press": { "run": "rewrite.preset", "args": { "value": "concise" } } } },
              { "type": "Button", "props": { "label": { "t": "rewrite.preset.warmer" }, "size": "s", "variant": "subtle", "toggle": true, "pressed": { "get": "vm.rewrite.warmer" } }, "on": { "press": { "run": "rewrite.preset", "args": { "value": "warmer" } } } },
              { "type": "Button", "props": { "label": { "t": "rewrite.preset.grammar" }, "size": "s", "variant": "subtle", "toggle": true, "pressed": { "get": "vm.rewrite.grammar" } }, "on": { "press": { "run": "rewrite.preset", "args": { "value": "grammar" } } } }
            ] },
            { "switch": { "get": "vm.rewrite.actions" }, "cases": {
              "setup": { "type": "Inline", "props": { "gap": "s", "justify": "end" }, "children": [
                { "type": "Button", "props": { "label": { "t": "rewrite.cancel" }, "variant": "subtle" }, "on": { "press": { "run": "rewrite.dismiss" } } },
                { "type": "Button", "props": { "label": { "t": "rewrite.setup" }, "icon": "settings", "variant": "primary" }, "on": { "press": { "run": "ai.openSettings" } } }
              ] },
              "compose": { "type": "Inline", "props": { "gap": "s", "justify": "end" }, "children": [
                { "type": "Button", "props": { "label": { "t": "rewrite.cancel" }, "variant": "subtle" }, "on": { "press": { "run": "rewrite.dismiss" } } },
                { "type": "Button", "props": { "label": { "t": "rewrite.generate" }, "variant": "primary", "disabled": { "get": "vm.rewrite.empty" }, "disabledReason": { "t": "rewrite.emptyReason" } }, "on": { "press": { "run": "rewrite.generate" } } }
              ] }
            } }
          ]
        }]
      }
    ]
  }
}
