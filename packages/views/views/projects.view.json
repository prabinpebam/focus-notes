{
 "$schema": "https://prabinpebam.github.io/focus-notes/schemas/ui/view.v1.json",
 "id": "projects",
 "ia": "IA-VIEW-PROJECTS",
 "overlay": true,
 "viewModels": [
  "vm.app",
  "vm.projects"
 ],
 "focus": "projectSearch",
 "root": {
  "type": "Stack",
  "children": [
   {
    "type": "Dialog",
    "when": {
     "expr": {
      "and": [
       {
        "get": "vm.projects.open"
       },
       {
        "!": [
         {
          "get": "vm.projects.githubOpen"
         }
        ]
       }
      ]
     }
    },
    "props": {
     "title": {
      "t": "project.open.title"
     },
     "closeLabel": {
      "t": "dialog.close"
     },
     "open": {
      "get": "vm.projects.open"
     },
     "size": "xl",
     "height": "adaptive"
    },
    "on": {
     "openChange": {
      "run": "projects.close"
     }
    },
    "children": [
     {
      "use": "open.body"
     }
    ],
    "slots": {}
   },
   {
    "type": "Dialog",
    "when": {
     "get": "vm.projects.githubOpen"
    },
    "props": {
     "title": {
      "t": "project.github.title"
     },
     "closeLabel": {
      "t": "dialog.close"
     },
     "open": {
      "get": "vm.projects.githubOpen"
     },
     "size": "m",
     "height": "content"
    },
    "on": {
     "openChange": {
      "run": "projects.githubBack"
     }
    },
    "children": [
     {
      "type": "Stack",
      "props": {
       "gap": "stackSection"
      },
      "children": [
       {
        "type": "Stack",
        "props": {
         "gap": "stackItem"
        },
        "children": [
         {
          "type": "ItemCard",
          "when": {
           "get": "vm.projects.githubWaiting"
          },
          "props": {
           "title": {
            "t": "project.open.loading"
           },
           "skeleton": true
          }
         },
         {
          "each": {
           "get": "vm.projects.repos"
          },
          "as": "repo",
          "key": "repo.id",
          "empty": {
           "type": "Text",
           "when": {
            "expr": {
             "and": [
              {
               "!": [
                {
                 "get": "vm.projects.githubLoading"
                }
               ]
              },
              {
               "==": [
                {
                 "get": "vm.projects.githubError"
                },
                ""
               ]
              }
             ]
            }
           },
           "props": {
            "value": {
             "t": "project.github.empty"
            },
            "tone": "muted"
           }
          },
          "render": {
           "type": "ItemCard",
           "props": {
            "title": {
             "get": "repo.label"
            },
            "detail": {
             "get": "repo.description"
            },
            "icon": "github",
            "personal": "title",
            "busy": {
             "get": "repo.busy"
            },
            "disabled": {
             "get": "vm.projects.githubPending"
            },
            "detailLabel": {
             "t": "command.github.reference",
             "args": {
              "reference": {
               "get": "repo.owner"
              }
             }
            },
            "titleLabel": {
             "t": "command.github.reference",
             "args": {
              "reference": {
               "get": "repo.id"
              }
             }
            }
           },
           "on": {
            "press": {
             "run": "projects.githubOpen",
             "args": {
              "id": {
               "get": "repo.id"
              }
             }
            },
            "detailPress": {
             "run": "github.open",
             "args": {
              "reference": {
               "get": "repo.owner"
              }
             }
            },
            "titlePress": {
             "run": "github.open",
             "args": {
              "reference": {
               "get": "repo.id"
              }
             }
            }
           }
          }
         }
        ],
        "when": {
         "expr": {
          "!": [
           {
            "get": "vm.projects.githubChoosing"
           }
          ]
         }
        }
       },
       {
        "type": "Stack",
        "when": {
         "get": "vm.projects.githubChoosing"
        },
        "props": {
         "gap": "stackGroup"
        },
        "children": [
         {
          "type": "Text",
          "props": {
           "value": {
            "get": "vm.projects.githubCopiesWhy"
           },
           "role": "lead"
          }
         },
         {
          "type": "Stack",
          "props": {
           "gap": "stackItem"
          },
          "children": [
           {
            "each": {
             "get": "vm.projects.githubCopies"
            },
            "as": "copy",
            "key": "copy.id",
            "empty": {
             "type": "Text",
             "props": {
              "value": {
               "t": "project.github.empty"
              },
              "tone": "muted"
             }
            },
            "render": {
             "type": "ItemCard",
             "props": {
              "title": {
               "get": "copy.label"
              },
              "detail": {
               "get": "copy.detail"
              },
              "badge": {
               "get": "copy.badge"
              },
              "icon": "folder",
              "personal": "title"
             },
             "children": [
              {
               "type": "Button",
               "props": {
                "label": {
                 "t": "project.github.useCopy"
                },
                "variant": {
                 "get": "copy.variant"
                },
                "autoFocus": {
                 "get": "copy.first"
                },
                "busy": {
                 "get": "vm.projects.githubPending"
                },
                "size": "l"
               },
               "on": {
                "press": {
                 "run": "projects.githubUseCopy",
                 "args": {
                  "id": {
                   "get": "copy.id"
                  }
                 }
                }
               }
              }
             ]
            }
           },
           {
            "type": "ItemCard",
            "props": {
             "title": {
              "t": "project.github.newCopy"
             },
             "detail": {
              "t": "firstRun.copies.newDetail"
             },
             "icon": "download"
            },
            "children": [
             {
              "type": "Button",
              "props": {
               "label": {
                "t": "project.github.newCopy"
               },
               "variant": "secondary",
               "busy": {
                "get": "vm.projects.githubPending"
               },
               "size": "l"
              },
              "on": {
               "press": {
                "run": "projects.githubNewCopy"
               }
              }
             }
            ]
           }
          ]
         }
        ]
       },
       {
        "type": "Text",
        "when": {
         "get": "vm.projects.githubPending"
        },
        "props": {
         "value": {
          "get": "vm.projects.githubStatus"
         },
         "tone": "muted",
         "announce": true
        }
       },
       {
        "type": "StatusRow",
        "when": {
         "expr": {
          "and": [
           {
            "!=": [
             {
              "get": "vm.projects.githubError"
             },
             ""
            ]
           },
           {
            "!": [
             {
              "get": "vm.projects.githubCanRetry"
             }
            ]
           }
          ]
         }
        },
        "props": {
         "message": {
          "get": "vm.projects.githubError"
         },
         "tone": "danger"
        }
       },
       {
        "type": "StatusRow",
        "when": {
         "expr": {
          "and": [
           {
            "!=": [
             {
              "get": "vm.projects.githubError"
             },
             ""
            ]
           },
           {
            "get": "vm.projects.githubCanRetry"
           }
          ]
         }
        },
        "props": {
         "message": {
          "get": "vm.projects.githubError"
         },
         "tone": "danger",
         "actionLabel": {
          "t": "commit.retry"
         },
         "actionBusy": {
          "get": "vm.projects.githubRetrying"
         },
         "actionBusyLabel": {
          "t": "uiStates.recovery.retrying"
         }
        },
        "on": {
         "action": {
          "run": "projects.githubRetry"
         }
        }
       },
       {
        "type": "Inline",
        "props": {
         "justify": "end"
        },
        "children": [
         {
          "type": "Button",
          "props": {
           "label": {
            "t": "project.github.back"
           },
           "variant": "secondary"
          },
          "on": {
           "press": {
            "run": "projects.githubBack"
           }
          }
         }
        ]
       }
      ]
     }
    ],
    "slots": {}
   }
  ]
 }
}
