{
 "type": "Stack",
 "props": {
  "gap": "stackSection"
 },
 "children": [
  {
   "type": "SearchField",
   "id": "projectSearch",
   "props": {
    "label": {
     "t": "project.open.search"
    },
    "placeholder": {
     "t": "project.open.search"
    },
    "clearLabel": {
     "t": "newNote.clear"
    },
    "value": {
     "bind": "vm.projects.query"
    },
    "autoFocus": true,
    "focusRequest": { "get": "vm.projects.searchFocus" }
   }
  },
  {
   "type": "Inline",
   "props": {
    "gap": "inlineItem",
    "wrap": true
   },
   "children": [
    {
     "type": "Button",
     "props": {
      "label": {
       "t": "project.open.newLocal"
      },
      "variant": "secondary",
      "icon": "quickNote"
     },
     "on": {
      "press": {
       "run": "projects.newLocal"
      }
     }
    },
    {
     "type": "Button",
     "props": {
      "label": {
       "t": "project.openFile"
      },
      "variant": "subtle",
      "icon": "open"
     },
     "on": {
      "press": {
       "run": "projects.openFile"
      }
     }
    },
    {
     "type": "Button",
     "props": {
      "label": {
       "t": "project.openFromGitHub"
      },
      "variant": "subtle",
      "icon": "github"
     },
     "on": {
      "press": {
       "run": "projects.github"
      }
     }
    },
    {
     "type": "Button",
     "props": {
      "label": {
       "t": "project.new"
      },
      "variant": "subtle",
      "icon": "add"
     },
     "on": {
      "press": {
       "run": "projects.new"
      }
     }
    },
    {
     "type": "Button",
     "props": {
      "label": {
       "t": "project.openProject"
      },
      "variant": "subtle",
      "icon": "folder"
     },
     "on": {
      "press": {
       "run": "projects.choose"
      }
     }
    }
   ]
  },
  {
   "type": "Columns",
   "props": {
    "gap": "gutter"
   },
   "children": [
    {
     "type": "Stack",
     "props": {
      "gap": "stackGroup"
     },
     "children": [
      {
       "type": "Text",
       "props": {
        "value": {
         "t": "recent.title"
        },
        "role": "label",
        "tone": "muted"
       }
      },
      {
       "type": "Stack",
       "props": {
        "gap": "stackPair"
       },
       "children": [
        {
         "type": "ItemCard",
         "when": {
          "get": "vm.projects.recentWaiting"
         },
         "props": {
          "title": {
           "t": "project.open.loading"
          },
          "skeleton": true
         }
        },
        {
         "each": {
          "get": "vm.projects.recent"
         },
         "as": "recent",
         "key": "recent.id",
         "empty": {
          "type": "EmptyState",
          "when": {
           "expr": {
            "and": [
             { "!": [{ "get": "vm.projects.loading" }] },
             { "==": [{ "get": "vm.projects.error" }, ""] }
            ]
           }
          },
          "props": {
           "title": { "get": "vm.projects.emptyRecentTitle" },
           "detail": { "get": "vm.projects.emptyRecentDetail" },
           "actionLabel": { "get": "vm.projects.emptyRecentAction" },
           "icon": "document", "size": "section"
          },
          "on": { "action": { "run": "projects.emptyAction" } }
         },
         "render": {
          "type": "OpenItem",
          "props": {
           "kind": "file",
           "title": {
            "get": "recent.label"
           },
           "detail": {
            "get": "recent.description"
           },
           "icon": "documentText",
           "pinned": {
            "get": "recent.pinned"
           },
           "pinCommit": {
            "get": "recent.pinCommit"
           },
           "label": {
            "t": "project.open.openItem",
            "args": {
             "name": {
              "get": "recent.label"
             }
            }
           },
           "pinLabel": {
            "t": "project.open.pinItem",
            "args": {
             "name": {
              "get": "recent.label"
             }
            }
           },
           "unpinLabel": {
            "t": "project.open.unpinItem",
            "args": {
             "name": {
              "get": "recent.label"
             }
            }
           }
          },
          "on": {
           "press": {
            "run": "projects.launch",
            "args": {
             "id": {
              "get": "recent.id"
             }
            }
           },
           "pin": {
            "run": "projects.pin",
            "args": {
             "id": {
              "get": "recent.id"
             }
            }
           }
          }
         }
        }
       ]
      }
     ]
    },
    {
     "type": "Stack",
     "props": {
      "gap": "stackGroup"
     },
     "children": [
      {
       "type": "Text",
       "props": {
        "value": {
         "t": "project.list.title"
        },
        "role": "label",
        "tone": "muted"
       }
      },
      {
       "type": "Stack",
       "props": {
        "gap": "stackItem"
       },
       "children": [
        {
         "type": "ItemCard",
         "when": {
          "get": "vm.projects.entriesWaiting"
         },
         "props": {
          "title": {
           "t": "project.open.loading"
          },
          "size": "l",
          "skeleton": true
         }
        },
        {
         "each": {
          "get": "vm.projects.entries"
         },
         "as": "entry",
         "key": "entry.id",
         "empty": {
          "type": "EmptyState",
          "when": {
           "expr": {
            "and": [
             { "!": [{ "get": "vm.projects.loading" }] },
             { "==": [{ "get": "vm.projects.error" }, ""] }
            ]
           }
          },
          "props": {
           "title": { "get": "vm.projects.emptyTitle" },
           "detail": { "get": "vm.projects.emptyDetail" },
           "actionLabel": { "get": "vm.projects.emptyAction" },
           "icon": "folder", "size": "section"
          },
          "on": { "action": { "run": "projects.emptyAction" } }
         },
         "render": {
          "type": "OpenItem",
          "props": {
           "kind": "project",
           "title": {
            "get": "entry.name"
           },
           "path": {
            "get": "entry.folder"
           },
           "accent": {
            "get": "entry.accent"
           },
           "logo": {
            "get": "entry.logo"
           },
           "src": {
            "get": "entry.logoSrc"
           },
           "pinned": {
            "get": "entry.pinned"
           },
           "pinCommit": {
            "get": "entry.pinCommit"
           },
           "repo": {
            "get": "entry.repo"
           },
           "repoLabel": {
            "t": "project.open.repo",
            "args": {
             "repo": {
              "get": "entry.repo"
             }
            }
           },
           "stats": {
            "get": "entry.stats"
           },
           "statsBusy": {
            "get": "entry.statsBusy"
           },
           "pathLabel": {
            "t": "project.open.reveal",
            "args": {
             "platform": {
              "get": "vm.app.platform"
             }
            }
           },
           "label": {
            "t": "project.open.openItem",
            "args": {
             "name": {
              "get": "entry.name"
             }
            }
           },
           "pinLabel": {
            "t": "project.open.pinItem",
            "args": {
             "name": {
              "get": "entry.name"
             }
            }
           },
           "unpinLabel": {
            "t": "project.open.unpinItem",
            "args": {
             "name": {
              "get": "entry.name"
             }
            }
           }
          },
          "on": {
           "press": {
            "run": "projects.launch",
            "args": {
             "id": {
              "get": "entry.id"
             }
            }
           },
           "pin": {
            "run": "projects.pin",
            "args": {
             "id": {
              "get": "entry.id"
             }
            }
           },
           "reveal": {
            "run": "projects.reveal",
            "args": {
             "id": {
              "get": "entry.id"
             }
            }
           },
           "openRepo": {
            "run": "projects.openRepo",
            "args": {
             "id": {
              "get": "entry.id"
             }
            }
           }
          }
         }
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "type": "Text",
   "when": {
    "get": "vm.projects.pending"
   },
   "props": {
    "value": {
     "get": "vm.projects.pendingLabel"
    },
    "tone": "muted",
    "announce": true
   }
  },
  {
   "type": "StatusRow",
   "when": {
    "expr": {
     "!=": [
      {
       "get": "vm.projects.error"
      },
      ""
     ]
    }
   },
   "props": {
    "message": {
     "get": "vm.projects.error"
    },
    "tone": "danger",
    "actionLabel": { "get": "vm.projects.recoveryAction" },
    "actionBusy": { "get": "vm.projects.retrying" },
    "actionBusyLabel": { "t": "uiStates.recovery.retrying" },
    "detailsLabel": { "t": "uiStates.recovery.details" },
    "details": { "get": "vm.projects.details" }
   },
   "on": { "action": { "run": "projects.retry" } }
  }
 ]
}
