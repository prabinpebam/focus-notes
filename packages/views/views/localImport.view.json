{
  "$schema": "https://prabinpebam.github.io/focus-notes/schemas/ui/view.v1.json",
  "id": "localImport",
  "ia": "IA-VIEW-PROJECTS",
  "overlay": true,
  "viewModels": ["vm.localImport"],
  "focus": "localImportTargets",
  "root": { "type": "Stack", "children": [{
    "type": "Dialog",
    "props": { "open": { "get": "vm.localImport.open" }, "title": { "t": "quick.import.title" }, "closeLabel": { "t": "dialog.close" }, "size": "m", "height": "content" },
    "on": { "openChange": { "run": "local.importClose" } },
    "children": [{
      "type": "Stack", "props": { "gap": "s" }, "children": [
        { "type": "ResultList", "id": "localImportTargets", "props": { "label": { "t": "quick.import.where" }, "items": { "get": "vm.localImport.targets" } }, "on": { "action": { "run": "local.copyTo", "args": { "id": { "get": "event.id" } } } } },
        { "type": "Text", "props": { "value": { "t": "quick.import.keep" }, "role": "caption", "tone": "muted" } },
        { "type": "Text", "props": { "value": { "get": "vm.localImport.error" }, "tone": "danger" } },
        { "type": "Inline", "props": { "justify": "end" }, "children": [
          { "type": "Button", "props": { "label": { "t": "project.cancel" }, "variant": "secondary", "disabled": { "get": "vm.localImport.pending" }, "disabledReason": { "t": "project.open.preparing" } }, "on": { "press": { "run": "local.importClose" } } }
        ] }
      ]
    }]
  }] }
}
