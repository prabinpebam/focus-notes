{
  "$schema": "https://prabinpebam.github.io/focus-notes/schemas/ui/view.v1.json",
  "id": "projectNew",
  "ia": "IA-VIEW-PROJECTS",
  "overlay": true,
  "viewModels": ["vm.projectNew", "vm.project"],
  "focus": "projectName",
  "root": { "type": "Stack", "children": [{
    "type": "Dialog",
    "when": { "get": "vm.projectNew.open" },
    "props": { "title": { "t": "project.new.title" }, "closeLabel": { "t": "dialog.close" }, "open": { "get": "vm.projectNew.open" }, "size": "m" },
    "on": { "openChange": { "run": "projects.newDismiss" } },
    "slots": {
      "toolbar": [{ "type": "StepDots", "props": { "current": { "get": "vm.projectNew.step" }, "total": 4, "label": { "get": "vm.projectNew.stepLabel" } } }],
      "footer": [{ "type": "Inline", "props": { "gap": "inlineItem", "justify": "end", "wrap": true }, "children": [
        { "type": "Button", "when": { "expr": { ">": [{ "get": "vm.projectNew.step" }, 1] } }, "props": { "label": { "t": "project.back" }, "variant": "secondary", "disabled": { "get": "vm.projectNew.cannotBack" }, "disabledReason": { "t": "project.new.stepOf", "args": { "n": { "get": "vm.projectNew.step" } } } }, "on": { "press": { "run": "projects.newBack" } } },
        { "type": "Button", "props": { "label": { "get": "vm.projectNew.nextLabel" }, "variant": "primary", "disabled": { "get": "vm.projectNew.cannotNext" }, "disabledReason": { "get": "vm.projectNew.nextReason" } }, "on": { "press": { "run": "projects.newContinue" } } }
      ] }]
    },
    "children": [{
      "type": "Stack", "props": { "gap": "stackGroup" }, "children": [
        { "switch": { "get": "vm.projectNew.stepName" }, "cases": {
          "name": { "type": "TextField", "id": "projectName", "props": { "label": { "t": "project.new.name" }, "value": { "bind": "vm.projectNew.name" }, "description": { "t": "project.new.nameHint" }, "autoFocus": true } },
          "where": { "type": "Stack", "props": { "gap": "stackItem" }, "children": [
            { "type": "Heading", "props": { "value": { "t": "project.new.whereTitle" }, "level": "3" } },
            { "type": "Stack", "props": { "gap": "stackItem" }, "children": [
              { "type": "ItemCard", "props": { "title": { "t": "project.new.where.github" }, "detail": { "get": "vm.projectNew.githubDetail" }, "icon": "github", "chevron": false, "choiceGroup": { "get": "vm.projectNew.whereGroup" }, "choiceValue": { "get": "vm.projectNew.githubValue" }, "selected": { "get": "vm.projectNew.onGitHub" }, "disabled": { "get": "vm.projectNew.githubDisabled" }, "busy": { "get": "vm.projectNew.githubBusy" } },
                "on": { "choose": { "run": "projects.newWhere", "args": { "value": { "get": "event.value" } } } },
                "children": [
                  { "type": "Button", "when": { "get": "vm.projectNew.canSignIn" }, "props": { "label": { "t": "project.new.signIn" }, "variant": "secondary", "size": "s" }, "on": { "press": { "run": "projects.newSignIn" } } }
                ] },
              { "type": "ItemCard", "props": { "title": { "t": "project.new.where.local" }, "detail": { "t": "project.new.where.localDetail" }, "icon": "hardDrive", "chevron": false, "choiceGroup": { "get": "vm.projectNew.whereGroup" }, "choiceValue": { "get": "vm.projectNew.localValue" }, "selected": { "expr": { "!": { "get": "vm.projectNew.onGitHub" } } } },
                "on": { "choose": { "run": "projects.newWhere", "args": { "value": { "get": "event.value" } } } } }
            ] },
            { "type": "TextField", "id": "projectRepo", "when": { "get": "vm.projectNew.onGitHub" }, "props": { "label": { "t": "project.new.repoLabel" }, "prefix": { "get": "vm.projectNew.repoPrefix" }, "value": { "bind": "vm.projectNew.repoName" }, "description": { "t": "project.new.repoHint" }, "invalid": { "get": "vm.projectNew.repoInvalid" }, "error": { "get": "vm.projectNew.repoError" } } },
            { "type": "Inline", "props": { "gap": "inlineItem", "align": "center" }, "children": [
              { "type": "StepMark", "props": { "icon": "folder", "tone": "neutral", "size": "compact" } },
              { "type": "Stack", "props": { "gap": "stackPair", "grow": true }, "children": [
                { "type": "Text", "props": { "value": { "t": "project.new.ownFolder" }, "role": "label" } },
                { "type": "Text", "props": { "value": { "get": "vm.projectNew.folder" }, "role": "caption", "tone": "muted", "personal": true } }
              ] },
              { "type": "Button", "props": { "label": { "t": "project.new.change" }, "variant": "subtle", "size": "s" }, "on": { "press": { "run": "projects.newFolder" } } }
            ] }
          ] },
          "look": { "type": "Stack", "props": { "gap": "stackGroup" }, "children": [
            { "type": "ProjectScope", "props": { "accent": { "get": "vm.projectNew.accent" } }, "children": [
              { "type": "Inline", "props": { "gap": "inlineItem", "align": "center" }, "children": [
              { "type": "ProjectMark", "props": { "logo": { "get": "vm.projectNew.logo" }, "size": "l" } },
              { "type": "Heading", "props": { "value": { "get": "vm.projectNew.name" }, "level": "3" } }
              ] }
            ] },
            { "type": "Stack", "props": { "gap": "stackItem" }, "children": [
            { "type": "Stack", "props": { "gap": "stackItem" }, "children": [
            { "type": "Field", "props": { "label": { "t": "project.settings.colour" } }, "children": [
              { "type": "Inline", "props": { "gap": "inlinePair", "wrap": true }, "children": [
                { "each": { "get": "vm.project.accents" }, "as": "a", "key": "a.id", "empty": { "type": "Text", "props": { "value": { "t": "project.settings.colour" } } }, "render": {
                  "type": "ProjectMark", "props": { "accent": { "get": "a.id" }, "plate": "solid", "label": { "get": "a.label" }, "selected": { "expr": { "==": [{ "get": "a.id" }, { "get": "vm.projectNew.accent" }] } } },
                  "on": { "press": { "run": "projects.newaccent", "args": { "value": { "get": "a.id" } } } }
                } }
              ] }
            ] },
            { "type": "Field", "props": { "label": { "t": "project.settings.logo" } }, "children": [
              { "type": "ProjectScope", "props": { "accent": { "get": "vm.projectNew.accent" } }, "children": [
                { "type": "Inline", "props": { "gap": "inlinePair", "wrap": true }, "children": [
                  { "each": { "get": "vm.project.logos" }, "as": "l", "key": "l.id", "empty": { "type": "Text", "props": { "value": { "t": "project.settings.logo" } } }, "render": {
                    "type": "ProjectMark", "props": { "logo": { "get": "l.id" }, "label": { "get": "l.label" }, "selected": { "expr": { "==": [{ "get": "l.id" }, { "get": "vm.projectNew.logo" }] } } },
                    "on": { "press": { "run": "projects.newlogo", "args": { "value": { "get": "l.id" } } } }
                  } }
                ] }
              ] }
            ] }
            ] },
            { "type": "Text", "props": { "value": { "t": "project.new.lookHint" }, "role": "caption", "tone": "muted" } }
            ] }
          ] },
          "confirm": { "type": "Stack", "props": { "gap": "stackGroup" }, "children": [
            { "type": "ProjectScope", "props": { "accent": { "get": "vm.projectNew.accent" } }, "children": [
              { "type": "Inline", "props": { "gap": "inlineItem", "align": "center" }, "children": [
              { "type": "ProjectMark", "props": { "logo": { "get": "vm.projectNew.logo" }, "size": "l" } },
              { "type": "Heading", "props": { "value": { "get": "vm.projectNew.name" }, "level": "3" } }
              ] }
            ] },
            { "type": "Stack", "when": { "expr": { "!": { "get": "vm.projectNew.operation" } } }, "props": { "gap": "stackItem" }, "children": [
            { "type": "Text", "when": { "expr": { "!": { "get": "vm.projectNew.operation" } } }, "props": { "value": { "t": "project.new.willMake" } } },
            { "type": "Stack", "props": { "gap": "stackItem" }, "children": [
            { "type": "Inline", "when": { "get": "vm.projectNew.onGitHub" }, "props": { "gap": "inlineItem", "align": "center" }, "children": [
              { "type": "StepMark", "props": { "icon": "github", "tone": "neutral", "size": "compact" } },
              { "type": "Stack", "props": { "gap": "stackPair", "grow": true }, "children": [
                { "type": "Text", "props": { "value": { "t": "project.new.makesRepo" }, "role": "label" } },
                { "type": "Text", "props": { "value": { "get": "vm.projectNew.repo" }, "role": "caption", "tone": "muted", "personal": true } }
              ] },
              { "type": "Button", "when": { "expr": { "!": { "get": "vm.projectNew.repoEditing" } } }, "props": { "label": { "t": "project.new.change" }, "variant": "subtle", "size": "s" }, "on": { "press": { "run": "projects.newChangeRepo" } } }
            ] },
            { "type": "TextField", "id": "projectRepoConfirm", "when": { "get": "vm.projectNew.repoEditing" }, "props": { "label": { "t": "project.new.repoLabel" }, "prefix": { "get": "vm.projectNew.repoPrefix" }, "value": { "bind": "vm.projectNew.repoName" }, "description": { "t": "project.new.repoHint" }, "invalid": { "get": "vm.projectNew.repoInvalid" }, "error": { "get": "vm.projectNew.repoError" } } },
            { "type": "Inline", "props": { "gap": "inlineItem", "align": "center" }, "children": [
              { "type": "StepMark", "props": { "icon": "folder", "tone": "neutral", "size": "compact" } },
              { "type": "Stack", "props": { "gap": "stackPair", "grow": true }, "children": [
                { "type": "Text", "props": { "value": { "t": "project.new.makesFolder" }, "role": "label" }, "when": { "get": "vm.projectNew.onGitHub" } },
                { "type": "Text", "props": { "value": { "t": "project.new.makesFolderOnly" }, "role": "label" }, "when": { "expr": { "!": { "get": "vm.projectNew.onGitHub" } } } },
                { "type": "Text", "props": { "value": { "get": "vm.projectNew.folder" }, "role": "caption", "tone": "muted", "personal": true } }
              ] },
              { "type": "Button", "props": { "label": { "t": "project.new.change" }, "variant": "subtle", "size": "s" }, "on": { "press": { "run": "projects.newFolder" } } }
            ] },
            { "type": "Inline", "props": { "gap": "inlineItem", "align": "center" }, "children": [
              { "type": "StepMark", "props": { "icon": "globe", "tone": "neutral", "size": "compact" } },
              { "type": "Stack", "props": { "gap": "stackPair", "grow": true }, "children": [
                { "type": "Text", "props": { "value": { "t": "project.new.makesNoSite" }, "role": "label" } },
                { "type": "Text", "props": { "value": { "t": "project.new.makesNoSiteDetail" }, "role": "caption", "tone": "muted" } }
              ] }
            ] }
            ] }
            ] }
          ] }
        } },
        { "type": "StatusRow", "when": { "expr": { "!=": [{ "get": "vm.projectNew.error" }, ""] } }, "props": { "message": { "get": "vm.projectNew.error" }, "tone": "danger", "actionLabel": { "get": "vm.projectNew.recoveryAction" }, "actionBusy": { "get": "vm.projectNew.retrying" }, "actionBusyLabel": { "t": "uiStates.recovery.retrying" } }, "on": { "action": { "run": "projects.newRecover" } } },
        { "type": "Stack", "when": { "expr": { "and": [{ "get": "vm.projectNew.operation" }, { "get": "vm.projectNew.confirm" }] } }, "props": { "gap": "stackItem" }, "children": [
          { "each": { "get": "vm.projectNew.parts" }, "as": "part", "key": "part.id", "empty": { "type": "Text", "props": { "value": { "t": "project.new.creating" } } }, "render": {
            "type": "Inline", "props": { "gap": "inlineItem", "align": "center" }, "children": [
              { "type": "StepMark", "props": { "size": "compact", "icon": { "get": "part.icon" }, "tone": { "get": "part.tone" }, "busy": { "get": "part.busy" } } },
              { "type": "Text", "props": { "value": { "get": "part.label" }, "role": "secondary", "tone": "muted" } }
            ]
          } },
          { "type": "ProgressBar", "props": { "value": { "get": "vm.projectNew.progress" }, "label": { "get": "vm.projectNew.progressLabel" } } },
          { "type": "Text", "when": { "expr": { "!=": [{ "get": "vm.projectNew.elapsed" }, ""] } }, "props": { "value": { "get": "vm.projectNew.elapsed" }, "role": "caption", "tone": "muted" } }
        ] }
      ]
    }]
  }] }
}
