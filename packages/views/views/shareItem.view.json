{
  "$schema": "https://prabinpebam.github.io/focus-notes/schemas/ui/view.v1.json",
  "id": "shareItem",
  "ia": "IA-VIEW-SHARE",
  "viewModels": ["vm.shareItem"],
  "focus": "shareItemLink",
  "overlay": true,
  "root": {
    "type": "Stack",
    "children": [
      {
        "type": "Dialog",
        "id": "shareItemDialog",
        "when": { "get": "vm.shareItem.dialogOpen" },
        "props": {
          "title": { "get": "vm.shareItem.title" },
          "closeLabel": { "t": "dialog.close" },
          "open": { "get": "vm.shareItem.dialogOpen" },
          "size": "m",
          "height": "content"
        },
        "on": { "openChange": { "run": "share.item.setOpen", "args": { "open": { "get": "event.open" } } } },
        "children": [
          {
            "type": "Stack",
            "props": { "gap": "l" },
            "children": [
              {
                "type": "ItemCard",
                "props": {
                  "title": { "get": "vm.shareItem.name" },
                  "detail": { "get": "vm.shareItem.detail" },
                  "icon": { "get": "vm.shareItem.icon" },
                  "badge": { "get": "vm.shareItem.badge" }
                },
                "children": [
                  {
                    "type": "Button",
                    "id": "shareItemReview",
                    "when": { "get": "vm.shareItem.folder" },
                    "props": { "label": { "t": "share.dialog.review" }, "size": "s" },
                    "on": { "press": { "run": "share.item.review" } }
                  }
                ]
              },
              {
                "type": "Text",
                "when": { "get": "vm.shareItem.countingVisible" },
                "props": { "value": { "t": "share.dialog.counting" }, "tone": "muted", "role": "secondary" }
              },
              {
                "type": "Skeleton", "when": { "get": "vm.shareItem.preparingVisible" },
                "props": { "shape": "row" }
              },
              {
                "type": "StatusRow", "when": { "get": "vm.shareItem.loadFailed" },
                "props": { "message": { "get": "vm.shareItem.problem" }, "tone": "danger", "actionLabel": { "t": "commit.retry" } },
                "on": { "action": { "run": "share.item.reload" } }
              },
              {
                "type": "Text",
                "when": { "expr": { "and": [{ "get": "vm.shareItem.hasProblem" }, { "!": [{ "get": "vm.shareItem.loadFailed" }] }] } },
                "props": { "value": { "get": "vm.shareItem.problem" }, "tone": "danger" }
              },
              {
                "type": "Switch",
                "when": { "get": "vm.shareItem.folder" },
                "props": {
                  "label": { "t": "share.dialog.later" },
                  "description": { "get": "vm.shareItem.laterDetail" },
                  "checked": { "get": "vm.shareItem.later" },
                  "disabled": { "get": "vm.shareItem.controlsLocked" },
                  "disabledReason": { "get": "vm.shareItem.controlReason" },
                  "onLabel": { "t": "switch.on" }, "offLabel": { "t": "switch.off" }
                },
                "on": { "change": { "run": "share.item.toggleLater" } }
              },
              { "type": "Heading", "props": { "value": { "t": "share.dialog.how" }, "level": "3" } },
              {
                "type": "SegmentedControl",
                "props": {
                  "label": { "t": "share.dialog.expires" },
                  "options": { "get": "vm.shareItem.expiries" },
                  "value": { "bind": "vm.shareItem.expiry" },
                  "readOnly": { "get": "vm.shareItem.controlsLocked" }
                }
              },
              {
                "type": "DatePicker",
                "when": { "get": "vm.shareItem.date" },
                "props": {
                  "label": { "t": "share.dialog.expiresOn" },
                  "description": { "t": "share.dialog.expiresOn.detail" },
                  "value": { "bind": "vm.shareItem.until" },
                  "readOnly": { "get": "vm.shareItem.controlsLocked" }
                }
              },
              {
                "type": "Text",
                "when": { "get": "vm.shareItem.never" },
                "props": { "value": { "t": "share.dialog.never" }, "tone": "muted", "role": "secondary" }
              },
              {
                "type": "Columns",
                "props": { "gap": "l" },
                "children": [
                  {
                    "type": "Switch",
                    "id": "shareItemLink",
                    "props": {
                      "label": { "t": "share.dialog.link" },
                      "description": { "t": "share.dialog.link.detail" },
                      "checked": { "get": "vm.shareItem.link" },
                      "disabled": { "get": "vm.shareItem.controlsLocked" },
                      "disabledReason": { "get": "vm.shareItem.controlReason" },
                      "onLabel": { "t": "switch.on" }, "offLabel": { "t": "switch.off" }
                    },
                    "on": { "change": { "run": "share.item.toggleLink" } }
                  },
                  {
                    "type": "Switch",
                    "props": {
                      "label": { "t": "share.dialog.passcode" },
                      "description": { "t": "share.dialog.passcode.detail" },
                      "checked": { "get": "vm.shareItem.passcode" },
                      "disabled": { "get": "vm.shareItem.controlsLocked" },
                      "disabledReason": { "get": "vm.shareItem.controlReason" },
                      "onLabel": { "t": "switch.on" }, "offLabel": { "t": "switch.off" }
                    },
                    "on": { "change": { "run": "share.item.togglePasscode" } }
                  }
                ]
              },
              {
                "type": "Text",
                "when": { "get": "vm.shareItem.noMethods" },
                "props": { "value": { "t": "share.dialog.keepOne" }, "tone": "muted", "role": "secondary" }
              },
              {
                "type": "Stack",
                "when": { "get": "vm.shareItem.passcode" },
                "props": { "gap": "s" },
                "children": [
                  {
                    "type": "SegmentedControl",
                    "props": {
                      "label": { "t": "share.dialog.passType" },
                      "options": { "get": "vm.shareItem.modes" },
                      "value": { "bind": "vm.shareItem.mode" },
                      "readOnly": { "get": "vm.shareItem.controlsLocked" }
                    }
                  },
                  {
                    "type": "Stack",
                    "when": { "expr": { "!": { "get": "vm.shareItem.ownMode" } } },
                    "props": { "gap": "s" },
                    "children": [
                      { "type": "Text", "props": { "value": { "get": "vm.shareItem.generated" } } },
                      { "type": "Inline", "props": { "gap": "s", "wrap": true }, "children": [
                        { "type": "Button", "props": { "label": { "t": "share.dialog.copyPasscode" }, "disabled": { "get": "vm.shareItem.actionsDisabled" }, "disabledReason": { "get": "vm.shareItem.actionReason" } },
                          "on": { "press": { "run": "share.item.action", "args": { "what": "passcode" } } } },
                        { "type": "Button", "props": { "label": { "t": "share.dialog.newWords" }, "disabled": { "get": "vm.shareItem.controlsLocked" }, "disabledReason": { "get": "vm.shareItem.controlReason" } },
                          "on": { "press": { "run": "share.item.newWords" } } }
                      ] }
                    ]
                  },
                  {
                    "type": "Stack",
                    "when": { "get": "vm.shareItem.ownMode" },
                    "props": { "gap": "s" },
                    "children": [
                      {
                        "type": "TextField",
                        "props": {
                          "label": { "t": "share.dialog.own" },
                          "type": "password",
                          "description": { "t": "share.dialog.own.rule" },
                          "value": { "bind": "vm.shareItem.own" },
                          "readOnly": { "get": "vm.shareItem.controlsLocked" }
                        }
                      },
                      {
                        "type": "StrengthMeter",
                        "props": {
                          "label": { "t": "share.dialog.strength" },
                          "value": { "get": "vm.shareItem.strength" },
                          "valueText": { "t": "share.dialog.strength.value", "args": { "s": { "get": "vm.shareItem.strength" } } }
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Text",
                "when": { "get": "vm.shareItem.deleted" },
                "props": { "value": { "t": "share.state.deleted" }, "tone": "danger" }
              },
              {
                "type": "Inline", "when": { "get": "vm.shareItem.deleted" }, "props": { "gap": "s", "wrap": true },
                "children": [
                  { "type": "Button", "props": { "label": { "t": "share.state.restore" }, "disabled": { "get": "vm.shareItem.restoreDisabled" }, "disabledReason": { "get": "vm.shareItem.restoreReason" } }, "on": { "press": { "run": "share.item.restore" } } },
                  { "type": "Button", "props": { "label": { "t": "share.state.close" } }, "on": { "press": { "run": "share.item.setOpen", "args": { "open": false } } } }
                ]
              },
              { "type": "Button", "when": { "get": "vm.shareItem.signedOut" }, "props": { "label": { "t": "share.state.signIn" } }, "on": { "press": { "run": "share.item.signIn" } } },
              {
                "type": "Inline",
                "props": { "gap": "s", "wrap": true },
                "children": [
                  { "type": "Button", "props": { "label": { "get": "vm.shareItem.primaryLabel" }, "variant": "primary", "busy": { "get": "vm.shareItem.busy" }, "disabled": { "get": "vm.shareItem.actionsDisabled" }, "disabledReason": { "get": "vm.shareItem.actionReason" } },
                    "on": { "press": { "run": "share.item.action", "args": { "what": "primary" } } } },
                  { "type": "Text", "props": { "value": { "t": "share.dialog.copyGroup" }, "tone": "muted", "role": "secondary" } },
                  { "type": "Button", "when": { "get": "vm.shareItem.link" }, "props": { "label": { "t": "share.dialog.copyLink" }, "disabled": { "get": "vm.shareItem.actionsDisabled" }, "disabledReason": { "get": "vm.shareItem.actionReason" } },
                    "on": { "press": { "run": "share.item.action", "args": { "what": "link" } } } },
                  { "type": "Button", "when": { "get": "vm.shareItem.passcode" }, "props": { "label": { "t": "share.dialog.copyCode" }, "disabled": { "get": "vm.shareItem.actionsDisabled" }, "disabledReason": { "get": "vm.shareItem.actionReason" } },
                    "on": { "press": { "run": "share.item.action", "args": { "what": "accessCode" } } } },
                  { "type": "Button", "when": { "get": "vm.shareItem.macos" }, "props": { "label": { "t": "share.dialog.copyInfo" }, "disabled": { "get": "vm.shareItem.actionsDisabled" }, "disabledReason": { "get": "vm.shareItem.actionReason" } },
                    "on": { "press": { "run": "share.item.action", "args": { "what": "information" } } } }
                ]
              },
              { "type": "Text", "when": { "expr": { "!=": [{ "get": "vm.shareItem.status" }, ""] } }, "props": { "value": { "get": "vm.shareItem.status" }, "announce": true } },
              { "type": "Text", "when": { "expr": { "!=": [{ "get": "vm.shareItem.progress" }, ""] } }, "props": { "value": { "get": "vm.shareItem.progress" }, "tone": "muted", "role": "secondary" } },
              {
                "type": "Stack", "when": { "get": "vm.shareItem.ready" }, "props": { "gap": "s" },
                "children": [
                  { "type": "Heading", "props": { "value": { "t": "share.dialog.preview" }, "level": "3" } },
                  { "each": { "get": "vm.shareItem.lines" }, "as": "line", "key": "line.id", "render": { "type": "Text", "props": { "value": { "get": "line.text" } } }, "empty": { "type": "Text", "props": { "value": { "t": "share.item.preparing" } } } }
                ]
              },
              {
                "type": "Stack", "when": { "get": "vm.shareItem.hasHistory" }, "props": { "gap": "s" },
                "children": [
                  { "type": "Divider" },
                  { "type": "Button", "props": { "label": { "t": "share.dialog.before", "args": { "count": { "get": "vm.shareItem.historyCount" } } }, "variant": "subtle", "expanded": { "get": "vm.shareItem.historyOpen" } }, "on": { "press": { "run": "share.item.toggleHistory" } } },
                  {
                    "type": "Stack", "when": { "get": "vm.shareItem.historyOpen" }, "props": { "gap": "s" },
                    "children": [
                      { "type": "Inline", "when": { "get": "vm.shareItem.hasNewer" }, "props": { "gap": "s", "wrap": true }, "children": [
                        { "type": "StatusRow", "props": { "message": { "t": "share.dialog.newer", "args": { "count": { "get": "vm.shareItem.newerCount" } } }, "tone": "info", "icon": "info" } },
                        { "type": "Button", "props": { "label": { "t": "share.dialog.addThem" }, "size": "s", "disabled": { "get": "vm.shareItem.actionsDisabled" }, "disabledReason": { "get": "vm.shareItem.actionReason" } }, "on": { "press": { "run": "share.item.addThem" } } }
                      ] },
                      { "each": { "get": "vm.shareItem.history" }, "as": "row", "key": "row.id", "render": {
                        "type": "ItemCard", "props": { "title": { "get": "row.methods" }, "detail": { "get": "row.detail" }, "badge": { "get": "row.badge" }, "icon": "share" },
                        "children": [
                          { "type": "Inline", "when": { "get": "row.active" }, "props": { "gap": "s", "wrap": true },
                            "children": [
                              { "type": "Button", "when": { "get": "row.link" }, "props": { "label": { "t": "share.dialog.copyLink" }, "size": "s", "disabled": { "get": "vm.shareItem.busy" }, "disabledReason": { "get": "vm.shareItem.actionReason" } }, "on": { "press": { "run": "share.item.row", "args": { "id": { "get": "row.id" }, "what": "link" } } } },
                              { "type": "Button", "props": { "label": { "t": "share.row.withdraw" }, "size": "s", "disabled": { "get": "vm.shareItem.busy" }, "disabledReason": { "get": "vm.shareItem.actionReason" } }, "on": { "press": { "run": "share.item.row", "args": { "id": { "get": "row.id" }, "what": "withdraw" } } } }
                            ]
                          }
                        ]
                      }, "empty": { "type": "Text", "props": { "value": { "t": "share.list.empty" } } } }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Dialog", "id": "shareWithdrawDialog", "when": { "get": "vm.shareItem.confirmOpen" },
        "props": { "title": { "t": "share.withdraw.title" }, "closeLabel": { "t": "dialog.close" }, "open": { "get": "vm.shareItem.confirmOpen" }, "size": "s", "height": "content" },
        "on": { "openChange": { "run": "share.item.setConfirmOpen", "args": { "open": { "get": "event.open" } } } },
        "children": [
          { "type": "Stack", "props": { "gap": "l" }, "children": [
            { "type": "Text", "props": { "value": { "t": "share.withdraw.text" } } },
            { "type": "Text", "when": { "get": "vm.shareItem.hasProblem" }, "props": { "value": { "get": "vm.shareItem.problem" }, "tone": "danger" } },
            { "type": "Inline", "props": { "gap": "s", "justify": "end" }, "children": [
              { "type": "Button", "props": { "label": { "t": "share.manage.cancel" }, "autoFocus": true }, "on": { "press": { "run": "share.item.setConfirmOpen", "args": { "open": false } } } },
              { "type": "Button", "props": { "label": { "t": "share.withdraw.confirm" }, "variant": "danger", "busy": { "get": "vm.shareItem.busy" } }, "on": { "press": { "run": "share.item.withdraw" } } }
            ] }
          ] }
        ]
      },
      {
        "type": "Dialog",
        "id": "shareContentsDialog",
        "when": { "get": "vm.shareItem.reviewOpen" },
        "props": {
          "title": { "get": "vm.shareItem.reviewTitle" },
          "closeLabel": { "t": "dialog.close" },
          "open": { "get": "vm.shareItem.reviewOpen" },
          "size": "m",
          "height": "content"
        },
        "on": { "openChange": { "run": "share.item.setReviewOpen", "args": { "open": { "get": "event.open" } } } },
        "children": [
          {
            "type": "Stack",
            "props": { "gap": "l" },
            "children": [
              { "type": "Text", "props": { "value": { "get": "vm.shareItem.reviewSummary" }, "tone": "muted", "role": "secondary" } },
              {
                "type": "FileTree",
                "id": "shareContentsTree",
                "props": { "label": { "t": "share.review.tree" }, "items": { "get": "vm.shareItem.items" }, "focusId": { "get": "vm.shareItem.reviewFocus" }, "windowed": true },
                "on": {
                  "select": { "run": "share.item.focusReview", "args": { "id": { "get": "event.id" } } },
                  "expand": { "run": "share.item.expand", "args": { "id": { "get": "event.id" }, "expanded": { "get": "event.expanded" } } }
                }
              },
              {
                "type": "Inline",
                "props": { "justify": "end" },
                "children": [
                  {
                    "type": "Button",
                    "props": { "label": { "t": "share.review.done" } },
                    "on": { "press": { "run": "share.item.setReviewOpen", "args": { "open": false } } }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
