{
  "$schema": "https://prabinpebam.github.io/focus-notes/schemas/ui/view.v1.json",
  "id": "canvas",
  "ia": "IA-VIEW-CANVAS",
  "viewModels": ["vm.app", "vm.canvas", "vm.toolbar"],
  "focus": "editor",
  "root": {
    "type": "AppRoot",
    "props": {
      "scheme": { "get": "vm.app.scheme" },
      "platform": { "get": "vm.app.platform" },
      "contentSize": { "get": "vm.app.fontSize" },
      "focusMode": { "get": "vm.app.focusMode" }
    },
    "children": [
      {
        "type": "Layer",
        "props": { "layer": "trigger", "position": "topBand", "dragBand": true, "landmark": "banner", "label": { "t": "canvas.bandLabel" } },
        "children": [
          {
            "type": "Trigger",
            "props": {
              "label": { "t": "trigger.label" },
              "problemLabel": { "t": "trigger.saveProblem" },
              "problem": { "get": "vm.canvas.saveProblem" },
              "shortcut": { "get": "vm.toolbar.triggerShortcut" },
              "open": { "get": "vm.toolbar.open" },
              "toolbarLabel": { "t": "toolbar.label" },
              "items": { "get": "vm.toolbar.items" },
              "more": { "get": "vm.toolbar.more" },
              "moreLabel": { "t": "toolbar.more" }
            },
            "on": {
              "openChange": { "run": "toolbar.setOpen", "args": { "open": { "get": "event.open" } } },
              "action": { "run": "command.run", "args": { "id": { "get": "event.id" } } }
            }
          }
        ]
      },
      {
        "type": "EditorSurface",
        "id": "editor",
        "when": { "expr": { "==": [{ "get": "vm.canvas.status" }, "ready"] } },
        "props": {
          "documentKey": { "get": "vm.canvas.noteKey" },
          "initialValue": { "get": "vm.canvas.initialMarkdown" },
          "label": { "t": "canvas.editorLabel" },
          "focusMode": { "get": "vm.app.focusMode" },
          "placeholder": { "t": "canvas.placeholder", "args": { "platform": { "get": "vm.app.platform" } } }
        },
        "on": {
          "change": { "run": "note.setContent", "args": { "value": { "get": "event.value" } } },
          "ready": { "run": "app.ready" }
        }
      }
    ]
  }
}
