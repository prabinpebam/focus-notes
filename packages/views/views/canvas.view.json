{
  "$schema": "https://prabinpebam.github.io/focus-notes/schemas/ui/view.v1.json",
  "id": "canvas",
  "ia": "IA-VIEW-CANVAS",
  "viewModels": [
    "vm.app",
    "vm.canvas",
    "vm.toolbar",
    "vm.shortcuts",
    "vm.find",
    "vm.feedback"
  ],
  "focus": "editor",
  "root": {
    "type": "AppRoot",
    "props": {
      "scheme": {
        "get": "vm.app.scheme"
      },
      "platform": {
        "get": "vm.app.platform"
      },
      "contentSize": {
        "get": "vm.app.fontSize"
      },
      "focusMode": {
        "get": "vm.app.focusMode"
      },
      "theme": {
        "get": "vm.app.theme"
      },
      "contentFont": {
        "get": "vm.app.contentFont"
      },
      "uiScale": {
        "get": "vm.app.uiScale"
      }
    },
    "children": [
      {
        "type": "Layer",
        "props": {
          "layer": "trigger",
          "position": "topBand",
          "dragBand": true,
          "landmark": "banner",
          "label": {
            "t": "canvas.bandLabel"
          }
        },
        "children": [
          {
            "type": "Trigger",
            "props": {
              "label": {
                "t": "trigger.label"
              },
              "problemLabel": {
                "t": "trigger.saveProblem"
              },
              "problem": {
                "get": "vm.canvas.saveProblem"
              },
              "shortcut": {
                "get": "vm.toolbar.triggerShortcut"
              },
              "open": {
                "get": "vm.toolbar.open"
              },
              "toolbarLabel": {
                "t": "toolbar.label"
              },
              "items": {
                "get": "vm.toolbar.items"
              },
              "more": {
                "get": "vm.toolbar.more"
              },
              "moreLabel": {
                "t": "toolbar.more"
              }
            },
            "on": {
              "openChange": {
                "run": "toolbar.setOpen",
                "args": {
                  "open": {
                    "get": "event.open"
                  }
                }
              },
              "action": {
                "run": "command.run",
                "args": {
                  "id": {
                    "get": "event.id"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "Layer",
        "id": "findBar",
        "when": {
          "get": "vm.find.open"
        },
        "props": {
          "layer": "panel",
          "position": "belowTopBand",
          "landmark": "region",
          "label": {
            "t": "find.label"
          }
        },
        "children": [
          {
            "type": "Surface",
            "props": {
              "variant": "frost",
              "shape": "popover",
              "elevation": "2",
              "padding": "s",
              "keyScope": "findBar"
            },
            "children": [
              {
                "type": "Stack",
                "props": {
                  "gap": "s"
                },
                "children": [
                  {
                    "type": "Inline",
                    "props": {
                      "gap": "xs"
                    },
                    "children": [
                      {
                        "switch": {
                          "get": "vm.find.replaceOpen"
                        },
                        "cases": {
                          "true": {
                            "type": "IconButton",
                            "props": {
                              "icon": "chevronDown",
                              "label": {
                                "get": "vm.find.actions.toggleReplace.label"
                              },
                              "shortcut": {
                                "get": "vm.find.actions.toggleReplace.shortcut"
                              },
                              "tone": "muted",
                              "toggle": true,
                              "pressed": true
                            },
                            "on": {
                              "press": {
                                "run": "find.toggleReplace"
                              }
                            }
                          },
                          "false": {
                            "type": "IconButton",
                            "props": {
                              "icon": "chevronRight",
                              "label": {
                                "get": "vm.find.actions.toggleReplace.label"
                              },
                              "shortcut": {
                                "get": "vm.find.actions.toggleReplace.shortcut"
                              },
                              "tone": "muted",
                              "toggle": true,
                              "pressed": false
                            },
                            "on": {
                              "press": {
                                "run": "find.toggleReplace"
                              }
                            }
                          }
                        }
                      },
                      {
                        "type": "SearchField",
                        "props": {
                          "label": {
                            "t": "find.field"
                          },
                          "placeholder": {
                            "t": "find.field"
                          },
                          "clearLabel": {
                            "t": "field.clear"
                          },
                          "value": {
                            "bind": "vm.find.query"
                          },
                          "focusRequest": {
                            "get": "vm.find.focusFind"
                          },
                          "invalid": {
                            "get": "vm.find.invalid"
                          },
                          "keyScope": "findField"
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "value": {
                            "get": "vm.find.status"
                          },
                          "role": "caption",
                          "tone": {
                            "get": "vm.find.statusTone"
                          },
                          "announce": true,
                          "lines": "one"
                        }
                      },
                      {
                        "type": "IconButton",
                        "props": {
                          "icon": "matchCase",
                          "label": {
                            "get": "vm.find.actions.case.label"
                          },
                          "shortcut": {
                            "get": "vm.find.actions.case.shortcut"
                          },
                          "tone": "muted",
                          "toggle": true,
                          "pressed": {
                            "get": "vm.find.caseSensitive"
                          }
                        },
                        "on": {
                          "press": {
                            "run": "find.toggle.caseSensitive"
                          }
                        }
                      },
                      {
                        "type": "IconButton",
                        "props": {
                          "icon": "wholeWord",
                          "label": {
                            "get": "vm.find.actions.word.label"
                          },
                          "shortcut": {
                            "get": "vm.find.actions.word.shortcut"
                          },
                          "tone": "muted",
                          "toggle": true,
                          "pressed": {
                            "get": "vm.find.wholeWord"
                          }
                        },
                        "on": {
                          "press": {
                            "run": "find.toggle.wholeWord"
                          }
                        }
                      },
                      {
                        "type": "IconButton",
                        "props": {
                          "icon": "regex",
                          "label": {
                            "get": "vm.find.actions.regex.label"
                          },
                          "shortcut": {
                            "get": "vm.find.actions.regex.shortcut"
                          },
                          "tone": "muted",
                          "toggle": true,
                          "pressed": {
                            "get": "vm.find.regex"
                          }
                        },
                        "on": {
                          "press": {
                            "run": "find.toggle.regex"
                          }
                        }
                      },
                      {
                        "type": "IconButton",
                        "props": {
                          "icon": "arrowUp",
                          "label": {
                            "get": "vm.find.actions.prev.label"
                          },
                          "shortcut": {
                            "get": "vm.find.actions.prev.shortcut"
                          },
                          "tone": "muted"
                        },
                        "on": {
                          "press": {
                            "run": "find.prev"
                          }
                        }
                      },
                      {
                        "type": "IconButton",
                        "props": {
                          "icon": "arrowDown",
                          "label": {
                            "get": "vm.find.actions.next.label"
                          },
                          "shortcut": {
                            "get": "vm.find.actions.next.shortcut"
                          },
                          "tone": "muted"
                        },
                        "on": {
                          "press": {
                            "run": "find.next"
                          }
                        }
                      },
                      {
                        "type": "IconButton",
                        "props": {
                          "icon": "dismiss",
                          "label": {
                            "get": "vm.find.actions.close.label"
                          },
                          "shortcut": {
                            "get": "vm.find.actions.close.shortcut"
                          },
                          "tone": "muted"
                        },
                        "on": {
                          "press": {
                            "run": "find.close"
                          }
                        }
                      }
                    ]
                  },
                  {
                    "type": "Inline",
                    "when": {
                      "get": "vm.find.replaceOpen"
                    },
                    "props": {
                      "gap": "xs"
                    },
                    "children": [
                      {
                        "type": "SearchField",
                        "props": {
                          "label": {
                            "t": "find.replaceField"
                          },
                          "placeholder": {
                            "t": "find.replaceField"
                          },
                          "clearLabel": {
                            "t": "field.clear"
                          },
                          "value": {
                            "bind": "vm.find.replace"
                          },
                          "focusRequest": {
                            "get": "vm.find.focusReplace"
                          },
                          "keyScope": "replaceField"
                        }
                      },
                      {
                        "type": "Button",
                        "props": {
                          "label": {
                            "get": "vm.find.actions.replaceNext.label"
                          },
                          "size": "s",
                          "disabled": {
                            "expr": {
                              "!": {
                                "get": "vm.find.canReplace"
                              }
                            }
                          },
                          "disabledReason": {
                            "t": "find.noReplace"
                          }
                        },
                        "on": {
                          "press": {
                            "run": "find.replaceNext"
                          }
                        }
                      },
                      {
                        "type": "Button",
                        "props": {
                          "label": {
                            "get": "vm.find.actions.replaceAll.label"
                          },
                          "size": "s",
                          "disabled": {
                            "expr": {
                              "!": {
                                "get": "vm.find.canReplace"
                              }
                            }
                          },
                          "disabledReason": {
                            "t": "find.noReplace"
                          }
                        },
                        "on": {
                          "press": {
                            "run": "find.replaceAll"
                          }
                        }
                      }
                    ]
                  },
                  {
                    "type": "Text",
                    "when": {
                      "expr": {
                        "!=": [
                          {
                            "get": "vm.find.notice"
                          },
                          ""
                        ]
                      }
                    },
                    "props": {
                      "value": {
                        "get": "vm.find.notice"
                      },
                      "role": "caption",
                      "tone": "muted",
                      "announce": true
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "EditorSurface",
        "id": "editor",
        "when": {
          "expr": {
            "==": [
              {
                "get": "vm.canvas.status"
              },
              "ready"
            ]
          }
        },
        "props": {
          "documentKey": {
            "get": "vm.canvas.noteKey"
          },
          "initialValue": {
            "get": "vm.canvas.initialMarkdown"
          },
          "label": {
            "t": "canvas.editorLabel"
          },
          "focusMode": {
            "get": "vm.app.focusMode"
          },
          "placeholder": {
            "t": "canvas.placeholder",
            "args": {
              "platform": {
                "get": "vm.app.platform"
              }
            }
          },
          "keymap": {
            "get": "vm.app.editorKeymap"
          },
          "findOpen": {
            "get": "vm.find.open"
          },
          "findQuery": {
            "get": "vm.find.query"
          },
          "findReplace": {
            "get": "vm.find.replace"
          },
          "findCase": {
            "get": "vm.find.caseSensitive"
          },
          "findWord": {
            "get": "vm.find.wholeWord"
          },
          "findRegex": {
            "get": "vm.find.regex"
          }
        },
        "on": {
          "change": {
            "run": "note.setContent",
            "args": {
              "value": {
                "get": "event.value"
              }
            }
          },
          "ready": {
            "run": "app.ready"
          },
          "findResult": {
            "run": "find.setResult",
            "args": {
              "count": {
                "get": "event.count"
              },
              "current": {
                "get": "event.current"
              },
              "invalid": {
                "get": "event.invalid"
              },
              "wrapped": {
                "get": "event.wrapped"
              },
              "replaced": {
                "get": "event.replaced"
              }
            }
          },
          "findPrefill": {
            "run": "find.prefill",
            "args": {
              "value": {
                "get": "event.value"
              }
            }
          }
        }
      },
      {
        "type": "Dialog",
        "id": "shortcuts",
        "props": {
          "title": {
            "t": "shortcuts.title"
          },
          "closeLabel": {
            "t": "dialog.close"
          },
          "open": {
            "get": "vm.shortcuts.open"
          },
          "size": "l"
        },
        "on": {
          "openChange": {
            "run": "shortcuts.setOpen",
            "args": {
              "open": {
                "get": "event.open"
              }
            }
          }
        },
        "slots": {
          "toolbar": [
            {
              "type": "Stack",
              "props": {
                "gap": "m"
              },
              "children": [
                {
                  "type": "SearchField",
                  "props": {
                    "label": {
                      "t": "shortcuts.search"
                    },
                    "placeholder": {
                      "t": "shortcuts.searchPlaceholder"
                    },
                    "clearLabel": {
                      "t": "field.clear"
                    },
                    "autoFocus": true,
                    "value": {
                      "bind": "vm.shortcuts.query"
                    }
                  }
                },
                {
                  "type": "Inline",
                  "props": {
                    "justify": "between",
                    "gap": "m",
                    "wrap": true
                  },
                  "children": [
                    {
                      "type": "SegmentedControl",
                      "props": {
                        "label": {
                          "t": "shortcuts.layer"
                        },
                        "options": {
                          "get": "vm.shortcuts.layers"
                        },
                        "value": {
                          "bind": "vm.shortcuts.layer"
                        }
                      }
                    },
                    {
                      "type": "SegmentedControl",
                      "props": {
                        "label": {
                          "t": "shortcuts.platform"
                        },
                        "options": {
                          "get": "vm.shortcuts.platforms"
                        },
                        "value": {
                          "bind": "vm.shortcuts.platform"
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "props": {
                    "value": {
                      "get": "vm.shortcuts.summary"
                    },
                    "role": "caption",
                    "tone": "muted",
                    "announce": true
                  }
                }
              ]
            }
          ]
        },
        "children": [
          {
            "type": "Stack",
            "props": {
              "gap": "xl"
            },
            "children": [
              {
                "each": {
                  "get": "vm.shortcuts.groups"
                },
                "as": "group",
                "key": "group.id",
                "render": {
                  "type": "Stack",
                  "props": {
                    "gap": "s"
                  },
                  "children": [
                    {
                      "type": "Heading",
                      "props": {
                        "level": "3",
                        "value": {
                          "get": "group.label"
                        }
                      }
                    },
                    {
                      "each": {
                        "get": "group.rows"
                      },
                      "as": "row",
                      "key": "row.id",
                      "render": {
                        "type": "Inline",
                        "props": {
                          "justify": "between",
                          "gap": "m"
                        },
                        "children": [
                          {
                            "type": "Text",
                            "props": {
                              "value": {
                                "get": "row.label"
                              }
                            }
                          },
                          {
                            "type": "Inline",
                            "props": {
                              "gap": "s",
                              "wrap": true
                            },
                            "children": [
                              {
                                "each": {
                                  "get": "row.chords"
                                },
                                "as": "chord",
                                "key": "chord.id",
                                "render": {
                                  "type": "Inline",
                                  "props": {
                                    "gap": "s"
                                  },
                                  "children": [
                                    {
                                      "type": "Text",
                                      "when": {
                                        "expr": {
                                          "!": {
                                            "get": "chord.first"
                                          }
                                        }
                                      },
                                      "props": {
                                        "value": {
                                          "t": "shortcuts.or"
                                        },
                                        "role": "caption",
                                        "tone": "muted"
                                      }
                                    },
                                    {
                                      "type": "Shortcut",
                                      "props": {
                                        "keys": {
                                          "get": "chord.keys"
                                        },
                                        "label": {
                                          "get": "chord.spoken"
                                        }
                                      }
                                    }
                                  ]
                                },
                                "empty": {
                                  "type": "Text",
                                  "props": {
                                    "value": {
                                      "t": "shortcuts.noKeys"
                                    },
                                    "tone": "muted"
                                  }
                                }
                              }
                            ]
                          }
                        ]
                      },
                      "empty": {
                        "type": "Text",
                        "props": {
                          "value": {
                            "t": "shortcuts.noKeys"
                          },
                          "tone": "muted"
                        }
                      }
                    }
                  ]
                },
                "empty": {
                  "type": "Text",
                  "props": {
                    "value": {
                      "t": "shortcuts.emptyHint"
                    },
                    "tone": "muted"
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "type": "Layer",
        "id": "toasts",
        "props": {
          "layer": "toast",
          "position": "bottomCenter"
        },
        "children": [
          {
            "type": "Stack",
            "props": {
              "gap": "s",
              "align": "center"
            },
            "children": [
              {
                "each": {
                  "get": "vm.feedback.toasts"
                },
                "as": "toast",
                "key": "toast.id",
                "render": {
                  "type": "Toast",
                  "props": {
                    "message": {
                      "get": "toast.message"
                    },
                    "tone": {
                      "get": "toast.tone"
                    },
                    "actionLabel": {
                      "get": "toast.actionLabel"
                    },
                    "dismissLabel": {
                      "t": "toast.dismiss"
                    },
                    "focusRequest": {
                      "get": "vm.feedback.toastFocus"
                    }
                  },
                  "on": {
                    "action": {
                      "run": "toast.action",
                      "args": {
                        "id": {
                          "get": "toast.id"
                        }
                      }
                    },
                    "dismiss": {
                      "run": "toast.dismiss",
                      "args": {
                        "id": {
                          "get": "toast.id"
                        }
                      }
                    },
                    "pausedChange": {
                      "run": "toast.setPaused",
                      "args": {
                        "id": {
                          "get": "toast.id"
                        },
                        "paused": {
                          "get": "event.paused"
                        }
                      }
                    }
                  }
                },
                "empty": {
                  "type": "Stack",
                  "props": {
                    "gap": "none"
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "type": "LiveRegion",
        "id": "announcer",
        "props": {
          "message": {
            "get": "vm.feedback.announcement"
          },
          "announceKey": {
            "get": "vm.feedback.announcementKey"
          }
        }
      }
    ]
  }
}
