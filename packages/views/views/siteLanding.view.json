{
  "$schema": "https://prabinpebam.github.io/focus-notes/schemas/ui/view.v1.json",
  "id": "siteLanding",
  "ia": "IA-VIEW-SITE",
  "viewModels": [
    "vm.site",
    "vm.siteLanding"
  ],
  "focus": "page",
  "root": {
    "type": "SitePage",
    "id": "page",
    "props": {
      "skipLabel": {
        "t": "site.skip"
      },
      "navLabel": {
        "t": "site.nav.label"
      },
      "width": "wide"
    },
    "slots": {
      "header": [
        {
          "type": "SiteLink",
          "props": {
            "label": {
              "t": "site.brand"
            },
            "href": {
              "get": "vm.site.home"
            },
            "variant": "brand"
          }
        },
        {
          "type": "SiteLink",
          "props": {
            "label": {
              "t": "site.nav.help"
            },
            "href": {
              "get": "vm.site.help"
            },
            "variant": "nav",
            "current": {
              "get": "vm.site.currentHelp"
            }
          }
        },
        {
          "type": "SiteLink",
          "props": {
            "label": {
              "t": "site.nav.demo"
            },
            "href": {
              "get": "vm.site.demo"
            },
            "variant": "nav",
            "current": {
              "get": "vm.site.currentDemo"
            }
          }
        },
        {
          "type": "SiteLink",
          "props": {
            "label": {
              "t": "site.nav.download"
            },
            "href": {
              "get": "vm.site.download"
            },
            "variant": "nav",
            "current": {
              "get": "vm.site.currentDownload"
            }
          }
        }
      ],
      "footer": [
        {
          "type": "Stack",
          "props": {
            "gap": "s"
          },
          "children": [
            {
              "type": "Inline",
              "props": {
                "gap": "l",
                "wrap": true
              },
              "children": [
                {
                  "type": "SiteLink",
                  "props": {
                    "label": {
                      "t": "site.footer.privacy"
                    },
                    "href": {
                      "get": "vm.site.privacy"
                    }
                  }
                },
                {
                  "type": "SiteLink",
                  "props": {
                    "label": {
                      "t": "site.footer.help"
                    },
                    "href": {
                      "get": "vm.site.help"
                    }
                  }
                },
                {
                  "type": "SiteLink",
                  "props": {
                    "label": {
                      "t": "site.footer.source"
                    },
                    "href": {
                      "get": "vm.site.source"
                    }
                  }
                },
                {
                  "type": "SiteLink",
                  "props": {
                    "label": {
                      "t": "site.footer.docs"
                    },
                    "href": {
                      "get": "vm.site.docs"
                    }
                  }
                },
                {
                  "type": "SiteLink",
                  "props": {
                    "label": {
                      "t": "site.footer.app"
                    },
                    "href": {
                      "get": "vm.site.app"
                    }
                  }
                }
              ]
            },
            {
              "type": "Text",
              "props": {
                "value": {
                  "t": "site.footer.note"
                },
                "role": "caption",
                "tone": "muted"
              }
            }
          ]
        }
      ]
    },
    "children": [
      {
        "type": "SiteSection",
        "props": {
          "anchor": {
            "get": "vm.siteLanding.heroAnchor"
          }
        },
        "children": [
          {
            "type": "NoteContent",
            "props": {
              "blocks": {
                "get": "vm.siteLanding.hero"
              }
            }
          },
          {
            "type": "Inline",
            "props": {
              "gap": "m",
              "wrap": true
            },
            "children": [
              {
                "type": "SiteLink",
                "props": {
                  "label": {
                    "t": "site.cta.download"
                  },
                  "href": {
                    "get": "vm.site.download"
                  },
                  "variant": "primary"
                }
              },
              {
                "type": "SiteLink",
                "props": {
                  "label": {
                    "t": "site.cta.demo"
                  },
                  "href": {
                    "get": "vm.site.demo"
                  },
                  "variant": "secondary"
                }
              }
            ]
          }
        ]
      },
      {
        "each": {
          "get": "vm.siteLanding.sections"
        },
        "as": "section",
        "key": "section.key",
        "render": {
          "type": "SiteSection",
          "props": {
            "anchor": {
              "get": "section.anchor"
            },
            "tone": {
              "get": "section.tone"
            }
          },
          "children": [
            {
              "type": "NoteContent",
              "props": {
                "blocks": {
                  "get": "section.body"
                }
              }
            }
          ]
        },
        "empty": {
          "type": "Text",
          "props": {
            "value": {
              "t": "site.landing.empty"
            },
            "role": "body",
            "tone": "muted"
          }
        }
      }
    ]
  }
}
