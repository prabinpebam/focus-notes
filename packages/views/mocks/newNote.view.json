               "variant": "raised",
               "shape": "sheet",
               "padding": "none"
              },
              "children": [
               {
                "type": "Stack",
                "props": {
                 "gap": "stackItem",
                 "padding": "insetMd",
                 "grow": true
                },
                "children": [
                 {
                  "type": "Heading",
