             {
              "type": "Button",
              "on": {
               "press": {
                "set": "local.step",
                "to": "quick"
               }
              },
              "props": {
               "label": {
                "t": "project.mock.again"
               },
               "variant": "subtle",
               "size": "s"
              }
             }
            ]
           }
          }
         }
        ]
       }
      ]
     }
    ]
   }
  ]
 }
