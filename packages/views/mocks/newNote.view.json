                    "t": "quick.body"
                   },
                   "personal": true
                  }
                 }
                ]
               },
               {
                "type": "Inline",
                "props": {
                 "gap": "inlineItem",
                 "align": "center",
                 "padding": "insetSm"
                },
                "children": [
                 {
                  "type": "ProjectPill",
                  "on": {
                   "press": {
                    "set": "local.revealed",
                    "to": true
                   }
                  },
                  "props": {
                   "name": {
                    "get": "vm.mocks.localNotesPath"
                   },
                   "icon": "hardDrive",
                   "path": true,
                   "label": {
                    "t": "project.local.reveal",
                    "args": {
                     "path": {
                      "get": "vm.mocks.localNotesPath"
                     }
                    }
                   }
                  }
                 }
                ]
               }
              ]
             },
             {
              "type": "Inline",
              "props": {
               "gap": "inlineItem",
               "align": "center"
              },
              "children": [
               {
                "type": "Button",
                "on": {
                 "press": {
                  "set": "local.step",
                  "to": "quickNew"
                 }
                },
                "props": {
                 "label": {
                  "t": "project.mock.newNote"
                 },
                 "variant": "secondary",
                 "icon": "newNote",
                 "size": "s"
                }
               },
               {
                "type": "Shortcut",
                "props": {
                 "keys": {
                  "get": "vm.mocks.keysNewIn"
                 },
                 "label": {
                  "get": "vm.mocks.keysNewInSpoken"
                 }
                }
               }
              ]
             }
            ]
           },
           "quickNew": {
            "type": "Stack",
            "props": {
             "gap": "stackGroup"
            },
            "children": [
             {
              "type": "Surface",
              "props": {
               "variant": "raised",
               "shape": "sheet",
               "padding": "none"
              },
              "children": [
               {
                "type": "Stack",
                "props": {
                 "gap": "stackItem",
                 "padding": "insetMd",
