{
 "$schema": "https://prabinpebam.github.io/focus-notes/schemas/ui/view.v1.json",
 "id": "gallery.mock.migrate",
 "viewModels": [
  "vm.app",
  "vm.mocks"
 ],
 "focus": "mockBack",
 "local": {
  "step": "explainer"
 },
 "root": {
  "type": "AppRoot",
  "props": {
   "scheme": {
    "get": "vm.app.scheme"
   },
   "platform": {
    "get": "vm.app.platform"
   }
  },
  "children": [
   {
    "type": "Surface",
    "props": {
     "variant": "canvas",
     "scroll": true
    },
    "children": [
     {
      "type": "Center",
      "props": {
       "maxWidth": "wideContent"
      },
      "children": [
       {
        "type": "Stack",
        "props": {
         "gap": "stackGroup",
         "padding": "insetLg"
        },
        "children": [
         {
          "type": "Stack",
          "props": {
           "gap": "stackItem"
          },
          "children": [
           {
            "type": "Inline",
            "props": {
             "gap": "inlineItem",
             "align": "center"
            },
            "children": [
             {
              "type": "Button",
              "id": "mockBack",
              "on": {
               "press": {
                "run": "gallery.open",
                "args": {
                 "id": ""
                }
               }
              },
              "props": {
               "label": {
                "t": "project.mock.back"
               },
               "variant": "subtle",
               "size": "s",
               "icon": "chevronLeft"
              }
             },
             {
              "type": "Text",
              "props": {
               "value": {
                "t": "project.mock.badge"
               },
               "role": "caption",
               "tone": "muted"
              }
             }
            ]
           },
           {
            "type": "Heading",
            "props": {
             "value": {
              "t": "project.mock.migrate.title"
             },
             "level": "1"
            }
           },
           {
            "type": "Text",
            "props": {
             "value": {
              "t": "project.mock.migrate.intro"
             },
             "tone": "muted"
            }
           },
           {
            "type": "Inline",
            "props": {
             "gap": "inlinePair",
             "wrap": true,
             "label": {
              "t": "project.mock.steps"
             }
            },
            "children": [
             {
              "type": "Button",
              "on": {
               "press": {
                "set": "local.step",
                "to": "explainer"
               }
              },
              "props": {
               "label": {
                "t": "project.mock.step.explainer"
               },
               "size": "s",
               "variant": "subtle"
              }
             },
             {
              "type": "Button",
              "on": {
               "press": {
                "set": "local.step",
                "to": "words"
               }
              },
              "props": {
               "label": {
                "t": "project.mock.step.words"
               },
               "size": "s",
               "variant": "subtle"
              }
             }
            ]
           }
          ]
         },
         {
          "switch": {
           "get": "local.step"
          },
          "cases": {
           "explainer": {
            "type": "DialogPanel",
            "on": {
             "openChange": {
              "set": "local.step",
              "to": "help"
             }
            },
            "props": {
             "open": true,
             "size": "l",
             "height": "content",
             "label": {
              "t": "migrate.explainer.title"
             }
            },
            "slots": {
             "header": [
              {
               "type": "Heading",
               "props": {
                "value": {
                 "t": "migrate.explainer.title"
                },
                "level": "2"
               }
              }
             ],
             "footer": [
              {
               "type": "Inline",
               "props": {
                "gap": "inlineItem",
                "justify": "end"
               },
               "children": [
                {
                 "type": "Button",
                 "props": {
                  "label": {
                   "t": "migrate.openHelp"
                  },
                  "variant": "subtle"
                 }
                }
               ]
              }
             ]
            },
            "children": [
             {
              "type": "Stack",
              "props": {
               "gap": "stackGroup"
              },
              "children": [
               {
                "type": "Text",
                "props": {
                 "value": {
                  "t": "migrate.help"
                 }
                }
               },
               {
                "type": "Stack",
                "props": {
                 "gap": "stackItem"
                },
                "children": [
                 {
                  "type": "Columns",
                  "props": {
                   "gap": "inlineItem"
                  },
                  "children": [
                   {
                    "type": "Surface",
                    "props": {
                     "variant": "sunken",
                     "shape": "popover",
                     "padding": "insetMd"
                    },
                    "children": [
                     {
                      "type": "Stack",
                      "props": {
                       "gap": "stackPair"
                      },
                      "children": [
                       {
                        "type": "Text",
                        "props": {
                         "value": {
                          "t": "migrate.fig.window"
                         },
                         "role": "label"
                        }
                       },
                       {
                        "type": "Text",
                        "props": {
                         "value": {
                          "t": "migrate.fig.window1"
                         }
                        }
                       },
                       {
                        "type": "Text",
                        "props": {
                         "value": {
                          "t": "migrate.fig.window2"
                         }
                        }
                       },
                       {
                        "type": "Text",
                        "props": {
                         "value": {
                          "t": "migrate.fig.windowFoot"
                         },
                         "role": "caption",
                         "tone": "muted"
                        }
                       }
                      ]
                     }
                    ]
                   },
                   {
                    "type": "Surface",
                    "props": {
                     "variant": "sunken",
                     "shape": "popover",
                     "padding": "insetMd"
                    },
                    "children": [
                     {
                      "type": "Stack",
                      "props": {
                       "gap": "stackPair"
                      },
                      "children": [
                       {
                        "type": "Text",
                        "props": {
                         "value": {
                          "t": "migrate.fig.private"
                         },
                         "role": "label"
                        }
                       },
                       {
                        "type": "Text",
                        "props": {
                         "value": {
                          "t": "migrate.fig.private1"
                         }
                        }
                       },
                       {
                        "type": "Text",
                        "props": {
                         "value": {
                          "t": "migrate.fig.private2"
                         }
                        }
                       },
                       {
                        "type": "Text",
                        "props": {
                         "value": {
                          "t": "migrate.fig.privateFoot"
                         },
                         "role": "caption",
                         "tone": "muted"
                        }
                       }
                      ]
                     }
                    ]
                   },
                   {
                    "type": "Surface",
                    "props": {
                     "variant": "sunken",
                     "shape": "popover",
                     "padding": "insetMd"
                    },
                    "children": [
                     {
                      "type": "Stack",
                      "props": {
                       "gap": "stackPair"
                      },
                      "children": [
                       {
                        "type": "Text",
                        "props": {
                         "value": {
                          "t": "migrate.fig.site"
                         },
                         "role": "label"
                        }
                       },
                       {
                        "type": "Text",
                        "props": {
                         "value": {
                          "t": "migrate.fig.site1"
                         }
                        }
                       },
                       {
                        "type": "Text",
                        "props": {
                         "value": {
                          "t": "migrate.fig.site2"
                         }
                        }
                       },
                       {
                        "type": "Text",
                        "props": {
                         "value": {
                          "t": "migrate.fig.siteFoot"
                         },
                         "role": "caption",
                         "tone": "muted"
                        }
                       }
                      ]
                     }
                    ]
                   }
                  ]
                 },
                 {
                  "type": "Surface",
                  "props": {
                   "variant": "sunken",
                   "shape": "popover",
                   "padding": "insetMd"
                  },
                  "children": [
                   {
                    "type": "Inline",
                    "props": {
                     "gap": "inlineItem",
                     "align": "center"
                    },
                    "children": [
                     {
                      "type": "Icon",
                      "props": {
                       "name": "quickNote",
                       "size": "m"
                      }
                     },
                     {
                      "type": "Text",
                      "props": {
                       "value": {
                        "t": "migrate.fig.local"
                       }
                      }
                     }
                    ]
                   }
                  ]
                 }
                ]
               }
              ]
             }
            ]
           },
           "words": {
            "type": "Columns",
            "props": {
             "gap": "inlineGroup"
            },
            "children": [
             {
              "type": "Stack",
              "props": {
               "gap": "stackItem"
              },
              "children": [
               {
                "type": "Text",
                "props": {
                 "value": {
                  "t": "migrate.before"
                 },
                 "role": "label",
                 "tone": "muted"
                }
               },
               {
                "type": "Surface",
                "props": {
                 "variant": "raised",
                 "shape": "popover",
                 "padding": "insetMd"
                },
                "children": [
                 {
                  "type": "Stack",
                  "props": {
                   "gap": "stackItem"
                  },
                  "children": [
                   {
                    "type": "Surface",
                    "props": {
                     "variant": "sunken",
                     "shape": "control",
                     "padding": "insetSm"
                    },
                    "children": [
                     {
                      "type": "Text",
                      "props": {
                       "value": {
                        "t": "migrate.oldFiles"
                       },
                       "role": "label"
                      }
                     }
                    ]
                   },
                   {
                    "type": "ResultList",
                    "id": "settingsBefore",
                    "props": {
                     "label": {
                      "t": "migrate.oldSettings"
                     },
                     "items": {
                      "get": "vm.mocks.settingsBefore"
                     }
                    }
                   }
                  ]
                 }
                ]
               }
              ]
             },
             {
              "type": "Stack",
              "props": {
               "gap": "stackItem"
              },
              "children": [
               {
                "type": "Text",
                "props": {
                 "value": {
                  "t": "migrate.after"
                 },
                 "role": "label",
                 "tone": "accent"
                }
               },
               {
                "type": "Surface",
                "props": {
                 "variant": "raised",
                 "shape": "popover",
                 "padding": "insetMd"
                },
                "children": [
                 {
                  "type": "Stack",
                  "props": {
                   "gap": "stackItem"
                  },
                  "children": [
                   {
                    "type": "Inline",
                    "props": {
                     "gap": "inlineItem",
                     "align": "center",
                     "padding": "insetSm"
                    },
                    "children": [
                     {
                      "type": "Text",
                      "props": {
                       "value": {
                        "t": "project.mock.workName"
                       },
                       "role": "title"
                      }
                     }
                    ]
                   },
                   {
                    "type": "ResultList",
                    "id": "settingsAfter",
                    "props": {
                     "label": {
                      "t": "migrate.newSettings"
                     },
                     "items": {
                      "get": "vm.mocks.settingsAfter"
                     }
                    }
                   }
                  ]
                 }
                ]
               }
              ]
             }
            ]
           }
          }
         }
        ]
       }
      ]
     }
    ]
   }
  ]
 }
}
