                 "variant": "secondary",
                 "size": "s",
                 "toggle": true,
                 "pressed": {
                  "expr": {
                   "==": [
                    {
                     "get": "local.plate"
                    },
                    "neutral"
                   ]
                  }
                 }
                }
               },
               {
                "type": "Button",
                "on": {
                 "press": [
                  {
                   "set": "local.upload",
