                  "type": "Stack",
                  "props": {
                   "gap": "s",
                   "padding": "l",
                   "align": "center"
                  },
                  "children": [
                   {
                    "type": "ProjectMark",
                    "props": {
                     "logo": "upload",
                     "src": {
                      "get": "vm.mocks.logoSrc"
                     },
                     "plate": {
                      "get": "local.plate"
                     },
                     "size": "xl"
                    },
                    "when": {
                     "expr": {
                      "!=": [
                       {
                        "get": "local.upload"
                       },
                       "dark"
                      ]
                     }
                    }
                   },
                   {
                    "type": "ProjectMark",
                    "props": {
                     "logo": "upload",
                     "src": {
                      "get": "vm.mocks.darkLogoSrc"
                     },
                     "plate": {
                      "get": "local.plate"
                     },
                     "size": "xl"
                    },
                    "when": {
                     "expr": {
                      "==": [
                       {
                        "get": "local.upload"
                       },
                       "dark"
