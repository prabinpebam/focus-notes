{
 "$schema": "https://prabinpebam.github.io/focus-notes/schemas/ui/view.v1.json",
 "id": "gallery.mock.names",
 "viewModels": [
  "vm.app",
  "vm.mocks"
 ],
 "focus": "mockBack",
 "local": {
  "step": "overview",
  "file": "chapter-one-draft"
 },
 "root": {
  "type": "AppRoot",
  "props": {
   "scheme": {
    "get": "vm.app.scheme"
   },
   "platform": {
    "get": "vm.app.platform"
   }
  },
  "children": [
   {
    "type": "Surface",
    "props": {
     "variant": "canvas",
     "scroll": true
    },
    "children": [
     {
      "type": "Center",
      "props": {
       "maxWidth": "wideContent"
      },
      "children": [
       {
        "type": "Stack",
        "props": {
         "gap": "stackGroup",
         "padding": "insetLg"
        },
        "children": [
         {
          "type": "Stack",
          "props": {
           "gap": "stackItem"
          },
          "children": [
           {
            "type": "Inline",
            "props": {
             "gap": "inlineItem",
             "align": "center"
            },
            "children": [
             {
              "type": "Button",
              "id": "mockBack",
              "on": {
               "press": {
                "run": "gallery.open",
                "args": {
                 "id": ""
                }
               }
              },
              "props": {
               "label": {
                "t": "project.mock.back"
               },
               "variant": "subtle",
               "size": "s",
               "icon": "chevronLeft"
              }
             },
             {
              "type": "Text",
              "props": {
               "value": {
                "t": "project.mock.badge"
               },
               "role": "caption",
               "tone": "muted"
              }
             }
            ]
           },
           {
            "type": "Heading",
            "props": {
             "value": {
              "t": "project.mock.names.title"
             },
             "level": "1"
            }
           },
           {
            "type": "Text",
            "props": {
             "value": {
              "t": "project.mock.names.intro"
             },
             "tone": "muted"
            }
           },
           {
            "type": "Inline",
            "props": {
             "gap": "inlinePair",
             "wrap": true,
             "label": {
              "t": "project.mock.steps"
             }
            },
            "children": [
             {
              "type": "Button",
              "on": {
               "press": {
                "set": "local.step",
                "to": "overview"
               }
              },
              "props": {
               "label": {
                "t": "project.mock.step.overview"
               },
               "size": "s",
               "variant": "subtle",
               "toggle": true,
               "pressed": {
                "expr": {
                 "==": [
                  {
                   "get": "local.step"
                  },
                  "overview"
                 ]
                }
               }
              }
             },
             {
              "type": "Button",
              "on": {
               "press": {
                "set": "local.step",
                "to": "renameTitle"
               }
              },
              "props": {
               "label": {
                "t": "project.mock.step.renameTitle"
               },
               "size": "s",
               "variant": "subtle",
               "toggle": true,
               "pressed": {
                "expr": {
                 "==": [
                  {
                   "get": "local.step"
                  },
                  "renameTitle"
                 ]
                }
               }
              }
             },
             {
              "type": "Button",
              "on": {
               "press": {
                "set": "local.step",
                "to": "renameFile"
               }
              },
              "props": {
               "label": {
                "t": "project.mock.step.renameFile"
               },
               "size": "s",
               "variant": "subtle",
               "toggle": true,
               "pressed": {
                "expr": {
                 "==": [
                  {
                   "get": "local.step"
                  },
                  "renameFile"
                 ]
                }
               }
              }
             },
             {
              "type": "Button",
              "on": {
               "press": {
                "set": "local.step",
                "to": "published"
               }
              },
              "props": {
               "label": {
                "t": "project.mock.step.published"
               },
               "size": "s",
               "variant": "subtle",
               "toggle": true,
               "pressed": {
                "expr": {
                 "==": [
                  {
                   "get": "local.step"
                  },
                  "published"
                 ]
                }
               }
              }
             }
            ]
           }
          ]
         },
         {
          "type": "Columns",
          "props": {
           "gap": "inlineGroup"
          },
          "children": [
           {
            "type": "Surface",
            "props": {
             "variant": "raised",
             "shape": "sheet",
             "padding": "none"
            },
            "children": [
             {
              "type": "Inline",
              "props": {
               "gap": "inlineItem",
               "align": "center",
               "padding": "insetSm"
              },
              "children": [
               {
                "type": "Text",
                "props": {
                 "value": {
                  "t": "project.mock.bookName"
                 },
                 "role": "title"
                }
               }
              ]
             },
             {
              "type": "Stack",
              "props": {
               "gap": "stackItem",
               "padding": "insetMd"
              },
              "children": [
               {
                "type": "FileTree",
                "id": "namesTree",
                "props": {
                 "label": {
                  "t": "project.files.tree"
                 },
                 "items": {
                  "get": "vm.mocks.namesTree"
                 },
                 "menu": {
                  "get": "vm.mocks.filesMenu"
                 }
                }
               }
              ]
             }
            ]
           },
           {
            "type": "Stack",
            "props": {
             "gap": "stackGroup"
            },
            "children": [
             {
              "type": "ProjectScope",
              "props": {
               "part": "window",
               "accent": "teal",
               "grow": true
              },
              "children": [
               {
                "type": "Stack",
                "props": {
                 "gap": "stackItem",
                 "padding": "insetMd",
                 "grow": true
                },
                "children": [
                 {
                  "switch": {
                   "get": "local.step"
                  },
                  "cases": {
                   "overview": {
                    "type": "Heading",
                    "props": {
                     "value": {
                      "t": "project.names.title"
                     },
                     "level": "1"
                    }
                   },
                   "renameTitle": {
                    "type": "Surface",
                    "props": {
                     "variant": "sunken",
                     "shape": "control",
                     "padding": "insetSm"
                    },
                    "children": [
                     {
                      "type": "Heading",
                      "props": {
                       "value": {
                        "t": "project.names.title"
                       },
                       "level": "1"
                      }
                     }
                    ]
                   },
                   "renameFile": {
                    "type": "Heading",
                    "props": {
                     "value": {
                      "t": "project.names.title"
                     },
                     "level": "1"
                    }
                   },
                   "published": {
                    "type": "Heading",
                    "props": {
                     "value": {
                      "t": "project.names.aboutTitle"
                     },
                     "level": "1"
                    }
                   },
                   "renamed": {
                    "type": "Heading",
                    "props": {
                     "value": {
                      "t": "project.names.title"
                     },
                     "level": "1"
                    }
                   }
                  }
                 },
                 {
                  "type": "Text",
                  "props": {
                   "value": {
                    "get": "vm.mocks.sampleNote"
                   },
                   "personal": true
                  }
                 }
                ]
               },
               {
                "type": "Inline",
                "props": {
                 "gap": "inlineItem",
                 "align": "center",
                 "padding": "insetSm"
                },
                "children": [
                 {
                  "type": "SaveState",
                  "props": {
                   "state": "synced",
                   "label": {
                    "t": "project.mock.backedUp"
                   }
                  }
                 },
                 {
                  "type": "ProjectPill",
                  "on": {
                   "press": {
                    "run": "gallery.open",
                    "args": {
                     "id": "mock.identity"
                    }
                   }
                  },
                  "props": {
                   "name": {
                    "t": "project.mock.bookName"
                   },
                   "logo": "book",
                   "accent": "teal",
                   "label": {
                    "t": "project.pill.label",
                    "args": {
                     "name": {
                      "t": "project.mock.bookName"
                     }
                    }
                   }
                  }
                 }
                ]
               }
              ]
             },
             {
              "type": "StatusRow",
              "props": {
               "message": {
                "t": "project.names.renamed",
                "args": {
                 "file": {
                  "get": "local.file"
                 }
                }
               },
               "tone": "success",
               "icon": "check"
              },
              "when": {
               "expr": {
                "==": [
                 {
                  "get": "local.step"
                 },
                 "renamed"
                ]
               }
              }
             }
            ]
           }
          ]
         },
         {
          "type": "DialogPanel",
          "on": {
           "openChange": {
            "set": "local.step",
            "to": "overview"
           }
          },
          "props": {
           "open": true,
           "size": "m",
           "height": "content",
           "label": {
            "t": "project.names.renameFile"
           }
          },
          "slots": {
           "header": [
            {
             "type": "Heading",
             "props": {
              "value": {
               "t": "project.names.renameFile"
              },
              "level": "2"
             }
            }
           ],
           "footer": [
            {
             "type": "Inline",
             "props": {
              "gap": "inlineItem",
              "justify": "end"
             },
             "children": [
              {
               "type": "Button",
               "on": {
                "press": {
                 "set": "local.step",
                 "to": "overview"
                }
               },
               "props": {
                "label": {
                 "t": "project.cancel"
                },
                "variant": "secondary"
               }
              },
              {
               "type": "Button",
               "on": {
                "press": {
                 "set": "local.step",
                 "to": "renamed"
                }
               },
               "props": {
                "label": {
                 "t": "project.names.renameAction"
                },
                "variant": "primary"
               }
              }
             ]
            }
           ]
          },
          "children": [
           {
            "type": "Stack",
            "props": {
             "gap": "stackGroup"
            },
            "children": [
             {
              "type": "Inline",
              "props": {
               "gap": "inlinePair",
               "align": "end"
              },
              "children": [
               {
                "type": "TextField",
                "props": {
                 "label": {
                  "t": "project.names.fileField"
                 },
                 "value": {
                  "bind": "local.file"
                 },
                 "autoFocus": true
                }
               },
               {
                "type": "Text",
                "props": {
                 "value": {
                  "t": "project.names.ext"
                 },
                 "tone": "muted"
                }
               }
              ]
             },
             {
              "type": "StatusRow",
              "props": {
               "message": {
                "t": "project.names.links"
               },
               "tone": "info",
               "icon": "link"
              }
             }
            ]
           }
          ],
          "when": {
           "expr": {
            "==": [
             {
              "get": "local.step"
             },
             "renameFile"
            ]
           }
          }
         },
         {
          "type": "DialogPanel",
          "on": {
           "openChange": {
            "set": "local.step",
            "to": "overview"
           }
          },
          "props": {
           "open": true,
           "size": "m",
           "height": "content",
           "label": {
            "t": "project.names.renameFile"
           }
          },
          "slots": {
           "header": [
            {
             "type": "Heading",
             "props": {
              "value": {
               "t": "project.names.renameFile"
              },
              "level": "2"
             }
            }
           ],
           "footer": [
            {
             "type": "Inline",
             "props": {
              "gap": "inlineItem",
              "justify": "end"
             },
             "children": [
              {
               "type": "Button",
               "on": {
                "press": {
                 "set": "local.step",
                 "to": "overview"
                }
               },
               "props": {
                "label": {
                 "t": "project.cancel"
                },
                "variant": "secondary"
               }
              },
              {
               "type": "Button",
               "on": {
                "press": {
                 "set": "local.step",
                 "to": "overview"
                }
               },
               "props": {
                "label": {
                 "t": "project.names.renameAction"
                },
                "variant": "primary"
               }
              }
             ]
            }
           ]
          },
          "children": [
           {
            "type": "Stack",
            "props": {
             "gap": "stackGroup"
            },
            "children": [
             {
              "type": "TextField",
              "props": {
               "label": {
                "t": "project.names.fileField"
               },
               "value": {
                "get": "vm.mocks.aboutFile"
               },
               "autoFocus": true
              }
             },
             {
              "type": "StatusRow",
              "props": {
               "message": {
                "t": "project.names.publishedWarning"
               },
               "tone": "warning",
               "icon": "globe"
              }
             }
            ]
           }
          ],
          "when": {
           "expr": {
            "==": [
             {
              "get": "local.step"
             },
             "published"
            ]
           }
          }
         }
        ]
       }
      ]
     }
    ]
   }
  ]
 }
}
