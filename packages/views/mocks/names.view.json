{
 "$schema": "https://prabinpebam.github.io/focus-notes/schemas/ui/view.v1.json",
 "id": "gallery.mock.names",
 "viewModels": [
  "vm.app",
  "vm.mocks"
 ],
 "focus": "mockBack",
 "local": {
  "step": "overview",
  "file": "chapter-one-draft"
 },
 "root": {
  "type": "AppRoot",
  "props": {
   "scheme": {
    "get": "vm.app.scheme"
   },
   "platform": {
    "get": "vm.app.platform"
   }
  },
  "children": [
   {
    "type": "Center",
    "props": {
     "maxWidth": "wideContent"
    },
    "children": [
     {
      "type": "Stack",
      "props": {
       "gap": "l",
       "padding": "xl"
      },
      "children": [
       {
        "type": "Stack",
        "props": {
         "gap": "s"
        },
        "children": [
         {
          "type": "Inline",
          "props": {
           "gap": "s",
           "align": "center"
          },
          "children": [
           {
            "type": "Button",
            "id": "mockBack",
            "on": {
             "press": {
              "run": "gallery.open",
              "args": {
               "id": ""
              }
             }
            },
            "props": {
             "label": {
              "t": "project.mock.back"
             },
             "variant": "subtle",
             "size": "s",
             "icon": "chevronLeft"
            }
           },
           {
            "type": "Text",
            "props": {
             "value": {
              "t": "project.mock.badge"
             },
             "role": "caption",
             "tone": "muted"
            }
           }
          ]
         },
         {
          "type": "Heading",
          "props": {
           "value": {
            "t": "project.mock.names.title"
           },
           "level": "1"
          }
         },
         {
          "type": "Text",
          "props": {
           "value": {
            "t": "project.mock.names.intro"
           },
           "tone": "muted"
          }
         },
         {
          "type": "Inline",
          "props": {
           "gap": "xs",
           "wrap": true,
           "label": {
            "t": "project.mock.steps"
           }
          },
          "children": [
           {
            "type": "Button",
            "on": {
             "press": {
              "set": "local.step",
              "to": "overview"
             }
            },
            "props": {
             "label": {
              "t": "project.mock.step.overview"
             },
             "size": "s",
             "variant": "subtle",
             "toggle": true,
             "pressed": {
              "expr": {
               "==": [
                {
                 "get": "local.step"
                },
                "overview"
               ]
              }
             }
            }
           },
           {
            "type": "Button",
            "on": {
             "press": {
              "set": "local.step",
              "to": "renameTitle"
             }
            },
            "props": {
             "label": {
              "t": "project.mock.step.renameTitle"
             },
             "size": "s",
             "variant": "subtle",
             "toggle": true,
             "pressed": {
              "expr": {
               "==": [
                {
                 "get": "local.step"
                },
                "renameTitle"
               ]
              }
             }
            }
           },
           {
            "type": "Button",
            "on": {
             "press": {
              "set": "local.step",
              "to": "renameFile"
             }
            },
            "props": {
             "label": {
              "t": "project.mock.step.renameFile"
             },
             "size": "s",
             "variant": "subtle",
             "toggle": true,
             "pressed": {
              "expr": {
               "==": [
                {
                 "get": "local.step"
                },
                "renameFile"
               ]
              }
             }
            }
           },
           {
            "type": "Button",
            "on": {
             "press": {
              "set": "local.step",
              "to": "published"
             }
            },
            "props": {
             "label": {
              "t": "project.mock.step.published"
             },
             "size": "s",
             "variant": "subtle",
             "toggle": true,
             "pressed": {
              "expr": {
               "==": [
                {
                 "get": "local.step"
                },
                "published"
               ]
              }
             }
            }
           }
          ]
         }
        ]
       },
       {
        "type": "Columns",
        "props": {
         "gap": "l"
        },
        "children": [
         {
          "type": "Surface",
          "props": {
           "variant": "raised",
           "shape": "sheet",
           "padding": "none"
          },
          "children": [
           {
            "type": "ProjectScope",
            "props": {
             "part": "band",
             "accent": "teal"
            },
            "children": [
             {
              "type": "Inline",
              "props": {
               "gap": "s",
               "align": "center",
               "padding": "s"
              },
              "children": [
               {
                "type": "ProjectMark",
                "props": {
                 "logo": "book",
                 "accent": "teal",
                 "size": "s"
                }
               },
               {
                "type": "Text",
                "props": {
                 "value": {
                  "t": "project.mock.bookName"
                 },
                 "role": "label"
                }
               }
              ]
             }
            ]
           },
           {
            "type": "Stack",
            "props": {
             "gap": "s",
             "padding": "m"
            },
            "children": [
             {
              "type": "FileTree",
              "id": "namesTree",
              "props": {
               "label": {
                "t": "project.files.tree"
               },
               "items": {
                "get": "vm.mocks.namesTree"
               },
               "menu": {
                "get": "vm.mocks.filesMenu"
               }
              }
             },
             {
              "type": "Text",
              "props": {
               "value": {
                "t": "project.names.hint"
               },
               "role": "caption",
               "tone": "muted"
              }
             }
            ]
           }
          ]
         },
         {
          "type": "Stack",
          "props": {
           "gap": "m"
          },
          "children": [
           {
            "type": "ProjectScope",
            "props": {
             "part": "window",
             "accent": "teal",
             "appearance": "follow",
             "grow": true
            },
            "children": [
             {
              "type": "ProjectScope",
              "props": {
               "part": "band"
              },
              "children": [
               {
                "type": "Inline",
                "props": {
                 "gap": "s",
                 "align": "center",
                 "padding": "s"
                },
                "children": [
                 {
                  "type": "ProjectMark",
                  "props": {
                   "logo": "book",
                   "accent": "teal",
                   "size": "s"
                  }
                 },
                 {
                  "type": "Text",
                  "props": {
                   "value": {
                    "t": "project.window.title",
                    "args": {
                     "note": {
                      "t": "project.names.title"
                     },
                     "project": {
                      "t": "project.mock.bookName"
                     }
                    }
                   },
                   "role": "caption",
                   "lines": "one"
                  }
                 }
                ]
               }
              ]
             },
             {
              "type": "Stack",
              "props": {
               "gap": "m",
               "padding": "l",
               "grow": true
              },
              "children": [
               {
                "switch": {
                 "get": "local.step"
                },
                "cases": {
                 "overview": {
                  "type": "Stack",
                  "props": {
                   "gap": "xs"
                  },
                  "children": [
                   {
                    "type": "Heading",
                    "props": {
                     "value": {
                      "t": "project.names.title"
                     },
                     "level": "1"
                    }
                   },
                   {
                    "type": "Text",
                    "props": {
                     "value": {
                      "t": "project.names.file"
                     },
                     "role": "caption",
                     "tone": "muted"
                    }
                   }
                  ]
                 },
                 "renameTitle": {
                  "type": "Stack",
                  "props": {
                   "gap": "xs"
                  },
                  "children": [
                   {
                    "type": "TextField",
                    "props": {
                     "label": {
                      "t": "project.names.titleField"
                     },
                     "value": {
                      "get": "vm.mocks.titleValue"
                     },
                     "autoFocus": true,
                     "size": "l",
                     "description": {
                      "t": "project.names.titleHint"
                     }
                    }
                   }
                  ]
                 },
                 "renameFile": {
                  "type": "Stack",
                  "props": {
                   "gap": "xs"
                  },
                  "children": [
                   {
                    "type": "Heading",
                    "props": {
                     "value": {
                      "t": "project.names.title"
                     },
                     "level": "1"
                    }
                   },
                   {
                    "type": "Text",
                    "props": {
                     "value": {
                      "t": "project.names.file"
                     },
                     "role": "caption",
                     "tone": "muted"
                    }
                   }
                  ]
                 },
                 "published": {
                  "type": "Stack",
                  "props": {
                   "gap": "xs"
                  },
                  "children": [
                   {
                    "type": "Heading",
                    "props": {
                     "value": {
                      "t": "project.names.aboutTitle"
                     },
                     "level": "1"
                    }
                   },
                   {
                    "type": "Text",
                    "props": {
                     "value": {
                      "t": "project.names.aboutFile"
                     },
                     "role": "caption",
                     "tone": "muted"
                    }
                   }
                  ]
                 },
                 "renamed": {
                  "type": "Stack",
                  "props": {
                   "gap": "xs"
                  },
                  "children": [
                   {
                    "type": "Heading",
                    "props": {
                     "value": {
                      "t": "project.names.title"
                     },
                     "level": "1"
                    }
                   },
                   {
                    "type": "Text",
                    "props": {
                     "value": {
                      "t": "project.names.renamedFile",
                      "args": {
                       "file": {
                        "get": "local.file"
                       }
                      }
                     },
                     "role": "caption",
                     "tone": "muted"
                    }
                   },
                   {
                    "type": "StatusRow",
                    "props": {
                     "message": {
                      "t": "project.names.renamed",
                      "args": {
                       "file": {
                        "get": "local.file"
                       }
                      }
                     },
                     "tone": "success",
                     "icon": "check"
                    }
                   }
                  ]
                 }
                }
               },
               {
                "type": "Text",
                "props": {
                 "value": {
                  "get": "vm.mocks.sampleNote"
                 },
                 "personal": true
                }
               }
              ]
             }
            ]
           }
          ]
         }
        ]
       },
       {
        "type": "DialogPanel",
        "on": {
         "openChange": {
          "set": "local.step",
          "to": "overview"
         }
        },
        "props": {
         "open": true,
         "size": "m",
         "height": "content",
         "label": {
          "t": "project.names.renameFile"
         }
        },
        "slots": {
         "header": [
          {
           "type": "Heading",
           "props": {
            "value": {
             "t": "project.names.renameFile"
            },
            "level": "2"
           }
          }
         ],
         "footer": [
          {
           "type": "Inline",
           "props": {
            "gap": "s",
            "justify": "end"
           },
           "children": [
            {
             "type": "Button",
             "on": {
              "press": {
               "set": "local.step",
               "to": "overview"
              }
             },
             "props": {
              "label": {
               "t": "project.cancel"
              },
              "variant": "secondary"
             }
            },
            {
             "type": "Button",
             "on": {
              "press": {
               "set": "local.step",
               "to": "renamed"
              }
             },
             "props": {
              "label": {
               "t": "project.names.renameAction"
              },
              "variant": "primary"
             }
            }
           ]
          }
         ]
        },
        "children": [
         {
          "type": "Stack",
          "props": {
           "gap": "m"
          },
          "children": [
           {
            "type": "Inline",
            "props": {
             "gap": "xs",
             "align": "end"
            },
            "children": [
             {
              "type": "TextField",
              "props": {
               "label": {
                "t": "project.names.fileField"
               },
               "value": {
                "bind": "local.file"
               },
               "autoFocus": true
              }
             },
             {
              "type": "Text",
              "props": {
               "value": {
                "t": "project.names.ext"
               },
               "tone": "muted"
              }
             }
            ]
           },
           {
            "type": "StatusRow",
            "props": {
             "message": {
              "t": "project.names.links"
             },
             "tone": "info",
             "icon": "link"
            }
           }
          ]
         }
        ],
        "when": {
         "expr": {
          "==": [
           {
            "get": "local.step"
           },
           "renameFile"
          ]
         }
        }
       },
       {
        "type": "DialogPanel",
        "on": {
         "openChange": {
          "set": "local.step",
          "to": "overview"
         }
        },
        "props": {
         "open": true,
         "size": "m",
         "height": "content",
         "label": {
          "t": "project.names.renameFile"
         }
        },
        "slots": {
         "header": [
          {
           "type": "Heading",
           "props": {
            "value": {
             "t": "project.names.renameFile"
            },
            "level": "2"
           }
          }
         ],
         "footer": [
          {
           "type": "Inline",
           "props": {
            "gap": "s",
            "justify": "end"
           },
           "children": [
            {
             "type": "Button",
             "on": {
              "press": {
               "set": "local.step",
               "to": "overview"
              }
             },
             "props": {
              "label": {
               "t": "project.cancel"
              },
              "variant": "secondary"
             }
            },
            {
             "type": "Button",
             "on": {
              "press": {
               "set": "local.step",
               "to": "overview"
              }
             },
             "props": {
              "label": {
               "t": "project.names.renameAction"
              },
              "variant": "primary"
             }
            }
           ]
          }
         ]
        },
        "children": [
         {
          "type": "Stack",
          "props": {
           "gap": "m"
          },
          "children": [
           {
            "type": "TextField",
            "props": {
             "label": {
              "t": "project.names.fileField"
             },
             "value": {
              "get": "vm.mocks.aboutFile"
             },
             "autoFocus": true
            }
           },
           {
            "type": "StatusRow",
            "props": {
             "message": {
              "t": "project.names.publishedWarning"
             },
             "tone": "warning",
             "icon": "globe"
            }
           }
          ]
         }
        ],
        "when": {
         "expr": {
          "==": [
           {
            "get": "local.step"
           },
           "published"
          ]
         }
        }
       }
      ]
     }
    ]
   }
  ]
 }
}
